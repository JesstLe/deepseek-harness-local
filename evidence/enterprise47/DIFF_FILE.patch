+const test=require('node:test'),assert=require('node:assert/strict'),fs=require('node:fs'),path=require('node:path'),os=require('node:os');
+const {enterpriseConnection,allowedEnterpriseNavigation,DEFAULT_ENTERPRISE_ORIGIN:enterprise,CENTRAL_IDENTITY_ORIGIN:issuer}=require('../app/enterprise-defaults.cjs');
+const temp=()=>fs.mkdtempSync(path.join(os.tmpdir(),'naumi-enterprise47-'));
+test('official default binds the original home without creating an empty workspace or changing private bytes',()=>{const home=temp();try{fs.writeFileSync(path.join(home,'retained.txt'),'sessions models bots');assert.equal(enterpriseConnection({home,packaged:true,identityOrigin:issuer}).origin,enterprise);assert.equal(fs.readFileSync(path.join(home,'retained.txt'),'utf8'),'sessions models bots');assert.deepEqual(fs.readdirSync(home).sort(),['desktop-enterprise.json','retained.txt']);}finally{fs.rmSync(home,{recursive:true});}});
+test('configured enterprise wins; a different configured issuer is never silently rebound',()=>{const home=temp();try{const first=enterpriseConnection({home,configuredOrigin:'https://custom.example'});const bytes=fs.readFileSync(path.join(home,'desktop-enterprise.json'));assert.deepEqual(enterpriseConnection({home,packaged:true,identityOrigin:issuer}),first);assert.throws(()=>enterpriseConnection({home,configuredOrigin:enterprise}),/SWITCH_REQUIRED/);assert.deepEqual(fs.readFileSync(path.join(home,'desktop-enterprise.json')),bytes);}finally{fs.rmSync(home,{recursive:true});}});
+test('development, custom identity, or missing login never auto-configures a business service',()=>{const home=temp();try{for(const input of [{packaged:false,identityOrigin:issuer},{packaged:true,identityOrigin:'https://other.example'},{packaged:true}])assert.equal(enterpriseConnection({home,...input}),null);assert.deepEqual(fs.readdirSync(home),[]);}finally{fs.rmSync(home,{recursive:true});}});
+test('official central OIDC interaction and enterprise callback are confined to exact permitted origins and paths',()=>{for(const p of ['/api/identity/auth?state=a','/api/identity-interaction/ab-_09','/api/identity-interaction/ab/login','/api/identity/session/end'])assert(allowedEnterpriseNavigation(enterprise,issuer+p),p);assert(allowedEnterpriseNavigation(enterprise,enterprise+'/api/auth/central/callback?state=a&code=b'));for(const u of [issuer+'/dashboard',issuer+'/api/auth/login','https://47.105.59.142.evil.test/api/identity/auth','https://evil.test/',issuer+'/api/identity-interaction/','https://user:pass@47.105.59.142/api/identity/auth','file:///C:/secret','javascript:alert(1)'])assert.equal(allowedEnterpriseNavigation(enterprise,u),false,u);assert.equal(allowedEnterpriseNavigation('https://custom.example',issuer+'/api/identity/auth'),false);assert(allowedEnterpriseNavigation('https://custom.example','https://custom.example/login'));});
+test('linked lifecycle and native login reuse the existing enterprise session bridge',()=>{const main=fs.readFileSync(path.join(__dirname,'../app/main.cjs'),'utf8');assert(main.includes('if(settings.isolated||settings.linkedService||settings.linkedServiceCandidate){'));assert(main.includes('enterpriseConnection({home:settings.home'));assert(main.includes('allowedEnterpriseNavigation(origin,url)'));assert(main.includes('webPreferences:{session:enterprise.session,sandbox:true,contextIsolation:true,nodeIntegration:false}'));});
+test('undeployed digital endpoint is explicit and never retries or enrolls',async()=>{const {pathToFileURL}=require('node:url');const {EmployeeSync}=await import(pathToFileURL(path.resolve('plugins/naumi-enterprise/employee-sync.js')));const home=temp();let sync,calls=0;try{sync=new EmployeeSync({file:path.join(home,'sync.sqlite'),origin:enterprise,store:{},directory:{},sessionRequest:async()=>{calls++;return new Response('<html>404</html>',{status:404});}});await assert.rejects(sync.catalog(''),e=>e.message==='EMP_SERVICE_NOT_DEPLOYED'&&e.status===503);assert.equal(calls,1);assert.equal(sync.registration(),null);assert.equal(sync.status().enabled,false);}finally{await sync?.close();fs.rmSync(home,{recursive:true});}});
+test('a live old worker defers first enterprise binding rather than changing its signed origin',()=>{const home=temp();try{fs.writeFileSync(path.join(home,'desktop-backend.json'),JSON.stringify({pid:process.pid}));assert.equal(enterpriseConnection({home,packaged:true,identityOrigin:issuer}),null);assert(!fs.existsSync(path.join(home,'desktop-enterprise.json')));}finally{fs.rmSync(home,{recursive:true});}});
+test('existing device registration or pending private upload requires explicit migration',()=>{const {DatabaseSync}=require('node:sqlite');for(const registered of [true,false]){const home=temp();try{fs.mkdirSync(path.join(home,'naumi'));const db=new DatabaseSync(path.join(home,'naumi/employee-sync.sqlite'));db.exec('CREATE TABLE config(key TEXT PRIMARY KEY,value TEXT);CREATE TABLE outbox(status TEXT)');if(registered)db.prepare('INSERT INTO config VALUES(?,?)').run('registration',JSON.stringify({tenantId:'prior'}));else db.exec("INSERT INTO outbox VALUES('pending')");db.close();assert.throws(()=>enterpriseConnection({home,packaged:true,identityOrigin:issuer}),/EXISTING_DEVICE_REQUIRES_MIGRATION/);assert(!fs.existsSync(path.join(home,'desktop-enterprise.json')));}finally{fs.rmSync(home,{recursive:true});}}});
+test('native bridge translates an undeployed HTML digital route without treating it as expired login',async()=>{const {EnterpriseSession}=require('../app/enterprise.cjs');let calls=0;const session=new EnterpriseSession({origin:enterprise,session:{fetch:async()=>{calls++;return new Response('<html>missing</html>',{status:404});}}});assert.deepEqual(await session.perform({origin:enterprise,endpoint:'/api/digital-employees'}),{status:503,body:JSON.stringify({code:'EMP_SERVICE_NOT_DEPLOYED'})});assert.equal(calls,1);await assert.rejects(session.perform({origin:enterprise,endpoint:'/api/workspace'}),/RESPONSE_INVALID/);});
+test('central login page keeps an exact interaction return target instead of allowing arbitrary dashboard browsing',()=>{for(const p of ['/','/dashboard'])assert(allowedEnterpriseNavigation(enterprise,issuer+p+'?auth=sign-in&redirect=%2Fapi%2Fidentity-interaction%2Fabc_09'));for(const query of ['auth=sign-in&redirect=https%3A%2F%2Fevil.test','auth=sign-in&redirect=%2Fdashboard','auth=sign-in&redirect=%2Fapi%2Fidentity-interaction%2Fx&redirect=%2Felse','auth=sign-in&redirect=%2Fapi%2Fidentity-interaction%2Fx&other=1'])assert.equal(allowedEnterpriseNavigation(enterprise,issuer+'/dashboard?'+query),false);});
