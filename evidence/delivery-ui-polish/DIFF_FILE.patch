+/* Delivery presentation only. All data, connection and review actions remain native. */
+.naumi-page[data-naumi-page="naumi-delivery"]{background:#f7f8fb;color:#282b37;padding:36px clamp(24px,3vw,48px);font-family:Inter,"Segoe UI","Microsoft YaHei",sans-serif}
