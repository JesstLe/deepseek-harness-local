 - IPC：新增 `naumiDesktop.installUpdate()`；状态新增 `lastChecked`，只在确认无更新时展示「已是最新版本」。
 - 开发壳未启用更新器时显示「安装版支持更新」，不伪报最新。
 - 实现与证据边界见 [本次记录](../changes/2026-11-17-desktop-update-entry.md)。
+
+## 可见安装与重开确认（2026-11-18，待新版打包生效）
+
+- 交接改用可见原生安装；安装器兼容旧客户端的 `--updated /S`，复用原注册作用域/路径与stock提权，直接显示更新进度，不重复选择安装位置。
+- 删除旧版本没有可用百分比，使用native marquee，不编造进度或倒计时。进程检查显式隐藏PowerShell窗口，NSIS辅助命令使用nsExec；不引入cmd弹窗。
+- allusers elevated-inner补同一维护门禁，finish自包含解出helper，修正stock跳过outer准备时收尾辅助文件可能缺失的问题。
+- 完成后自动打开准确exe；只读原 `desktop-runtime.json`，核验新版本、安装位置、本次更新后的就绪时间和实际进程身份。ShellExecute返回成功不直接记为应用已就绪。
+- 未就绪时保留可关闭/重新打开的结果页，点击重试只重开，不重复安装、不强杀。常规首次安装和卸载保持原有页面。
+- 代码/原生隔离界面验收与实际用户更新必须分开报告；公开0.4.0固定包不覆盖。详见[切片记录](../changes/2026-11-18-update-friendly.md)。
diff --git a/desktop/app/installer-relaunch.cjs b/desktop/app/installer-relaunch.cjs
new file mode 100644
index 0000000..54ad6ae
--- /dev/null
+++ b/desktop/app/installer-relaunch.cjs
@@ -0,0 +1,28 @@
+'use strict';
+// Read-only completion proof. Installed files or ShellExecute success alone do
+// not prove the new desktop finished booting. Never launch/kill a process here.
+const fs=require('node:fs'),path=require('node:path');
+const state=require('./installer-state.cjs');
+function begin(file,root,version,{now=Date.now(),userData=path.join(process.env.APPDATA||'', 'Naumi')}={}){
+ if(!path.isAbsolute(root)||!path.isAbsolute(userData)||!/^\d+\.\d+\.\d+(?:-[\w.-]+)?$/.test(version))throw Error('UPDATE_PROOF_INVALID');
+ const proof={version:1,root:state.canonical(root),targetVersion:version,startedAt:now,userData:path.resolve(userData)};
+ fs.writeFileSync(file,JSON.stringify(proof));return proof;
+}
+function check(file,{inspect=state.inventory,now=Date.now()}={}){
+ const proof=state.plain(file);
+ if(!proof||proof.version!==1||!path.isAbsolute(proof.root)||!path.isAbsolute(proof.userData)||!Number.isFinite(proof.startedAt)||proof.startedAt>now)throw Error('UPDATE_PROOF_INVALID');
+ const r=state.plain(path.join(proof.userData,'desktop-runtime.json'));
+ if(!r||r.version!==1||r.clientVersion!==proof.targetVersion||!Number.isInteger(r.pid)||r.pid<=0||typeof r.executable!=='string'||!Number.isFinite(Date.parse(r.readyAt))||Date.parse(r.readyAt)<proof.startedAt)return false;
+ const expected=state.canonical(path.join(proof.root,'Naumi.exe'));
+ if(state.canonical(r.executable)!==expected)return false;
+ const p=inspect().find(p=>p.pid===r.pid);
+ return !!(p?.exe&&state.canonical(p.exe)===expected&&Number.isFinite(Date.parse(p.created))&&Date.parse(p.created)>=proof.startedAt&&Date.parse(p.created)<=Date.parse(r.readyAt));
+}
+module.exports={begin,check};
+if(require.main===module){
+ try{const[mode,file,root,version]=process.argv.slice(2);
+  if(mode==='begin'){begin(file,root,version);console.log('UPDATE_LAUNCH_PROOF_STARTED');}
+  else if(mode==='check'){const ready=check(file);console.log(ready?'UPDATE_NEW_DESKTOP_READY':'UPDATE_DESKTOP_NOT_READY');process.exitCode=ready?0:10;}
+  else throw Error('UPDATE_PROOF_INVALID');
+ }catch{console.error('UPDATE_LAUNCH_PROOF_UNKNOWN');process.exitCode=20;}
+}

diff --git a/desktop/installer/update-ui.nsh b/desktop/installer/update-ui.nsh
new file mode 100644
index 0000000..f50eba0
--- /dev/null
+++ b/desktop/installer/update-ui.nsh
@@ -0,0 +1,65 @@
+; Only presentation + observed post-install startup. The stock engine still
+; owns elevation, old-version removal, extraction, registration and shortcuts.
+Var NaumiUpdateHeading
+Var NaumiUpdateStatus
+Var NaumiUpdateRetry
+Var NaumiUpdateAttempts
+Var NaumiUpdateLaunchPending
+
+Function NaumiUpdateDone
+  !insertmacro NaumiShell
+  !insertmacro NaumiLabel 248 112 524 44 "正在打开 Naumi" 22 600
+  StrCpy $NaumiUpdateHeading $0
+  !insertmacro NaumiLabel 248 196 524 48 "${VERSION} 已安装" 10 400
+  StrCpy $NaumiUpdateStatus $0
+  !insertmacro NaumiButton 248 388 88 44 "关闭" action-close NaumiNext
+  !insertmacro NaumiButton 612 388 160 44 "重新打开" action-reopen NaumiUpdateLaunch
+  StrCpy $NaumiUpdateRetry $NaumiAction
+  EnableWindow $NaumiUpdateRetry 0
+  StrCpy $NaumiUpdateLaunchPending "0"
+  StrCpy $NaumiUpdateAttempts -1
+  ; One stable timer: do not replace a timer from inside its callback.
+  ${NSD_CreateTimer} NaumiUpdatePoll 2000
+  nsDialogs::Show
+  ${NSD_KillTimer} NaumiUpdatePoll
+FunctionEnd
+
+Function NaumiUpdateLaunch
+  ${If} $NaumiUpdateLaunchPending == "1"
+    Return
+  ${EndIf}
+  StrCpy $NaumiUpdateLaunchPending "1"
+  StrCpy $NaumiUpdateAttempts 0
+  EnableWindow $NaumiUpdateRetry 0
+  ${NSD_SetText} $NaumiUpdateHeading "正在打开 Naumi"
+  ${NSD_SetText} $NaumiUpdateStatus "${VERSION} 已安装"
+  Call StartApp
+FunctionEnd
+
+Function NaumiUpdatePoll
+  ${If} $NaumiUpdateAttempts == -1
+    Call NaumiUpdateLaunch
+    Return
+  ${EndIf}
+  ${If} $NaumiUpdateLaunchPending != "1"
+    Return
+  ${EndIf}
+  ; Exact target/version + fresh ready receipt + live process identity required.
+  ; Unknown, old or missing receipts keep this page open instead of fake success.
+  nsExec::ExecToStack /TIMEOUT=5000 '"$PLUGINSDIR\naumi-maintenance-node.exe" "$PLUGINSDIR\installer-relaunch.cjs" "check" "$PLUGINSDIR\update-launch.json"'
+  Pop $R9
+  Pop $R8
+  ${If} $R9 == 0
+    ${NSD_KillTimer} NaumiUpdatePoll
+    StrCpy $NaumiUpdateLaunchPending "0"
+    Call NaumiNext
+    Return
+  ${EndIf}
+  IntOp $NaumiUpdateAttempts $NaumiUpdateAttempts + 1
+  ${If} $NaumiUpdateAttempts >= 20
+    StrCpy $NaumiUpdateLaunchPending "0"
+    ${NSD_SetText} $NaumiUpdateHeading "更新已安装"
+    ${NSD_SetText} $NaumiUpdateStatus "Naumi 尚未就绪，可以重新打开"
+    EnableWindow $NaumiUpdateRetry 1
+  ${EndIf}
+FunctionEnd

