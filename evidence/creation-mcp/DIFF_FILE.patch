+    if (name === "naumi_tools") return toolResult("实时工具目录", false, {tools:await tools(conn)});
+    if (name === "naumi_quote") { const quote = await postJson(conn, `${API}/quote`, args); return toolResult(JSON.stringify(quote), false, quote); }
