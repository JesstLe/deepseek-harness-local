index 0000000..2d9e2d3
--- /dev/null
+++ b/plugins/naumi-enterprise/browser-bridge.mjs
@@ -0,0 +1,62 @@
+/** Executed inside ego-lite's embedded Node runtime; no external browser or CDP port. */
+export async function operate(input,cache=new Map()){
+  try{
+    let entry=cache.get(input.name);
+    if(!entry){entry={task:await globalThis.taskSpace(input.name),sizes:new Map()};cache.set(input.name,entry);}
+    const task=entry.task;
+    const page=task.page(input.label??'p1');
+    if(input.action==='finish'){await task.finish({keep:[]});cache.delete(input.name);return {ok:true,data:{closed:true}};}
+    const sizeKey=`${input.width}x${input.height}`;
+    const resize=async()=>{await page.cdp('Emulation.setDeviceMetricsOverride',{width:input.width,height:input.height,screenWidth:input.width,screenHeight:input.height,deviceScaleFactor:1,mobile:false});entry.sizes.set(page.label,sizeKey);};
+    if(input.width&&input.height&&entry.sizes.get(page.label)!==sizeKey)await resize();
+    switch(input.action){
+      case 'navigate': await page.goto(input.url,{timeout:25000});break;
+      case 'reload': await page.reload({timeout:25000});break;
+      case 'back': case 'forward': {
+        const h=await page.cdp('Page.getNavigationHistory');const entry=h.entries[h.currentIndex+(input.action==='back'?-1:1)];
+        if(entry)await page.cdp('Page.navigateToHistoryEntry',{entryId:entry.id});break;
+      }
+      case 'resize': break;
+      case 'click': if(input.selector)await page.click(input.selector);else await page.mouse.click(input.x,input.y,{label:'Naumi browser user click'});break;
+      case 'fill': await page.fill(input.selector,input.text);break;
+      case 'press': await page.keyboard.press(input.key);break;
+      case 'text': await page.keyboard.insertText(input.text??'');break;
+      case 'wheel': await page.cdp('Input.dispatchMouseEvent',{type:'mouseWheel',x:Math.max(0,input.x??20),y:Math.max(0,input.y??20),deltaX:Math.max(-3000,Math.min(3000,input.deltaX??0)),deltaY:Math.max(-3000,Math.min(3000,input.deltaY??0))});break;
+      case 'dialog': if(input.text==='accept')await page.acceptDialog();else await page.dismissDialog();break;
+    }
+    let info=await page.info();
+    if(input.width&&input.height&&(info.w!==input.width||info.h!==input.height)){await resize();info=await page.info();}
+    const history=await page.cdp('Page.getNavigationHistory').catch(()=>({entries:[],currentIndex:0}));
+    const data={spaceId:task.spaceId,label:page.label,url:info.url,title:info.title,width:info.w,height:info.h,canGoBack:history.currentIndex>0,canGoForward:history.currentIndex<history.entries.length-1};
+    if(input.action==='snapshot')data.snapshot=await page.snapshot();
+    if(input.action==='tabs')data.tabs=(await task.tabs()).map(t=>({label:t.label??null,title:t.title,url:t.url,active:t.active,openedBy:t.openedBy}));
+    if(input.frame){const scale=Math.min(1,1440/info.w,1000/info.h);const frame=await page.cdp('Page.captureScreenshot',{format:'jpeg',quality:68,fromSurface:true,captureBeyondViewport:false,clip:{x:info.sx??0,y:info.sy??0,width:info.w,height:info.h,scale}});data.image=frame.data;}
+    return {ok:true,data};
+  }catch(error){return {ok:false,error:typeof error?.code==='string'?error.code:'EGO_OPERATION_FAILED'};}
+}
+
+export async function run(input){console.log('NAUMI_BROWSER_RESULT='+JSON.stringify(await operate(input)));}
+
+/** Persistent embedded SDK/CDP connection. Private loopback transport, never exposed to web content. */
+export async function serve({readyPath,token,ownerPid}){
+  const {createServer}=await import('node:http'),{writeFile}=await import('node:fs/promises'),{timingSafeEqual}=await import('node:crypto');
+  const cache=new Map(),queues=new Map();let closeWorker,closing=false;
+  const closed=new Promise(resolve=>{closeWorker=resolve;});
+  const server=createServer(async(req,res)=>{
+    const auth=Buffer.from(req.headers.authorization??''),expected=Buffer.from('Bearer '+token);
+    if(req.headers.origin||auth.length!==expected.length||!timingSafeEqual(auth,expected)){res.writeHead(403).end();return;}
+    if(req.method!=='POST'){res.writeHead(405).end();return;}
+    if(req.url==='/shutdown'){res.writeHead(200).end('{}');closing=true;setTimeout(async()=>{await Promise.allSettled(queues.values());server.closeAllConnections();server.close(closeWorker);},25);return;}
+    if(closing){res.writeHead(503).end();return;}
+    if(req.url!=='/op'){res.writeHead(404).end();return;}
+    let input;try{let body='',size=0;for await(const chunk of req){size+=chunk.length;if(size>65536){res.writeHead(413).end();return;}body+=chunk;}input=JSON.parse(body);}catch{res.writeHead(400).end();return;}
+    if(!/^Naumi-[a-f0-9]{20}$/.test(input.name??'')){res.writeHead(400).end();return;}
+    const prior=queues.get(input.name)??Promise.resolve(),job=prior.catch(()=>{}).then(()=>operate(input,cache));queues.set(input.name,job);
+    try{const result=await job;if(!res.destroyed){res.writeHead(200,{'Content-Type':'application/json','Cache-Control':'no-store'});res.end(JSON.stringify(result));}}
+    finally{if(queues.get(input.name)===job)queues.delete(input.name);}
+  });
+  await new Promise((resolve,reject)=>{server.once('error',reject);server.listen(0,'127.0.0.1',resolve);});
+  await writeFile(readyPath,JSON.stringify({port:server.address().port}));
+  const lease=setInterval(()=>{try{process.kill(ownerPid,0);}catch(error){if(error.code==='ESRCH'){closing=true;server.closeAllConnections();server.close(closeWorker);}}},2000);
+  try{await closed;}finally{clearInterval(lease);}
+}
diff --git a/plugins/naumi-enterprise/browser-runtime.js b/plugins/naumi-enterprise/browser-runtime.js
new file mode 100644
index 0000000..96a8f71
--- /dev/null
+++ b/plugins/naumi-enterprise/browser-runtime.js
@@ -0,0 +1,96 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import {fileURLToPath,pathToFileURL} from 'node:url';
+import {createHash,randomBytes,randomUUID} from 'node:crypto';
+import {spawn} from 'node:child_process';
+
+export const BROWSER_LOCK=JSON.parse(fs.readFileSync(new URL('./third-party/ego-lite/runtime-lock.json',import.meta.url),'utf8'));
+const digest=x=>createHash('sha256').update(x).digest('hex');
+const verified=new Map();
+export function resolveBrowserRuntime({root,platform=process.platform,arch=process.arch}={}) {
+  if(platform!=='win32'||arch!=='x64')throw Error('EGO_PLATFORM_NOT_PACKAGED');
+  if(!root){
+    let cursor=fileURLToPath(new URL('.',import.meta.url));
+    while(!fs.existsSync(path.join(cursor,'runtime/ego-lite/win32-x64/Application/ego.exe'))){const up=path.dirname(cursor);if(up===cursor)throw Error('EGO_RUNTIME_NOT_INSTALLED');cursor=up;}
+    root=cursor;
+  }
+  const app=path.resolve(root,'runtime/ego-lite/win32-x64/Application');
+  for(const [relative,expected]of Object.entries(BROWSER_LOCK.binaries)){
+    const file=path.join(app,relative);if(!fs.existsSync(file))throw Error('EGO_RUNTIME_INCOMPLETE');
+    const stat=fs.statSync(file),stamp=`${stat.size}:${stat.mtimeMs}`;
+    if(verified.get(file)!==stamp){if(digest(fs.readFileSync(file))!==expected)throw Error('EGO_RUNTIME_CHECKSUM_MISMATCH');verified.set(file,stamp);}
+  }
+  return {root,app,command:path.join(app,BROWSER_LOCK.browserVersion,'ego-browser.exe'),version:BROWSER_LOCK.browserVersion};
+}
+
+export const BROWSER_ACTIONS=['state','navigate','back','forward','reload','resize','click','fill','press','text','wheel','snapshot','tabs','select','dialog','finish'];
+export function browserURL(value){
+  if(typeof value!=='string'||value.length>8192)throw Error('INVALID_BROWSER_URL');
+  const input=value.trim();if(input==='about:blank')return input;
+  const url=new URL(/^[a-z][a-z\d+.-]*:/i.test(input)&&!/^localhost:\d/i.test(input)?input:(/^(?:localhost|127\.0\.0\.1|\[::1\])(?::|\/|$)/i.test(input)?'http://':'https://')+input);
+  if(!['http:','https:'].includes(url.protocol)||url.username||url.password)throw Error('INVALID_BROWSER_URL');
+  return url.href;
+}
+export function validateBrowserInput(input){
+  if(!input||typeof input!=='object'||!BROWSER_ACTIONS.includes(input.action))throw Error('INVALID_BROWSER_ACTION');
+  const out={action:input.action};
+  for(const key of ['selector','text','key','label'])if(input[key]!==undefined){if(typeof input[key]!=='string'||input[key].length>(key==='text'?16384:4096))throw Error('INVALID_BROWSER_'+key.toUpperCase());out[key]=input[key];}
+  for(const key of ['x','y','deltaX','deltaY','width','height','modifiers'])if(input[key]!==undefined){if(!Number.isFinite(input[key]))throw Error('INVALID_BROWSER_NUMBER');out[key]=input[key];}
+  if(input.action==='navigate')out.url=browserURL(input.url);
+  if(input.action==='resize'&&(!Number.isInteger(out.width)||out.width<200||out.width>2560||!Number.isInteger(out.height)||out.height<120||out.height>1600))throw Error('INVALID_BROWSER_VIEWPORT');
+  if(input.action==='click'&&!out.selector&&(!(out.x>=0&&out.x<=2560)||!(out.y>=0&&out.y<=1600)))throw Error('INVALID_BROWSER_POINT');
+  if(input.action==='fill'&&(!out.selector||out.text===undefined))throw Error('INVALID_BROWSER_FILL');
+  if(input.action==='press'&&(!out.key||out.key.length>64))throw Error('INVALID_BROWSER_KEY');
+  if(input.action==='select'&&!/^p\d+$/.test(out.label??''))throw Error('INVALID_BROWSER_PAGE');
+  if(input.action==='dialog'){if(!['accept','dismiss'].includes(input.text))throw Error('INVALID_BROWSER_DIALOG');}
+  out.frame=input.frame===true;return out;
+}
+
+/** Structured operations only; never interpolate page/script text into shell syntax. */
+export class EgoBrowserRuntime {
+  constructor({runtime,spawnProcess=spawn}={}){this.runtime=runtime;this.spawnProcess=spawnProcess;this.queues=new Map();this.pages=new Map();this.viewports=new Map();this.children=new Set();this.closed=false;this.metrics={workerStarts:0,requests:0};}
+  status(){try{const r=this.runtime??resolveBrowserRuntime();return {status:'installed',version:r.version,engine:'ego-lite',presentation:'interactive-stream'};}catch(e){return {status:'not_installed',error:e.message,engine:'ego-lite'};}}
+  async perform(scope,input,{signal}={}){
+    if(this.closed)throw Error('EGO_RUNTIME_DISPOSED');
+    if(typeof scope!=='string'||!scope||scope.length>200)throw Error('INVALID_BROWSER_SCOPE');
+    const args=validateBrowserInput(input),name='Naumi-'+digest(scope).slice(0,20);
+    const before=this.queues.get(scope)??Promise.resolve();
+    const job=before.catch(()=>{}).then(async()=>{if(this.closed)throw Error('EGO_RUNTIME_DISPOSED');signal?.throwIfAborted();if(args.action==='resize')this.viewports.set(scope,{width:args.width,height:args.height});const data=await this.run({name,label:this.pages.get(scope)??'p1',...this.viewports.get(scope),...args},signal);if(data.label)this.pages.set(scope,data.label);if(data.closed){this.pages.delete(scope);this.viewports.delete(scope);}return data;});
+    this.queues.set(scope,job);try{return await job;}finally{if(this.queues.get(scope)===job)this.queues.delete(scope);}
+  }
+  async ensureWorker(){
+    if(this.workerPromise)return this.workerPromise;
+    const promise=(async()=>{
+      const r=this.runtime??resolveBrowserRuntime(),token=randomBytes(32).toString('hex');
+      const readyPath=path.join(r.root,'.dsh/ego-lite-backup','worker-'+randomUUID()+'.json');fs.mkdirSync(path.dirname(readyPath),{recursive:true});
+      const module=pathToFileURL(fileURLToPath(new URL('./browser-bridge.mjs',import.meta.url))).href;
+      const code='await (await import('+JSON.stringify(module)+')).serve('+JSON.stringify({readyPath,token,ownerPid:process.pid})+')';
+      const child=this.spawnProcess(r.command,['nodejs','-e',code],{cwd:r.app,windowsHide:true,shell:false,stdio:['ignore','pipe','pipe']});
+      this.children.add(child);this.metrics.workerStarts++;let exited=false;
+      const clear=()=>{exited=true;this.children.delete(child);if(this.worker?.child===child){this.worker=null;this.workerPromise=null;}};
+      child.on('error',clear);child.on('close',clear);child.stdout.resume();child.stderr.resume();
+      try{
+        const deadline=Date.now()+15000;
+        while(!fs.existsSync(readyPath)){
+          if(exited)throw Error('EGO_WORKER_START_FAILED');if(this.closed)throw Error('EGO_RUNTIME_DISPOSED');if(Date.now()>deadline)throw Error('EGO_WORKER_START_TIMEOUT');
+          await new Promise(resolve=>setTimeout(resolve,30));
+        }
+        const {port}=JSON.parse(fs.readFileSync(readyPath,'utf8'));if(!Number.isInteger(port)||port<1||port>65535)throw Error('EGO_WORKER_INVALID_PORT');
+        this.worker={url:'http://127.0.0.1:'+port,token,child};return this.worker;
+      }catch(e){child.kill();throw e;}finally{if(fs.existsSync(readyPath))fs.unlinkSync(readyPath);}
+    })();
+    this.workerPromise=promise;try{return await promise;}catch(e){if(this.workerPromise===promise)this.workerPromise=null;throw e;}
+  }
+  async run(input,signal){
+    const worker=await this.ensureWorker();signal?.throwIfAborted();this.metrics.requests++;
+    let response;
+    try{response=await fetch(worker.url+'/op',{method:'POST',headers:{Authorization:'Bearer '+worker.token,'Content-Type':'application/json'},body:JSON.stringify(input),signal:AbortSignal.any([...(signal?[signal]:[]),AbortSignal.timeout(45000)])});}
+    catch(e){if(signal?.aborted)throw signal.reason;if(e.name==='TimeoutError')throw Error('EGO_OPERATION_TIMEOUT_NO_REPLAY');throw Error('EGO_WORKER_CONNECTION_LOST_NO_REPLAY');}
+    const result=await response.json();if(!response.ok||!result.ok)throw Error(result.error??'EGO_OPERATION_FAILED');return result.data;
+  }
+  async dispose(){
+    this.closed=true;await Promise.allSettled(this.queues.values());
+    if(this.worker)await fetch(this.worker.url+'/shutdown',{method:'POST',headers:{Authorization:'Bearer '+this.worker.token},signal:AbortSignal.timeout(1000)}).catch(()=>{});
+    for(const child of this.children)child.kill();this.worker=null;this.workerPromise=null;
+  }
+}
diff --git a/plugins/naumi-enterprise/browser-skills/naumi-browser/SKILL.md b/plugins/naumi-enterprise/browser-skills/naumi-browser/SKILL.md
new file mode 100644
index 0000000..392077c
--- /dev/null
+++ b/plugins/naumi-enterprise/browser-skills/naumi-browser/SKILL.md
@@ -0,0 +1,20 @@
+---
+name: naumi-browser
+description: Naumi内置ego-lite浏览器。用户要求打开网页、查询站点、表单操作或浏览器测试时使用，工具与当前会话右侧栏共享同一真实页面。
+---
+
+# Naumi 浏览器
+
+使用内置naumi_browser工具，action=state检查状态，action=snapshot读取当前页面结构，然后用selector执行click/fill/press。navigate接受http(s)网址。每次写操作后用snapshot确认实际结果；超时或结果不明时不要原样重放提交。
+
+同一Naumi会话共享一个ego TaskSpace，右侧栏是该页面的实时交互视图。不要另建浏览器进程、切换到其他用户Space或读取无关个人资料。浏览器已有网站登录态不等于企业业务权限。登录、验证码、支付及其他需人工确认的步骤交给用户在右侧栏或原生ego窗口完成。
+
+打开网站的示例参数：
+
+```json
+{"action":"navigate","url":"https://example.com"}
+```
+
+页面变化后重新snapshot再选择当前ref或稳定selector。用tabs查看当前Space页面，用select及label切换。操作仅限用户当前任务，不自动安装扩展、导入其他浏览器数据或改变系统默认浏览器。截图、Cookie和表单内容不写入交付证据，不向无关服务上传。
+
+CLI维护入口为安装根目录下的node scripts/ego-browser.mjs，status不读取页面数据；skill打印与安装版本匹配的上游完整指引。工具不支持任意shell/JS，缺少功能时保留原始错误，不绕开既有审批。
diff --git a/plugins/naumi-enterprise/browser.js b/plugins/naumi-enterprise/browser.js
new file mode 100644
index 0000000..72689f7
--- /dev/null
+++ b/plugins/naumi-enterprise/browser.js
@@ -0,0 +1,38 @@
+import {defineTool} from '@deepseek-ai/dsh-tools';
+import * as filesystemSkills from '@deepseek-ai/dsh-skill-filesystem';
+import {fileURLToPath} from 'node:url';
+import {EgoBrowserRuntime,BROWSER_ACTIONS} from './browser-runtime.js';
+
+export function createBrowserTool(runtime){
+  return defineTool({name:'naumi_browser',description:'Operate the same ego-lite page displayed in this Naumi session’s right sidebar. Read the naumi-browser skill first. Observe with snapshot before semantic click/fill. Never replay an uncertain write. No arbitrary JavaScript or shell execution.',
+    parameters:{action:{type:'string',enum:BROWSER_ACTIONS,required:true},url:{type:'string'},selector:{type:'string'},text:{type:'string'},key:{type:'string'},label:{type:'string'},x:{type:'number'},y:{type:'number'},deltaX:{type:'number'},deltaY:{type:'number'}},
+    output:{schema:{type:'json'},render:(_args,data)=>[{type:'text',text:JSON.stringify(data)}]},
+    async execute(args,exec){const sessionId=exec.agent?.id;if(!sessionId)throw Error('BROWSER_SESSION_REQUIRED');return runtime.perform(sessionId,{...args,frame:false},{signal:exec.signal});}
+  });
+}
+
+export function installEgoBrowser(ctx,{runtime=new EgoBrowserRuntime()}={}){
+  let toolRegistered=false;
+  ctx.effect(()=>()=>runtime.dispose());
+  ctx.inject(['skills'],scope=>{scope.plugin(filesystemSkills,{providerName:'naumi-browser',includeDefaultRoots:false,watch:false,customSkillDirs:[],bundledSkillDir:fileURLToPath(new URL('./browser-skills',import.meta.url))});});
+  ctx.inject(['tools'],scope=>scope.effect(()=>{const dispose=scope.tools.register(createBrowserTool(runtime));toolRegistered=true;return()=>{toolRegistered=false;dispose();};}));
+  ctx.effect(()=>ctx.webServer.register({kind:'exact',path:'/naumi/browser',handler:async(req,res)=>{
+    res.setHeader('Cache-Control','private, no-store');res.setHeader('Content-Type','application/json; charset=utf-8');res.setHeader('X-Content-Type-Options','nosniff');
+    const send=(status,data)=>{if(!res.destroyed){res.writeHead(status);res.end(JSON.stringify(data));}};
+    const admission=ctx.connection.admit(req);
+    if('rejection'in admission){send(admission.rejection,{error:'HARNESS_AUTH_REQUIRED'});return;}
+    if(admission.peer.principal.kind!=='owner'){send(403,{error:'HARNESS_OWNER_REQUIRED'});return;}
+    if(req.method==='GET'){send(200,{...runtime.status(),toolRegistered});return;}
+    if(req.method!=='POST'){res.setHeader('Allow','GET, POST');send(405,{error:'METHOD_NOT_ALLOWED'});return;}
+    if(req.headers['x-naumi-browser']!=='1'){send(403,{error:'BROWSER_SAME_ORIGIN_REQUIRED'});return;}
+    if(req.headers.origin){let origin;try{origin=new URL(req.headers.origin).origin;}catch{}if(origin!==`http://${req.headers.host}`&&origin!==`https://${req.headers.host}`){send(403,{error:'BROWSER_SAME_ORIGIN_REQUIRED'});return;}}
+    const controller=new AbortController(),closed=()=>{if(!res.writableEnded)controller.abort(Error('BROWSER_CLIENT_CLOSED'));};res.on('close',closed);
+    try{
+      let raw='',size=0;for await(const chunk of req){size+=chunk.length;if(size>65536){send(413,{error:'BROWSER_BODY_TOO_LARGE'});return;}raw+=chunk.toString();}
+      let body;try{body=JSON.parse(raw);}catch{send(400,{error:'INVALID_BROWSER_JSON'});return;}
+      if(typeof body.sessionId!=='string'||!body.sessionId||body.sessionId.length>200){send(400,{error:'BROWSER_SESSION_REQUIRED'});return;}
+      const result=await runtime.perform(body.sessionId,body,{signal:controller.signal});send(200,result);
+    }catch(error){const code=String(error.message);send(/^(?:INVALID_|BROWSER_SESSION)/.test(code)?400:503,{error:/^[A-Z][A-Z0-9_]{2,80}$/.test(code)?code:'EGO_OPERATION_FAILED'});}
+    finally{res.off('close',closed);}
+  }}));
+}
diff --git a/plugins/naumi-enterprise/client.js b/plugins/naumi-enterprise/client.js
index 45a4122..07ef126 100644
--- a/plugins/naumi-enterprise/client.js
+++ b/plugins/naumi-enterprise/client.js
@@ -111,6 +111,7 @@ window.__ModuleLoader__.load({id:'@naumi/dsh-enterprise',factory(require){
