+import fs from 'node:fs';
+import assert from 'node:assert/strict';
+import {connect} from './harness-rpc.mjs';
+const logs=['logs/server.out.log','logs/server.err.log'].map(p=>fs.readFileSync(p,'utf8')).join('\n');
+const launch=[...logs.matchAll(/http:\/\/127\.0\.0\.1:3080\/?\?token=[A-Za-z0-9_~.%-]+/g)].at(-1)?.[0];assert(launch);
+const exchange=await fetch(launch,{redirect:'manual'}),cookie=exchange.headers.getSetCookie().map(x=>x.split(';')[0]).join('; '),headers={cookie};
+const readiness=await (await fetch('http://127.0.0.1:3080/naumi/browser',{headers})).json();assert.equal(readiness.status,'installed');assert.equal(readiness.toolRegistered,true);
+const unauthorized=(await fetch('http://127.0.0.1:3080/naumi/browser')).status;assert.equal(unauthorized,401);
+const csrf=(await fetch('http://127.0.0.1:3080/naumi/browser',{method:'POST',headers:{...headers,'X-Naumi-Browser':'1',Origin:'https://evil.test'}})).status;assert.equal(csrf,403);
+const desktop=await (await fetch('http://127.0.0.1:3080/naumi/desktop',{headers})).json();assert.equal(desktop.status,'ready');assert.equal(desktop.toolCount,75);
+const rpc=await connect(),sessions=await rpc('session/list',{_request:{}}),skills=await rpc('skills/list',{request:{sessionId:sessions.items[0].sessionId}});assert(skills.skills.some(s=>s.name==='naumi-browser'));assert(skills.skills.some(s=>s.name==='naumi-desktop'));
+const models=await rpc('session/modelCatalog');assert.equal(models.groups.length,9);
+fs.writeFileSync('evidence/ego-lite/LIVE_CHECK.json',JSON.stringify({readiness,unauthorized,csrf,desktopTools:desktop.toolCount,browserSkillVisible:true,desktopSkillVisible:true,modelGroups:models.groups.length,paidGenerationCalls:0,at:new Date().toISOString()},null,2)+'\n');
+console.log('EGO_LIVE installed=1 tool_registered=1 skill_visible=1 desktop_tools=75 model_groups=9 unauthorized=401 csrf=403');
diff --git a/scripts/verify-ego-browser-performance.mjs b/scripts/verify-ego-browser-performance.mjs
new file mode 100644
index 0000000..6ff3230
--- /dev/null
+++ b/scripts/verify-ego-browser-performance.mjs
@@ -0,0 +1,22 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import {pathToFileURL} from 'node:url';
+import {spawn} from 'node:child_process';
+import assert from 'node:assert/strict';
+import {EgoBrowserRuntime,resolveBrowserRuntime} from '../plugins/naumi-enterprise/browser-runtime.js';
+const oldDir='evidence/ego-lite/performance-original';
+
+const {EgoBrowserRuntime:Original}=await import(pathToFileURL(path.resolve(oldDir,'browser-runtime.js')));
+const runtime=resolveBrowserRuntime(),results={};
+for(const [name,Type]of [['baseline',Original],['modified',EgoBrowserRuntime]]){
+  let starts=0;const engine=new Type({runtime,spawnProcess:(...args)=>{starts++;return spawn(...args);}}),scope='naumi-browser-performance-20261116';
+  try{
+    await engine.perform(scope,{action:'resize',width:800,height:600});await engine.perform(scope,{action:'navigate',url:'about:blank'});
+    const samples=[];let data;
+    for(let i=0;i<8;i++){const start=performance.now();data=await engine.perform(scope,{action:'state',frame:true});samples.push(performance.now()-start);}
+    results[name]={rounds:8,processStarts:starts,medianFrameMs:Math.round([...samples].sort((a,b)=>a-b)[4]),totalFrameMs:Math.round(samples.reduce((a,b)=>a+b,0)),observedWidth:data.width,observedHeight:data.height};
+  }finally{await engine.perform(scope,{action:'finish'});await engine.dispose();}
+}
+assert.equal(results.modified.processStarts,1);assert.equal(results.modified.observedWidth,800);assert.equal(results.modified.observedHeight,600);assert(results.modified.medianFrameMs<results.baseline.medianFrameMs);
+fs.writeFileSync('evidence/ego-lite/PERFORMANCE_CHECK.json',JSON.stringify(results,null,2)+'\n');
+console.log('EGO_PERFORMANCE baseline_processes='+results.baseline.processStarts+' modified_processes='+results.modified.processStarts+' baseline_median_ms='+results.baseline.medianFrameMs+' modified_median_ms='+results.modified.medianFrameMs+' viewport=800x600');
diff --git a/scripts/verify-ego-browser-state.mjs b/scripts/verify-ego-browser-state.mjs
new file mode 100644
