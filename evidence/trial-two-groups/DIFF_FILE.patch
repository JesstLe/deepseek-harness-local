+test('trial exposes exactly two canonical groups and chooses only one GPT endpoint',()=>{const g=source().g,d=source().d;const providers={first:{...g,models:[{id:'gpt-a',name:'other spelling'}]},'ccs-codex-gpt-2f6b6a':{...g,models:[{id:'gpt-a',name:'GPT Original'},{id:'gpt-a',name:'duplicate'},{id:'gpt-b'}]},d};const value=selectTrialModels(providers,{GPT_KEY:'fixture-gpt',DS_KEY:'fixture-ds'});assert.deepEqual(Object.values(value.active).map(p=>p.displayName),['openai','claude']);assert.deepEqual(Object.keys(value.active),['ccs-codex-gpt-2f6b6a','d']);assert.deepEqual(value.active['ccs-codex-gpt-2f6b6a'].models.map(m=>m.id),['gpt-a','gpt-b']);assert.equal(value.active['ccs-codex-gpt-2f6b6a'].models[0].name,'GPT Original');assert.equal(value.original.d.displayName,'CC DeepSeek');});
