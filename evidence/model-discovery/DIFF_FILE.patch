+test('actual owner HTTP discovers with saved credentials without writes and denies guests/foreign origins',async()=>{const upstream=http.createServer((req,res)=>{assert.equal(req.method,'GET');assert.equal(req.url,'/v1/models');assert.equal(req.headers.authorization,'Bearer stored-fixture-key');res.end(JSON.stringify({data:[{id:'http-model'}]}));});await new Promise(r=>upstream.listen(0,'127.0.0.1',r));const base='http://127.0.0.1:'+upstream.address().port;const f=fixture(fetch);f.ctx.settings.describe=()=>[{ns:'llm-pi-ai',revision:7,value:{providers:{saved:{baseURL:base+'/v1',apiKeyEnv:'SAVED'}}}}];const ctx=new Context(),routes=new Map();const provider=await ctx.plugin({apply(scope){for(const[k,v]of Object.entries(f.ctx))scope.provide(k,v);scope.provide('connection',{admit:req=>req.headers.cookie==='owner'?{peer:{principal:{kind:'owner'}}}:req.headers.cookie==='guest'?{peer:{principal:{kind:'guest'}}}:{rejection:401}});scope.provide('webServer',{register:r=>{routes.set(r.path,r.handler);return()=>routes.delete(r.path);}});}});let child;const host=await ctx.plugin({apply(scope){child=installModelConnections(scope);}});await child;const server=http.createServer((req,res)=>void routes.get('/naumi/model-connections')(req,res));await new Promise(r=>server.listen(0,'127.0.0.1',r));const origin='http://127.0.0.1:'+server.address().port;const post=headers=>fetch(origin+'/naumi/model-connections',{method:'POST',headers:{cookie:'owner',origin,'content-type':'application/json','x-naumi-model-connections':'1',...headers},body:JSON.stringify(input({baseURL:base+'/v1',id:'saved',apiKey:undefined}))});try{for(const [h,status]of [[{cookie:''},401],[{cookie:'guest'},403],[{origin:'https://foreign.example'},403],[{'x-naumi-model-connections':''},403]])assert.equal((await post(h)).status,status);const r=await post();assert.equal(r.status,200);assert.deepEqual(await r.json(),{models:[{id:'http-model'}]});assert.equal(r.headers.get('cache-control'),'no-store');}finally{server.closeAllConnections();upstream.closeAllConnections();await Promise.all([new Promise(r=>server.close(r)),new Promise(r=>upstream.close(r))]);await host.dispose();await provider.dispose();}});
