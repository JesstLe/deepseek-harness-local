index 0000000..6572e8c
--- /dev/null
+++ b/plugins/naumi-enterprise/im-adapters/format.js
@@ -0,0 +1,212 @@
+// Outbound text for IM platforms. Bots write Markdown; each platform adapter turns it
+// into what the platform renders (Telegram HTML) or plain text, and cuts it at the
+// platform's per-message limit without breaking inside a code fence when it can help it.
+
+const escapeHtml = text => String(text).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
+
+// Inline Markdown inside one line or block: `code`, **bold**, _italic_, ~~strike~~,
+// [label](url). Code spans are pulled out first so markers inside them stay literal.
+function inlineHtml(line) {
+  const spans = []
+  const kept = line.replace(/`([^`]+)`/g, (_all, code) => {
+    spans.push(`<code>${escapeHtml(code)}</code>`)
+    return `\x00${spans.length - 1}\x00`
+  })
+  const html = escapeHtml(kept)
+    .replace(/\[([^\]]*)\]\(([^)\s]+)\)/g, (_all, label, url) => `<a href="${escapeHtml(url)}">${label}</a>`)
+    .replace(/\*\*([^*]+)\*\*/g, '<b>$1</b>')
+    .replace(/__([^_]+)__/g, '<b>$1</b>')
+    .replace(/\*([^*]+)\*/g, '<i>$1</i>')
+    .replace(/\b_([^_]+)_\b/g, '<i>$1</i>')
+    .replace(/~~([^~]+)~~/g, '<s>$1</s>')
+  return html.replace(/^@(\d+)^@/g, (_all, index) => spans[Number(index)])
+}
+
+function inlinePlain(line) {
+  return line
+    .replace(/`([^`]+)`/g, '$1')
+    .replace(/\[([^\]]*)\]\(([^)\s]+)\)/g, (_all, label, url) => (label === url ? label : `${label} (${url})`))
+    .replace(/\*\*([^*]+)\*\*/g, '$1')
+    .replace(/__([^_]+)__/g, '$1')
+    .replace(/\*([^*]+)\*/g, '$1')
+    .replace(/\b_([^_]+)_\b/g, '$1')
+    .replace(/~~([^~]+)~~/g, '$1')
+}
+
+// One Markdown document as blocks: fenced code stays a block of its own so chunking
+// can keep it whole; the rest splits on blank lines.
+function blocks(markdown) {
+  const out = []
+  const lines = String(markdown).split('\n')
+  let at = 0
+  let buffer = []
+  const flush = () => {
+    if (buffer.length > 0) out.push({ kind: 'text', lines: buffer })
+    buffer = []
+  }
+  while (at < lines.length) {
+    const line = lines[at]
+    const fence = /^```(\S*)\s*$/.exec(line)
+    if (fence !== null) {
+      flush()
+      const close = lines.slice(at + 1).findIndex(item => /^```\s*$/.test(item))
+      const body = close === -1 ? lines.slice(at + 1) : lines.slice(at + 1, at + 1 + close)
+      out.push({ kind: 'code', lang: fence[1] ?? '', lines: body, open: true })
+      at += 1 + (close === -1 ? body.length : close + 1)
+      continue
+    }
+    if (line.trim() === '') flush()
+    else buffer.push(line)
+    at += 1
+  }
+  flush()
+  return out
+}
+
+const renderHtml = block => (block.kind === 'code'
+  ? `<pre><code${block.lang ? ` class="language-${escapeHtml(block.lang)}"` : ''}>${escapeHtml(block.lines.join('\n'))}</code></pre>`
+  : block.lines.map(inlineHtml).join('\n'))
+
+const renderPlain = block => (block.kind === 'code' ? block.lines.join('\n') : block.lines.map(inlinePlain).join('\n'))
+
+export function toTelegramHtml(markdown) {
+  return blocks(markdown).map(renderHtml).join('\n')
+}
+
+export function toPlain(markdown) {
+  return blocks(markdown).map(renderPlain).join('\n')
+}
+
+const points = text => Array.from(text).length
+
+// Split a block that alone exceeds the limit: text at line boundaries (a line that
+// is still too long is cut where it lands — Telegram answers it as plain text), a
+// code fence into several fenced blocks.
+function forceCut(block, limit) {
+  if (block.kind !== 'code') {
+    const chunks = []
+    let html = ''
+    let text = ''
+    const flush = () => {
+      if (html === '') return
+      chunks.push({ html, text })
+      html = ''
+      text = ''
+    }
+    for (const line of block.lines) {
+      const lineHtml = inlineHtml(line)
+      const candidate = html === '' ? lineHtml : `${html}\n${lineHtml}`
+      if (points(candidate) <= limit) {
+        html = candidate
+        text = text === '' ? inlinePlain(line) : `${text}\n${inlinePlain(line)}`
+        continue
+      }
+      flush()
+      // A single line over the limit is cut on its rendered text.
+      let rest = lineHtml
+      let restPlain = inlinePlain(line)
+      while (points(rest) > limit) {
+        const part = Array.from(rest).slice(0, limit).join('')
+        const plainPart = Array.from(restPlain).slice(0, limit).join('')
+        chunks.push({ html: part, text: plainPart })
+        rest = Array.from(rest).slice(limit).join('')
+        restPlain = Array.from(restPlain).slice(limit).join('')
+      }
+      html = rest
+      text = restPlain
+    }
+    flush()
+    return chunks
+  }
+  const chunks = []
+  const open = `<pre><code${block.lang ? ` class="language-${escapeHtml(block.lang)}"` : ''}>`
+  const close = '</code></pre>'
+  let body = block.lines.join('\n')
+  const room = limit - points(open) - points(close)
+  while (body !== '') {
+    let at = Math.min(points(body), Math.max(1, room))
+    const chars = Array.from(body)
+    const newline = body.lastIndexOf('\n', at)
+    if (newline > room / 2) at = newline
+    const part = chars.slice(0, at).join('')
+    chunks.push({ html: `${open}${escapeHtml(part)}${close}`, text: part })
+    body = chars.slice(at).join('').replace(/^\n/, '')
+  }
+  return chunks
+}
+
+// Blank lines at the very start and end of a message: clients show them as an empty
+// first line above the text or as extra space under it, and nothing in the Markdown
+// needs them. Only whitespace-only edge lines go; blank lines inside the text and the
+// indentation of a content line stay exactly as written. Scan lines linearly so a long
+// run of blank lines before content never backtracks.
+const BLANK_EDGE_LINE = /^[ \t\u3000\r]*$/
+function withoutBlankEdges(text) {
+  const lines = text.split('\n')
+  let start = 0
+  let end = lines.length
+  while (start < end && BLANK_EDGE_LINE.test(lines[start])) start += 1
+  while (end > start && BLANK_EDGE_LINE.test(lines[end - 1])) end -= 1
+  if (start === end) return ''
+  if (start === 0 && end === lines.length) return text
+  const body = lines.slice(start, end).join('\n')
+  return end < lines.length && body.endsWith('\r') ? body.slice(0, -1) : body
+}
+
+// Chunks of one Markdown message, each under `limit` rendered characters. Block
+// boundaries are kept where possible; a fence is only split when it alone is too big.
+// Plain markdown chunks at a byte-pair limit: paragraphs and lines first, a
+// hard cut at the limit for one over-long run. For platforms that take
+// markdown as-is (Discord, QQ, WeCom, DingTalk, Slack has its own converter).
+export function chunkMarkdown(markdown, limit) {
+  const chunks = []
+  // Trim before cutting, so the first chunk cannot open and the last cannot close on
+  // a blank line. A message that is only whitespace has nothing to send: it returns
+  // no chunk, the same as an empty string.
+  let rest = withoutBlankEdges(String(markdown ?? ''))
+  if (rest.trim() === '') return chunks
+  while (rest !== '') {
+    if (points(rest) <= limit) { chunks.push(rest); break }
+    let at = limit
+    const newline = rest.lastIndexOf('\n', at)
+    if (newline > limit / 2) at = newline
+    else {
+      const space = rest.lastIndexOf(' ', at)
+      if (space > limit / 2) at = space
+    }
+    chunks.push(rest.slice(0, at))
+    rest = rest.slice(at).replace(/^\s+/, '')
+  }
+  return chunks
+}
+
+export function chunkTelegram(markdown, limit = 4096) {
+  const chunks = []
+  let html = ''
+  let text = ''
+  const flush = () => {
+    if (html === '' && text === '') return
+    chunks.push({ html, text })
+    html = ''
+    text = ''
+  }
+  for (const block of blocks(markdown)) {
+    const blockHtml = renderHtml(block)
+    const blockText = renderPlain(block)
+    const candidate = html === '' ? blockHtml : `${html}\n${blockHtml}`
+    if (points(candidate) <= limit) {
+      html = candidate
+      text = text === '' ? blockText : `${text}\n${blockText}`
+      continue
+    }
+    flush()
+    if (points(blockHtml) <= limit) {
+      html = blockHtml
+      text = blockText
+      continue
+    }
+    chunks.push(...forceCut(block, limit))
+  }
+  flush()
+  return chunks
+}
diff --git a/plugins/naumi-enterprise/im-adapters/platforms/dingtalk.js b/plugins/naumi-enterprise/im-adapters/platforms/dingtalk.js
new file mode 100644
index 0000000..0ba10db
--- /dev/null
+++ b/plugins/naumi-enterprise/im-adapters/platforms/dingtalk.js
@@ -0,0 +1,284 @@
+// DingTalk stream mode: connections/open with the client credentials opens a
+// ticketed WebSocket; every frame is ACKed by echoing its messageId with
+// code 200, system pings get a pong, and the robot callback carries the
+// sessionWebhook for passive replies. Outside that window the OpenAPI
+// batchSend/groupMessages path answers instead. No buttons — the core
+// numbers choices. Wire details ported from dingtalk-stream (MIT, see
+// NOTICE).
+import { chunkMarkdown } from '../format.js'
+import { retryDelay, retryWait } from './retry.js'
+
+const GATEWAY = 'https://api.dingtalk.com'
+const OAPI = 'https://oapi.dingtalk.com'
+const TEXT_LIMIT = 5000
+const SOCKET_TIMEOUT = 30_000
+const IDLE_TIMEOUT = 10 * 60_000
+
+const gatewayBase = env => String(env.config?.gateway ?? env.config?.api ?? GATEWAY).replace(/\/+$/, '')
+const oapiBase = env => String(env.config?.oapi ?? env.config?.api ?? OAPI).replace(/\/+$/, '')
+
+export default {
+  id: 'dingtalk',
+
+  async check(fields, env) {
+    await appToken(fields, env)
+    return { account: { id: String(fields.clientId ?? '').trim(), name: String(fields.clientId ?? '').trim() } }
+  },
+
+  connect(fields, env, handlers) {
+    const clientId = String(fields.clientId ?? '').trim()
+    let stopped = false
+    let socket
+    let generation = 0
+    let reconnectTimer
+    let connectTimer
+    let idleTimer
+    let token
+    let tokenExpiresAt = 0
+    const ensureToken = async () => {
+      if (token !== undefined && tokenExpiresAt > Date.now() + 30_000) return token
+      const answer = await appToken(fields, env)
+      token = answer.accessToken
+      tokenExpiresAt = Date.now() + (Number(answer.expiresIn ?? 7200) * 1000)
+      return token
+    }
+    // Passive replies reuse the inbound sessionWebhook while it lives.
+    const sessionWebhooks = new Map()
+
+    const sendFrame = packet => { if (socket?.readyState === 1) socket.send(JSON.stringify(packet)) }
+    const ack = (headers, data = {}) => sendFrame({
+      specVersion: '1.0',
+      code: 200,
+      headers: { appType: 'STREAM', clientId, messageId: String(headers?.messageId ?? ''), time: String(Date.now()) },
+      message: 'OK',
+      data: JSON.stringify(data),
+    })
+
+    const markdown = async (chat, text) => {
+      const chunks = chunkMarkdown(String(text ?? ''), TEXT_LIMIT)
+      let messageId
+      for (const chunk of chunks) {
+        const hook = sessionWebhooks.get(chat.key)
+        if (hook !== undefined && hook.until > Date.now()) {
+          const response = await env.fetch(hook.url, {
+            method: 'POST',
+            headers: { 'content-type': 'application/json' },
+            body: JSON.stringify({ msgtype: 'markdown', markdown: { title: chunk.slice(0, 30), text: chunk } }),
+          })
+          const body = await response.json().catch(() => ({}))
+          if (body.errcode !== 0) throw Object.assign(new Error(String(body.errmsg ?? 'DingTalk refused the reply')), { permanent: true })
+          messageId = String(body.processQueryKey ?? messageId ?? '')
+          continue
+        }
+        if (chat.kind === 'direct') {
+          const answer = await robot(env, await ensureToken(), clientId, '/v1.0/robot/oToMessages/batchSend', {
+            robotCode: clientId, userIds: [chat.key],
+            msgKey: 'sampleMarkdown', msgParam: JSON.stringify({ title: chunk.slice(0, 30), text: chunk }),
+          })
+          messageId = String(answer?.processQueryKey ?? messageId ?? '')
+        } else {
+          const answer = await robot(env, await ensureToken(), clientId, '/v1.0/robot/groupMessages/send', {
+            robotCode: clientId, openConversationId: chat.key,
+            msgKey: 'sampleMarkdown', msgParam: JSON.stringify({ title: chunk.slice(0, 30), text: chunk }),
+          })
+          messageId = String(answer?.processQueryKey ?? messageId ?? '')
+        }
+      }
+      return { messageId }
+    }
+
+    const onCallback = async (headers, raw) => {
+      let data
+      try { data = JSON.parse(raw) } catch { return }
+      if (data.text === undefined && data.msgtype !== 'text' && data.msgtype !== 'richText' && data.msgtype !== 'picture') { ack(headers, { ok: true }); return }
+      const direct = data.conversationType === '1'
+      const mentioned = direct ? false : data.isInAtList === true
+      const key = String(direct ? data.senderStaffId ?? data.senderId ?? '' : data.conversationId ?? '')
+      if (data.sessionWebhook !== undefined) {
+        sessionWebhooks.set(key, { url: String(data.sessionWebhook), until: Date.now() + 20 * 60_000 })
+      }
+      // A picture message's content carries the download code, not text.
+      const text = String(data.text?.content ?? '').trim()
+      const sender = String(data.senderStaffId ?? data.senderId ?? '')
+      await handlers.onMessage({
+        chat: { key, kind: direct ? 'direct' : 'group', title: '' },
+        sender: { id: sender, name: String(data.senderNick ?? sender) },
+        text, images: [], files: [],
+        mentioned, messageId: String(data.msgId ?? ''),
+        unsupported: data.msgtype !== 'text' && data.text === undefined,
+      })
+      // Naumi: ACK only after the gateway's durable inbox admission.
+      ack(headers, { ok: true })
+    }
+
+    const clearSocketTimers = () => {
+      clearTimeout(connectTimer)
+      clearTimeout(idleTimer)
+      connectTimer = idleTimer = undefined
+    }
+    let openFailures = 0
+    const retry = (gen, error) => {
+      if (stopped || generation !== gen) return
+      generation += 1
+      clearSocketTimers()
+      const previous = socket
+      socket = undefined
+      try { previous?.close(4001, 'reconnect') } catch { /* already gone */ }
+      handlers.onStatus({ state: 'retrying', error })
+      clearTimeout(reconnectTimer)
+      reconnectTimer = setTimeout(() => { if (!stopped) void open() }, retryDelay(openFailures))
+      reconnectTimer.unref?.()
+      openFailures += 1
+    }
+    const open = async () => {
+      if (stopped) return
+      const gen = ++generation
+      let url
+      try {
+        const response = await env.fetch(`${gatewayBase(env)}/v1.0/gateway/connections/open`, {
+          method: 'POST',
+          headers: { 'content-type': 'application/json' },
+          body: JSON.stringify({
+            clientId, clientSecret: String(fields.clientSecret ?? '').trim(),
+            ua: 'ds-bot',
+            subscriptions: [{ type: 'CALLBACK', topic: '/v1.0/im/bot/messages/get' }],
+          }),
+        })
+        if (!response.ok && !(response.status >= 500 || response.status === 429)) {
+          throw Object.assign(new Error(`DingTalk answered ${response.status}`), { permanent: true })
+        }
+        const body = await response.json().catch(() => ({}))
+        if (body.endpoint === undefined) {
+          const error = new Error(String(body.message ?? body.error ?? 'DingTalk refused the connection'))
+          // A 200 that names no endpoint is the platform refusing the app.
+          error.permanent = response.ok
+          throw error
+        }
+        url = `${body.endpoint}?ticket=${body.ticket}`
+      } catch (error) {
+        if (stopped || generation !== gen) return
+        if (error?.permanent === true) {
+          handlers.onStatus({ state: 'error', error: error.message })
+          return
+        }
+        // The handshake is retried, also when this is the first one: a connection
+        // started before the network is up is not over (#1119).
+        retry(gen, error.message)
+        return
+      }
+      if (stopped || generation !== gen) return
+      let next
+      try {
+        next = new env.WebSocket(url)
+        socket = next
+      } catch (error) {
+        retry(gen, `DingTalk could not open a socket: ${error?.message ?? error}`)
+        return
+      }
+      const current = () => !stopped && generation === gen && socket === next
+      const touch = () => {
+        clearTimeout(idleTimer)
+        idleTimer = setTimeout(() => retry(gen, 'DingTalk received no frames for 10 minutes'), IDLE_TIMEOUT)
+        idleTimer.unref?.()
+      }
+      next.addEventListener('message', (event) => {
+        if (!current()) return
+        touch()
+        let packet
+        try { packet = JSON.parse(String(event.data)) } catch { return }
+        const headers = packet.headers ?? {}
+        if (packet.type === 'SYSTEM') {
+          const disconnect = headers.topic === 'disconnect'
+          if (disconnect || String(packet.data ?? '').includes('ping') || headers.eventType === 'ping' || headers.topic === 'ping') {
+            sendFrame({ code: 200, headers, message: 'OK', data: packet.data })
+          }
+          if (disconnect) retry(gen, 'DingTalk requested a reconnect')
+          return
+        }
+        if (packet.type === 'CALLBACK' || packet.type === 'EVENT') {
+          void onCallback(headers, String(packet.data ?? '{}')).catch(error => env.log?.warn?.('ds-bot im: dingtalk message failed: %s', error?.message ?? error))
+        }
+      })
+      next.addEventListener('open', () => {
+        if (!current()) return
+        clearTimeout(connectTimer)
+        openFailures = 0
+        touch()
+        handlers.onStatus({ state: 'ready' })
+      })
+      next.addEventListener('close', () => retry(gen, 'DingTalk socket closed'))
+      next.addEventListener('error', () => retry(gen, 'DingTalk socket error'))
+      connectTimer = setTimeout(() => retry(gen, 'DingTalk socket opening timed out'), SOCKET_TIMEOUT)
+      connectTimer.unref?.()
+    }
+
+    handlers.onStatus({ state: 'connecting' })
+    // The access token is fetched until it arrives: a connection started before the
+    // network is up must connect once it is (#1119).
+    void (async () => {
+      let attempt = 0
+      while (!stopped) {
+        try {
+          const got = await appToken(fields, env)
+          token = got.accessToken
+          tokenExpiresAt = got.expiresAt
+          break
+        } catch (error) {
+          if (stopped) return
+          if (error?.permanent === true) {
+            handlers.onStatus({ state: 'error', error: error.message })
+            return
+          }
+          handlers.onStatus({ state: 'retrying', error: error.message })
+          await retryWait(retryDelay(attempt))
+          attempt += 1
+        }
+      }
+      if (!stopped) await open()
+    })()
+
+    return {
+      send: async (chat, { text }) => markdown(chat, text),
+      stop: () => {
+        stopped = true
+        generation += 1
+        clearTimeout(reconnectTimer)
+        clearSocketTimers()
+        const previous = socket
+        socket = undefined
+        try { previous?.close(1000, 'stop') } catch { /* not open */ }
+      },
+    }
+  },
+}
+
+// The app-level access token for OpenAPI sends (oapi gettoken, cached until
+// it expires).
+async function appToken(fields, env) {
+  const url = `${oapiBase(env)}/gettoken?appkey=${encodeURIComponent(String(fields.clientId ?? '').trim())}&appsecret=${encodeURIComponent(String(fields.clientSecret ?? '').trim())}`
+  const response = await env.fetch(url)
+  const body = await response.json().catch(() => ({}))
+  if (body.errcode !== 0 || body.access_token === undefined) {
+    const error = new Error(String(body.errmsg ?? 'DingTalk refused these credentials'))
+    // A 5xx or a 429 is the service, not the credentials: retry those.
+    error.permanent = !(response.status >= 500 || response.status === 429)
+    throw error
+  }
+  return { accessToken: body.access_token, expiresAt: Date.now() + Math.max(60, Number(body.expires_in ?? 7200) - 300) * 1000 }
+}
+
+async function robot(env, token, clientId, path, body) {
+  if (token === undefined) throw Object.assign(new Error('DingTalk has no access token yet'), { permanent: false })
+  const response = await env.fetch(`${gatewayBase(env)}${path}`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json', 'x-acs-dingtalk-access-token': token },
+    body: JSON.stringify(body),
+  })
+  const json = await response.json().catch(() => ({}))
+  if (!response.ok) {
+    const error = new Error(String(json.message ?? json.errmsg ?? `DingTalk answered ${response.status}`))
+    error.permanent = response.status >= 400 && response.status < 500 && response.status !== 429
+    throw error
+  }
+  return json
+}
diff --git a/plugins/naumi-enterprise/im-adapters/platforms/feishu.js b/plugins/naumi-enterprise/im-adapters/platforms/feishu.js
new file mode 100644
index 0000000..4f2bca8
--- /dev/null
+++ b/plugins/naumi-enterprise/im-adapters/platforms/feishu.js
@@ -0,0 +1,492 @@
+// Feishu / Lark: the long connection speaks protobuf pbbp2 frames — control
+// pings sent at the server's interval, data frames ACKed by sending the frame back with a
+// {"code":200} payload and a biz_rt header; split payloads reassemble by
+// sum/seq. p2p messages are direct; a group message counts when the bot's
+// open_id is in its mentions. Sends go through the OpenAPI with a tenant
+// access token: interactive cards with a markdown element and buttons, edited
+// by PATCH. The tiny protobuf codec below implements only this frame shape.
+// Protocol ported from @larksuiteoapi/node-sdk (MIT, see NOTICE).
+import { chunkMarkdown } from '../format.js'
+import { retryDelay, retryWait } from './retry.js'
+
+const TEXT_LIMIT = 4000
+const SOCKET_TIMEOUT = 30_000
+const pingInterval = seconds => {
+  const ms = Number(seconds) * 1000
+  return Number.isFinite(ms) && ms >= 1000 && ms <= 2_147_483_647 ? ms : undefined
+}
+
+const apiBase = (env, fields) => String(env.config?.api ?? (fields.domain === 'lark' ? 'https://open.larksuite.com' : 'https://open.feishu.cn')).replace(/\/+$/, '')
+
+// ---- pbbp2.Frame codec (protobuf wire format, only this message) ----------
+// Frame: SeqID u64=1, LogID u64=2, service i32=3, method i32=4,
+// headers repeated Header=5, payload_encoding string=6, payload_type
+// string=7, payload bytes=8, LogIDNew string=9. Header: key string=1, value
+// string=2. Wire types: 0 varint, 2 length-delimited.
+const uvarint = (value) => {
+  let v = BigInt(value)
+  const bytes = []
+  while (v > 127n) { bytes.push(Number(v & 127n) | 128); v >>= 7n }
+  bytes.push(Number(v))
+  return bytes
+}
+const field = (number, wire, bytes) => {
+  const tag = uvarint((number << 3) | wire)
+  if (wire === 0) return [...tag, ...uvarint(bytes)]
+  const body = typeof bytes === 'string' ? [...Buffer.from(bytes, 'utf8')] : [...bytes]
+  return [...tag, ...uvarint(body.length), ...body]
+}
+const encodeHeader = ({ key, value }) => [...field(1, 2, key), ...field(2, 2, value)]
+export const encodeFrame = (frame) => {
+  const out = []
+  if (frame.SeqID !== undefined) out.push(...field(1, 0, frame.SeqID))
+  if (frame.LogID !== undefined) out.push(...field(2, 0, frame.LogID))
+  if (frame.service !== undefined) out.push(...field(3, 0, frame.service))
+  if (frame.method !== undefined) out.push(...field(4, 0, frame.method))
+  for (const header of frame.headers ?? []) out.push(...field(5, 2, encodeHeader(header)))
+  if (frame.payloadEncoding !== undefined) out.push(...field(6, 2, frame.payloadEncoding))
+  if (frame.payloadType !== undefined) out.push(...field(7, 2, frame.payloadType))
+  if (frame.payload !== undefined) out.push(...field(8, 2, frame.payload))
+  if (frame.LogIDNew !== undefined) out.push(...field(9, 2, frame.LogIDNew))
+  return Buffer.from(out)
+}
+export const decodeFrame = (buffer) => {
+  const frame = { headers: [] }
+  let at = 0
+  const varint = () => {
+    let value = 0n
+    let shift = 0n
+    while (at < buffer.length) {
+      const byte = buffer[at]
+      at += 1
+      value |= BigInt(byte & 127) << shift
+      if ((byte & 128) === 0) break
+      shift += 7n
+    }
+    return value
+  }
+  const bytes = () => {
+    const length = Number(varint())
+    const part = buffer.subarray(at, at + length)
+    at += length
+    return part
+  }
+  const header = (buf) => {
+    let index = 0
+    const out = {}
+    const v = () => {
+      let value = 0n
+      let shift = 0n
+      while (index < buf.length) {
+        const byte = buf[index]
+        index += 1
+        value |= BigInt(byte & 127) << shift
+        if ((byte & 128) === 0) break
+        shift += 7n
+      }
+      return value
+    }
+    const b = () => {
+      const length = Number(v())
+      const part = buf.subarray(index, index + length)
+      index += length
+      return part
+    }
+    while (index < buf.length) {
+      const tag = Number(v())
+      if (tag >> 3 === 1) out.key = b().toString('utf8')
+      else if (tag >> 3 === 2) out.value = b().toString('utf8')
+      else if ((tag & 7) === 2) b()
+      else if ((tag & 7) === 0) v()
+    }
+    return out
+  }
+  while (at < buffer.length) {
+    const tag = Number(varint())
+    const number = tag >> 3
+    const wire = tag & 7
+    if (wire === 0) {
+      const value = varint()
+      if (number === 1) frame.SeqID = Number(value)
+      else if (number === 2) frame.LogID = Number(value)
+      else if (number === 3) frame.service = Number(value)
+      else if (number === 4) frame.method = Number(value)
+    } else if (wire === 2) {
+      const value = bytes()
+      if (number === 5) frame.headers.push(header(value))
+      else if (number === 6) frame.payloadEncoding = value.toString('utf8')
+      else if (number === 7) frame.payloadType = value.toString('utf8')
+      else if (number === 8) frame.payload = Buffer.from(value)
+      else if (number === 9) frame.LogIDNew = value.toString('utf8')
+    }
+  }
+  return frame
+}
+// ---------------------------------------------------------------------------
+
+export default {
+  id: 'feishu',
+
+  async check(fields, env) {
+    const { token } = await tenantToken(fields, env)
+    const me = await api(env, apiBase(env, fields), token, '/open-apis/bot/v3/info', { method: 'GET' })
+    const bot = me?.bot ?? me
+    return { account: { id: String(bot?.open_id ?? bot?.app_id ?? fields.appId), name: bot?.app_name ?? String(fields.appId) } }
+  },
+
+  connect(fields, env, handlers) {
+    const appId = String(fields.appId ?? '').trim()
+    const appSecret = String(fields.appSecret ?? '').trim()
+    let stopped = false
+    let socket
+    let generation = 0
+    let reconnectTimer
+    let connectTimer
+    let pingTimer
+    let heartbeatTimer
+    let token
+    let tokenExpiresAt = 0
+    let refreshing
+    let botOpenId = ''
+    // Split data frames reassemble by (sum, seq) until all parts arrive.
+    const parts = new Map()
+
+    // Inbound downloads share the expiry check: a socket that only receives
+    // still needs a live token. Callers wait on the one in-flight refresh —
+    // two images arriving together must not race two tokens.
+    const freshToken = async () => {
+      if (token === undefined || Date.now() > tokenExpiresAt - 30_000) {
+        refreshing ??= tenantToken({ ...fields, appId, appSecret }, env)
+          .then(got => { token = got.token; tokenExpiresAt = got.expiresAt })
+          .finally(() => { refreshing = undefined })
+        await refreshing
+      }
+      return token
+    }
+
+    const rest = async (path, { method = 'POST', body } = {}) =>
+      api(env, apiBase(env, fields), await freshToken(), path, { method, body })
+
+    const sendFrame = (buffer) => { if (socket?.readyState === 1) socket.send(buffer) }
+    const pong = (frame) => sendFrame(encodeFrame({ ...frame, headers: frame.headers.map(h => h.key === 'type' ? { key: 'type', value: 'pong' } : h), payload: Buffer.from('pong') }))
+    const ack = (frame, ms) => sendFrame(encodeFrame({
+      ...frame,
+      headers: [...frame.headers.filter(h => h.key !== 'biz_rt'), { key: 'biz_rt', value: String(ms) }],
+      payload: Buffer.from(JSON.stringify({ code: 200, headers: {}, data: '' })),
+      payloadType: 'json',
+    }))
+
+    const dispatch = async (type, body) => {
+      const payload = JSON.parse(body.toString('utf8'))
+      if (type === 'event' && payload.header?.event_type === 'im.message.receive_v1') {
+        const event = payload.event ?? {}
+        const message = event.message ?? {}
+        const direct = message.chat_type === 'p2p'
+        const mentioned = !direct && (message.mentions ?? []).some(m => m.id?.open_id === botOpenId || m.key === `@_user_${1}`)
+        const content = safeJson(message.content)
+        const text = String(content.text ?? '').replace(/@_user_\d+/g, '').trim()
+        const images = []
+        if (message.message_type === 'image' && content.image_key !== undefined) {
+          const bytes = await freshToken()
+            .then(bearer => resource(env, apiBase(env, fields), bearer, message.message_id, content.image_key, 'image'))
+            .catch(() => undefined)
+          if (bytes !== undefined) {
+            const buffer = Buffer.from(bytes)
+            images.push({ mediaType: imageMediaType(buffer), data: buffer.toString('base64') })
+          } else env.log?.warn?.('ds-bot im: feishu image download failed for %s', String(message.message_id ?? ''))
+        }
+        const sender = event.sender?.sender_id?.open_id ?? event.sender?.user_id ?? ''
+        await handlers.onMessage({
+          chat: { key: String(message.chat_id ?? ''), kind: direct ? 'direct' : 'group', title: String(message.chat_id ?? '') },
+          sender: { id: String(sender), name: String(sender) },
+          text, images, files: [],
+          mentioned, messageId: String(message.message_id ?? ''),
+          threadId: String(message.thread_id ?? message.root_id ?? ''),
+          unsupported: !['text', 'image'].includes(message.message_type),
+        })
+      }
+      if (type === 'card' || payload.header?.event_type === 'card.action.trigger') {
+        const event = payload.event ?? {}
+        const action = event.action ?? event.actions?.[0] ?? {}
+        const data = action.value ?? action.action_data?.value ?? action.action_data ?? {}
+        await handlers.onAction({
+          chat: { key: String(event.context?.open_chat_id ?? event.message?.chat_id ?? ''), kind: 'direct', title: '' },
+          sender: { id: String(event.operator?.open_id ?? event.user_id ?? ''), name: '' },
+          data: String(typeof data === 'object' ? (data.v ?? JSON.stringify(data)) : data),
+          messageId: String(event.message_id ?? event.context?.open_message_id ?? ''),
+        })
+      }
+    }
+
+    const clearSocketTimers = () => {
+      clearTimeout(connectTimer)
+      clearTimeout(pingTimer)
+      clearTimeout(heartbeatTimer)
+      connectTimer = pingTimer = heartbeatTimer = undefined
+    }
+    let openFailures = 0
+    const retry = (gen, error) => {
+      if (stopped || generation !== gen) return
+      generation += 1
+      clearSocketTimers()
+      const previous = socket
+      socket = undefined
+      try { previous?.close(4001, 'reconnect') } catch { /* already gone */ }
+      handlers.onStatus({ state: 'retrying', error })
+      clearTimeout(reconnectTimer)
+      reconnectTimer = setTimeout(() => { if (!stopped) void open() }, retryDelay(openFailures))
+      reconnectTimer.unref?.()
+      openFailures += 1
+    }
+    const open = async () => {
+      if (stopped) return
+      const gen = ++generation
+      let url
+      let pingEvery = 90_000
+      try {
+        const answer = await env.fetch(`${apiBase(env, fields)}/callback/ws/endpoint`, {
+          method: 'POST',
+          headers: { 'content-type': 'application/json', authorization: `Bearer ${await freshToken()}` },
+          body: JSON.stringify({ AppID: appId, AppSecret: appSecret }),
+        })
+        const body = await answer.json().catch(() => ({}))
+        url = body.data?.URL
+        if (url === undefined || (body.code !== undefined && body.code !== 0)) {
+          const reason = body.msg ?? `Feishu answered ${answer.status}`
+          const error = new Error(body.code === undefined ? reason : `${reason} (code ${body.code})`)
+          error.status = answer.status
+          // A 200 that carries no WebSocket URL is the platform refusing the app.
+          error.permanent = answer.ok || (answer.status >= 400 && answer.status < 500 && answer.status !== 429)
+          throw error
+        }
+        pingEvery = pingInterval(body.data?.ClientConfig?.PingInterval) ?? pingEvery
+      } catch (error) {
+        if (stopped || generation !== gen) return
+        if (error?.permanent === true) {
+          handlers.onStatus({ state: 'error', error: error.message })
+          return
+        }
+        // The handshake is retried, also when this is the first one: a connection
+        // started before the network is up is not over (#1119).
+        retry(gen, error.message)
+        return
+      }
+      if (stopped || generation !== gen) return
+      let next
+      let service
+      try {
+        const id = Number(new URL(url).searchParams.get('service_id') ?? 0)
+        service = Number.isSafeInteger(id) && id >= 0 ? id : 0
+        next = new env.WebSocket(url)
+        next.binaryType = 'arraybuffer'
+        socket = next
+      } catch (error) {
+        retry(gen, `Feishu could not open a socket: ${error?.message ?? error}`)
+        return
+      }
+      const current = () => !stopped && generation === gen && socket === next
+      const schedulePing = () => {
+        clearTimeout(pingTimer)
+        pingTimer = setTimeout(ping, pingEvery)
+        pingTimer.unref?.()
+      }
+      const ping = () => {
+        if (!current() || next.readyState !== 1) return
+        if (heartbeatTimer === undefined) {
+          heartbeatTimer = setTimeout(() => retry(gen, 'Feishu heartbeat timed out'), SOCKET_TIMEOUT)
+          heartbeatTimer.unref?.()
+        }
+        try {
+          next.send(encodeFrame({ SeqID: 0, LogID: 0, service, method: 0, headers: [{ key: 'type', value: 'ping' }] }))
+        } catch {
+          retry(gen, 'Feishu could not send a heartbeat')
+          return
+        }
+        schedulePing()
+      }
+      next.addEventListener('message', (event) => {
+        if (!current()) return
+        // Any inbound frame answers the liveness probe. The next scheduled
+        // ping arms it again; healthy idle time must not start a short timeout.
+        clearTimeout(heartbeatTimer)
+        heartbeatTimer = undefined
+        let frame
+        try { frame = decodeFrame(Buffer.from(event.data)) } catch { return }
+        const type = frame.headers.find(h => h.key === 'type')?.value
+        if (frame.method === 0 && type === 'ping') { pong(frame); return }
+        if (frame.method === 0 && type === 'pong') {
+          const interval = pingInterval(safeJson(frame.payload?.toString('utf8'))?.PingInterval)
+          if (interval !== undefined) { pingEvery = interval; schedulePing() }
+          return
+        }
+        if (frame.method === 1 && type === 'reconnect') { retry(gen, 'Feishu requested a reconnect'); return }
+        if (frame.method !== 1 || (type !== 'event' && type !== 'card')) return
+        const messageId = frame.headers.find(h => h.key === 'message_id')?.value ?? ''
+        const sum = Number(frame.headers.find(h => h.key === 'sum')?.value ?? 1)
+        const seq = Number(frame.headers.find(h => h.key === 'seq')?.value ?? 1)
+        let frames = [frame]
+        if (sum > 1) {
+          if (!Number.isInteger(sum) || sum > 128 || !Number.isInteger(seq) || seq < 0 || seq > sum) return
+          const now = Date.now()
+          for (const [key, value] of parts) if (value.expires < now) parts.delete(key)
+          if (!parts.has(messageId) && parts.size >= 64) return
+          const held = parts.get(messageId) ?? { received: new Map(), frames: new Map(), sum, expires: now + 60000 }
+          if (held.sum !== sum) return
+          held.received.set(seq, frame.payload)
+          held.frames.set(seq, frame)
+          parts.set(messageId, held)
+          if (held.received.size !== sum) return
+          frame.payload = Buffer.concat([...held.received.keys()].sort((a, b) => a - b).map(s => held.received.get(s)))
+          frames = [...held.frames.values()]
+          parts.delete(messageId)
+        }
+        // Naumi: persist the assembled event before acknowledging any of its fragments.
+        void dispatch(type, frame.payload).then(() => { for (const part of frames) ack(part, 0) }).catch(error => env.log?.warn?.('ds-bot im: feishu event failed: %s', error?.message ?? error))
+      })
+      next.addEventListener('open', () => {
+        if (!current()) return
+        clearTimeout(connectTimer)
+        openFailures = 0
+        handlers.onStatus({ state: 'ready' })
+        ping()
+      })
+      next.addEventListener('close', () => retry(gen, 'Feishu socket closed'))
+      next.addEventListener('error', () => retry(gen, 'Feishu socket error'))
+      connectTimer = setTimeout(() => retry(gen, 'Feishu socket opening timed out'), SOCKET_TIMEOUT)
+      connectTimer.unref?.()
+    }
+
+    handlers.onStatus({ state: 'connecting' })
+    // The tenant token is fetched until it arrives: a connection started before the
+    // network is up must connect once it is (#1119). The bot identity is fetched
+    // again per handshake below; here it only fills the mention check.
+    void (async () => {
+      let attempt = 0
+      while (!stopped) {
+        try {
+          const got = await tenantToken({ ...fields, appId, appSecret }, env)
+          token = got.token
+          tokenExpiresAt = got.expiresAt
+          const me = await api(env, apiBase(env, fields), token, '/open-apis/bot/v3/info', { method: 'GET' }).catch(() => ({}))
+          botOpenId = String(me?.bot?.open_id ?? me?.open_id ?? '')
+          break
+        } catch (error) {
+          if (stopped) return
+          if (error?.permanent === true) {
+            handlers.onStatus({ state: 'error', error: error.message })
+            return
+          }
+          handlers.onStatus({ state: 'retrying', error: error.message })
+          await retryWait(retryDelay(attempt))
+          attempt += 1
+        }
+      }
+      if (!stopped) await open()
+    })()
+
+    const card = (text, buttons) => JSON.stringify({
+      schema: '2.0',
+      body: {
+        elements: [
+          { tag: 'markdown', content: text },
+          ...(buttons?.length > 0 ? [{
+            tag: 'action',
+            actions: buttons.slice(0, 5).map(button => ({
+              tag: 'button', type: 'primary',
+              text: { tag: 'plain_text', content: button.label.slice(0, 20) },
+              value: { v: button.data },
+            })),
+          }] : []),
+        ],
+      },
+    })
+
+    return {
+      send: async (chat, { text, buttons }) => {
+        const chunks = chunkMarkdown(String(text ?? ''), TEXT_LIMIT)
+        let messageId
+        for (const [index, chunk] of chunks.entries()) {
+          const interactive = buttons !== undefined && index === chunks.length - 1
+          const sent = await rest('/open-apis/im/v1/messages?receive_id_type=chat_id', {
+            body: {
+              receive_id: chat.key,
+              msg_type: interactive ? 'interactive' : 'text',
+              content: interactive ? card(chunk, buttons) : JSON.stringify({ text: chunk }),
+            },
+          })
+          messageId = String(sent?.data?.message_id ?? messageId ?? '')
+        }
+        return { messageId }
+      },
+      edit: async (chat, messageId, { text, buttons }) => {
+        await rest(`/open-apis/im/v1/messages/${messageId}`, {
+          method: 'PATCH',
+          body: { msg_type: 'interactive', content: card(toMarkdown(text).slice(0, TEXT_LIMIT), buttons) },
+        })
+      },
+      stop: () => {
+        stopped = true
+        generation += 1
+        clearTimeout(reconnectTimer)
+        clearSocketTimers()
+        parts.clear()
+        const previous = socket
+        socket = undefined
+        try { previous?.close(1000, 'stop') } catch { /* not open */ }
+      },
+    }
+  },
+}
+
+const safeJson = (text) => { try { return JSON.parse(text ?? '{}') } catch { return {} } }
+const toMarkdown = text => String(text ?? '')
+
+function imageMediaType(bytes) {
+  if (bytes.subarray(0, 8).equals(Buffer.from([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]))) return 'image/png'
+  if (bytes[0] === 0xff && bytes[1] === 0xd8 && bytes[2] === 0xff) return 'image/jpeg'
+  const header = bytes.toString('latin1', 0, 6)
+  if (header === 'GIF87a' || header === 'GIF89a') return 'image/gif'
+  if (bytes.toString('latin1', 0, 4) === 'RIFF' && bytes.toString('latin1', 8, 12) === 'WEBP') return 'image/webp'
+  throw new Error('Feishu returned an unsupported image format')
+}
+
+async function tenantToken(fields, env) {
+  const response = await env.fetch(`${apiBase(env, fields)}/open-apis/auth/v3/tenant_access_token/internal`, {
+    method: 'POST',
+    headers: { 'content-type': 'application/json' },
+    body: JSON.stringify({ app_id: String(fields.appId ?? '').trim(), app_secret: String(fields.appSecret ?? '').trim() }),
+  })
+  const body = await response.json().catch(() => ({}))
+  if (body.tenant_access_token === undefined) {
+    const error = new Error(body.msg ?? 'Feishu refused these credentials')
+    error.status = response.status
+    // A 5xx or a 429 is the service, not the credentials: retry those.
+    error.permanent = !(response.status >= 500 || response.status === 429)
+    throw error
+  }
+  return { token: body.tenant_access_token, expiresAt: Date.now() + Math.max(60, Number(body.expire ?? 7200) - 300) * 1000 }
+}
+
+async function api(env, base, token, path, { method = 'GET', body } = {}) {
+  const response = await env.fetch(`${base}${path}`, {
+    method,
+    headers: { authorization: `Bearer ${token}`, 'content-type': 'application/json' },
+    body: body === undefined ? undefined : JSON.stringify(body),
+  })
+  const json = await response.json().catch(() => ({}))
+  if (!response.ok || (json.code !== undefined && json.code !== 0)) {
+    const error = new Error(String(json.msg ?? `Feishu answered ${response.status}`))
+    error.status = response.status
+    error.permanent = response.status >= 400 && response.status < 500 && response.status !== 429
+    throw error
+  }
+  return json
+}
+
+async function resource(env, base, token, messageId, key, type) {
+  const response = await env.fetch(`${base}/open-apis/im/v1/messages/${messageId}/resources/${key}?type=${type}`, {
+    headers: { authorization: `Bearer ${token}` },
+  })
+  if (!response.ok) return undefined
+  return new Uint8Array(await response.arrayBuffer())
+}
diff --git a/plugins/naumi-enterprise/im-adapters/platforms/retry.js b/plugins/naumi-enterprise/im-adapters/platforms/retry.js
new file mode 100644
index 0000000..ecb6ee8
--- /dev/null
+++ b/plugins/naumi-enterprise/im-adapters/platforms/retry.js
@@ -0,0 +1,13 @@
+// Waits between attempts to open an IM connection when the network is down (#1119).
+// The first wait is short so a brief drop recovers quickly; it grows to a cap and
+// repeats, so a long outage is retried at a steady pace instead of a request loop.
+export const RETRY_DELAYS_MS = [250, 500, 1_000, 2_000, 5_000, 15_000, 30_000]
+
+export const retryDelay = attempt => RETRY_DELAYS_MS[Math.min(Math.max(attempt, 0), RETRY_DELAYS_MS.length - 1)]
+
+// A wait a stopped adapter leaves behind: it does not hold the process, and every
+// retry loop checks `stopped` once it returns.
+export const retryWait = ms => new Promise((resolve) => {
+  const timer = setTimeout(resolve, ms)
+  timer.unref?.()
+})
diff --git a/plugins/naumi-enterprise/im-delivery.js b/plugins/naumi-enterprise/im-delivery.js
new file mode 100644
index 0000000..743cbf0
--- /dev/null
+++ b/plugins/naumi-enterprise/im-delivery.js
@@ -0,0 +1,37 @@
+import {chunkMarkdown} from './im-adapters/format.js';
+
+export function originOf(input){return {bindingId:input.bindingId,bindingRevision:input.bindingRevision,userId:input.userId,connectionId:input.connectionId,chat:input.chat,inputId:input.id};}
+
+/** One durable send per chunk. Unknown receipt is NOT a reason to call the model again. */
+export class IMDelivery{
+  constructor({store,getHandle,sendFile}){Object.assign(this,{store,getHandle,sendFile});}
+  text(input,key,text,buttons,meta={}){
+    const chunks=chunkMarkdown(String(text||'（回复已结束）'),3000);
+    chunks.forEach((text,index)=>this.store.enqueue(originOf(input),`${key}:text:${index}`,{type:'text',text,...meta,...buttons&&index===chunks.length-1?{buttons}:{}}));
+  }
+  files(input,key,files){for(const [index,ref] of (files??[]).entries())this.store.enqueue(originOf(input),`${key}:file:${index}`,{type:'file',ref});}
+  async pump(){
+    const blocked=new Set();
+    for(const row of this.store.outputs()){
+      if(['queued','unknown','failed'].includes(row.state)&&!this.store.valid(row)){this.store.updateOutput(row.id,{state:'revoked',previousState:row.state});continue;}
+      if(row.payload.interactionId&&this.store.interaction(row.payload.interactionId)?.state!=='open'&&row.state==='queued'){this.store.updateOutput(row.id,{state:'revoked'});continue;}
+      if(['unknown','failed'].includes(row.state)){blocked.add(row.bindingId);continue;}
+      if(row.state!=='queued')continue;
+      if(!this.store.valid(row)){this.store.updateOutput(row.id,{state:'revoked'});continue;}
+      if(row.nextAt>Date.now()){blocked.add(row.bindingId);continue;}if(blocked.has(row.bindingId))continue;
+      const handle=this.getHandle(row.connectionId);if(!handle)continue;
+      if(row.payload.interactionId&&this.store.interaction(row.payload.interactionId)?.state!=='open'){this.store.updateOutput(row.id,{state:'revoked'});continue;}
+      this.store.updateOutput(row.id,{state:'sending',attempt:row.attempt+1});
+      try{
+        const receipt=row.payload.type==='file'?await this.sendFile(row):await handle.send(row.chat,row.payload);
+        this.store.updateOutput(row.id,{state:'sent',receipt:receipt??{},sentAt:new Date().toISOString(),error:null});
+      }catch(e){
+        // Explicit rate-limit rejection is retryable. Network/timeout/5xx can have committed remotely.
+        const retry=e.status===429&&row.attempt<5;
+        const state=retry?'queued':e.permanent===true?'failed':'unknown';
+        this.store.updateOutput(row.id,{state,nextAt:Date.now()+Math.min(60000,2000*2**row.attempt),error:retry?'IM_RATE_LIMITED':state==='unknown'?'IM_SEND_UNKNOWN':'IM_SEND_REJECTED'});
+        blocked.add(row.bindingId);
+      }
+    }
+  }
+}
diff --git a/plugins/naumi-enterprise/im-gateway.js b/plugins/naumi-enterprise/im-gateway.js
new file mode 100644
index 0000000..ab9bd49
--- /dev/null
+++ b/plugins/naumi-enterprise/im-gateway.js
@@ -0,0 +1,37 @@
+import {join,dirname} from 'node:path';
+import {IMStore} from './im-store.js';
+import {IMService} from './im-service.js';
+
+export function createIMHandler(scope,service){return async(req,res)=>{
+  res.setHeader('Cache-Control','private, no-store');res.setHeader('X-Content-Type-Options','nosniff');res.setHeader('X-Naumi-IM','1');
+  const send=(status,value)=>{if(!res.destroyed)res.writeHead(status,{'Content-Type':'application/json; charset=utf-8'}).end(JSON.stringify(value));};
+  const admission=scope.connection.admit(req);if('rejection'in admission){send(admission.rejection,{error:'AUTH_REQUIRED'});return;}
+  if(admission.peer.principal.kind!=='owner'){send(403,{error:'OWNER_REQUIRED'});return;}
+  try{
+    if(req.method==='GET'){send(200,await service.read());return;}
+    if(req.method!=='POST'){res.setHeader('Allow','GET, POST');send(405,{error:'IM_METHOD'});return;}
+    if(req.headers['x-naumi-im']!=='1'||req.headers.origin&&![`http://${req.headers.host}`,`https://${req.headers.host}`].includes(req.headers.origin)){send(403,{error:'IM_SAME_ORIGIN'});return;}
+    if(!/^application\/json(?:\s*;|$)/i.test(req.headers['content-type']??'')){send(415,{error:'IM_JSON_REQUIRED'});return;}
+    const chunks=[];let size=0;for await(const chunk of req){size+=chunk.length;if(size>32768){send(413,{error:'IM_BODY_TOO_LARGE'});return;}chunks.push(chunk);}
+    let input;try{input=JSON.parse(Buffer.concat(chunks).toString('utf8'));}catch{send(400,{error:'IM_INVALID_REQUEST'});return;}
+    send(200,await service.execute(input));
+  }catch(e){const code=/^IM_[A-Z_]+$/.test(e.message)?e.message:'IM_INVALID_REQUEST';send(code==='IM_CONFLICT'?409:code==='IM_CHECK_FAILED'?502:400,{error:code});}
+};}
+
+export function installIMGateway(ctx,directory,getTasks,getGroups){
+  return ctx.inject(['webServer','connection','credentials','agents'],scope=>{
+    let store;try{store=new IMStore(join(dirname(directory.file),'im-gateway.sqlite'));}catch{scope.logger.warn('IM_STORAGE_UNAVAILABLE');return;}
+    const service=new IMService({store,directory,getTasks,getGroups,credentials:scope.credentials,ctx:scope,onError:code=>scope.logger.warn(code)});
+    const removeOwner=directory.registerSessionOwner(sessionId=>store.sessionOwner(sessionId));
+    const installed=new Map(),install=agent=>{if(!installed.has(agent))installed.set(agent,service.interactions.install(agent));};
+    scope.on('agent/created',({agent})=>install(agent));scope.on('agent/disposed',({agent})=>{installed.get(agent)?.();installed.delete(agent);});
+    for(const agent of scope.agents.list())install(agent);
+    scope.on('session/event',(_session,event)=>{if(['turn/end','tool/result','user/message'].includes(event.type))void service.kick();});
+    scope.effect(()=>scope.webServer.register({kind:'exact',path:'/naumi/im',handler:createIMHandler(scope,service)}));
+    scope.effect(()=>{
+      const timer=setInterval(()=>void service.kick(),2000);timer.unref?.();
+      void service.sync().then(()=>service.kick()).catch(()=>scope.logger.warn('IM_START_PENDING'));
+      return async()=>{clearInterval(timer);for(const dispose of installed.values())dispose();installed.clear();await service.close();removeOwner();};
+    });
+  });
+}
diff --git a/plugins/naumi-enterprise/im-interactions.js b/plugins/naumi-enterprise/im-interactions.js
new file mode 100644
index 0000000..ea73c98
--- /dev/null
+++ b/plugins/naumi-enterprise/im-interactions.js
@@ -0,0 +1,76 @@
+import {randomBytes} from 'node:crypto';
+import {originOf} from './im-delivery.js';
+
+const invalid=()=>{throw Error('IM_ANSWER_INVALID');};
+function answer(questions,text){
+  const parts=text.split('|').map(v=>v.trim());if(parts.length!==questions.length)invalid();
+  return {answers:questions.map((q,index)=>{
+    const value=parts[index];if(!value)invalid();
+    const numbers=/^\d+(?:\s*,\s*\d+)*$/.test(value)?value.split(',').map(v=>Number(v.trim())):null;
+    if(numbers){if(!q.options||!q.multiSelect&&numbers.length!==1||new Set(numbers).size!==numbers.length)invalid();const selected=numbers.map(n=>q.options[n-1]?.label);if(selected.some(v=>!v))invalid();return {id:q.id,selected};}
+    if(q.intent?.kind==='approval'){const choice=q.options?.find(o=>o.label===value);if(!choice||value===q.intent.always)invalid();return {id:q.id,selected:[value]};}
+    return {id:q.id,selected:[],custom:value};
+  })};
+}
+
+/** Only a scoped native answerer; no replacement approval policy or event fabrication. */
+export class IMInteractions{
+  constructor(service){this.service=service;}
+  install(agent){
+    const disposers=[];
+    disposers.push(agent.ctx.on('approval/request',async(req,next)=>{
+      if(req.agent!==agent)return next();const origin=await this.service.activeOrigin(agent.id);if(!origin)return next();
+      return this.open(origin,{type:'approval',sessionId:agent.id,toolName:req.toolName,reason:req.reason??'',signal:req.signal});
+    }));
+    disposers.push(agent.ctx.on('user-questions/request',async(req,next)=>{
+      if(req.agent!==agent)return next();const origin=await this.service.activeOrigin(agent.id);if(!origin)return next();
+      const questions=req.questions.map(q=>({...q,...q.intent?.kind==='approval'?{options:q.options.filter(o=>o.label!==q.intent.always)}:{}}));
+      return this.open(origin,{type:'question',sessionId:agent.id,questions,callId:req.wait?.callId,signal:req.signal,agent});
+    }));
+    return()=>{for(const dispose of disposers.reverse())dispose();};
+  }
+  open(input,request){
+    const s=this.service,id=randomBytes(10).toString('hex'),expires=Date.now()+600000;
+    const row={id,...originOf(input),sessionId:request.sessionId,type:request.type,questions:request.questions,callId:request.callId,state:'open',expires};
+    if(request.signal?.aborted)return request.type==='approval'?Promise.resolve('cancelled'):Promise.reject(Error('ASK_ABORTED'));
+    s.store.saveInteraction(row);
+    let text,buttons;
+    if(request.type==='approval'){
+      text=`审批 · ${request.toolName}\n${request.reason}\n\n/answer ${id} allow\n/answer ${id} reject`;
+      buttons=[{label:'允许一次',data:`im:${id}:allow`},{label:'拒绝',data:`im:${id}:reject`}];
+    }else{
