diff --git a/desktop/app/identity-style/auth-liquid.css b/desktop/app/identity-style/auth-liquid.css
new file mode 100644
index 0000000..5cd7e6b
--- /dev/null
+++ b/desktop/app/identity-style/auth-liquid.css
@@ -0,0 +1,246 @@
+/* Auth-only Nimbus-inspired capsule surfaces. Text always stays outside optical layers. */
+.auth-smoke .auth-liquid-options {
+  position: relative;
+  isolation: isolate;
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  width: 238px;
+  max-width: 100%;
+  padding: 6px;
+  gap: 2px;
+  margin: 0 auto 28px;
+  border: 1px solid #ffffffb8;
+  border-radius: 999px;
+  background: #ffffff24;
+  -webkit-backdrop-filter: blur(10px) saturate(1.2) brightness(1.08);
+  backdrop-filter: blur(10px) saturate(1.2) brightness(1.08);
+  box-shadow:
+    inset 0 1px 1px #ffffffe6,
+    inset 0 -1px 1px #48647914,
+    0 12px 32px -14px #25465f40,
+    0 2px 6px #294f6b0a;
+  -webkit-tap-highlight-color: transparent;
+}
+.auth-liquid-layer {
+  position: absolute;
+  inset: 0;
+  border-radius: inherit;
+  pointer-events: none;
+  z-index: 0;
+  overflow: hidden;
+  clip-path: inset(0 round 999px);
+}
+.auth-liquid-water {
+  position: absolute;
+  left: -14px;
+  top: -14px;
+  pointer-events: none;
+}
+.auth-liquid-layer[data-gl="off"] .auth-liquid-water,
+.auth-liquid-layer[data-opaque="true"] .auth-liquid-water {
+  display: none;
+}
+.auth-liquid-drop {
+  display: block;
+  position: absolute;
+  top: 5px;
+  bottom: 5px;
+  left: 0;
+  width: var(--liquid-width, calc(50% - 7px));
+  transform: translateX(var(--liquid-left, 6px));
+  border-radius: 999px;
+  transition:
+    transform 0.55s cubic-bezier(0.2, 1.3, 0.3, 1),
+    width 0.4s;
+  background:
+    radial-gradient(120% 140% at 30% 0%, #ffffffbf, #ffffff00 55%), #ffffff61;
+  box-shadow:
+    inset 0 1px 1px #fffffff2,
+    inset 0 -2px 6px #00a2ff24,
+    inset 0 0 0 1px #ffffff8c,
+    0 6px 16px -6px #00468c38;
+}
+.auth-liquid-layer[data-gl="on"]:not([data-opaque="true"]) .auth-liquid-drop {
+  opacity: 0;
+}
+.auth-liquid-options[data-active="1"] .auth-liquid-layer {
+  --liquid-left: calc(50% + 1px);
+}
+.auth-smoke .auth-liquid-options .auth-option {
+  position: relative;
+  z-index: 1;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 8px;
+  height: 42px;
+  padding: 0 16px;
+  border-radius: 999px;
+  text-decoration: none;
+  color: #69716c;
+  font-size: 13px;
+  font-weight: 500;
+  line-height: 1;
+  transition: color 0.2s;
+}
+.auth-smoke .auth-liquid-options .auth-option[aria-current="page"],
+.auth-smoke .auth-liquid-options .auth-option:hover {
+  color: #152821;
+}
+.auth-option svg {
+  transition: transform 0.4s cubic-bezier(0.3, 1.6, 0.5, 1);
+}
+.auth-option:hover svg {
+  transform: translateY(-2px) scale(1.07);
+}
+.auth-option:active svg {
+  transform: scale(0.91);
+}
+.auth-smoke .auth-liquid-options .auth-option:focus-visible {
+  outline: 2px solid #55765f;
+  outline-offset: 1px;
+}
+.auth-option[aria-disabled="true"] {
+  cursor: wait;
+  opacity: 0.55;
+}
+.auth-smoke .smoke-form-box button.auth-liquid-submit[type="submit"] {
+  position: relative;
+  isolation: isolate;
+  overflow: visible;
+  border: 1px solid #ffffffbd;
+  border-radius: 999px;
+  min-height: 52px;
+  background: #dcebe759;
+  color: #17372e;
+  -webkit-backdrop-filter: blur(10px) saturate(1.2) brightness(1.08);
+  backdrop-filter: blur(10px) saturate(1.2) brightness(1.08);
+  box-shadow:
+    inset 0 1px 1px #ffffffed,
+    inset 0 -1px 2px #4f76621f,
+    0 8px 18px -12px #244d3e26;
+  transition:
+    box-shadow 0.2s,
+    background 0.2s;
+}
+.auth-smoke
+  .smoke-form-box
+  button.auth-liquid-submit[type="submit"]:hover:not(:disabled) {
+  background: #d3e8df73;
+  transform: none;
+  box-shadow:
+    inset 0 1px 1px #fff,
+    inset 0 -1px 2px #4f76621f,
+    0 10px 22px -12px #244d3e35;
+}
+.auth-smoke
+  .smoke-form-box
+  button.auth-liquid-submit[type="submit"]:active:not(:disabled) {
+  background: #cddfd880;
+}
+.auth-liquid-submit > .auth-liquid-label {
+  position: relative;
+  z-index: 1;
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  gap: 10px;
+}
+.auth-liquid-submit:disabled {
+  opacity: 0.55;
+  cursor: not-allowed;
+}
+.auth-smoke .smoke-form-box button.auth-password-toggle[type="button"] {
+  border: 1px solid #ffffffa6;
+  border-radius: 999px;
+  background: #ffffff35;
+  box-shadow:
+    inset 0 1px 1px #ffffffb3,
+    0 2px 6px #284d2b08;
+  min-width: 36px;
+  min-height: 36px;
+  width: 36px;
+  height: 36px;
+  padding: 0;
+  right: 6px;
+}
+.auth-smoke
+  .smoke-form-box
+  button.auth-password-toggle[type="button"]:hover:not(:disabled) {
+  background: #ffffff85;
+  box-shadow:
+    inset 0 1px 1px #fff,
+    0 3px 9px #284d2b12;
+}
+.auth-smoke .smoke-form-box:has(.auth-liquid-options) h2 {
+  margin-bottom: 28px;
+}
+@media (max-width: 360px) {
+  .auth-smoke .auth-liquid-options {
+    width: 100%;
+  }
+  .auth-smoke .auth-liquid-options .auth-option {
+    padding: 0 10px;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .auth-liquid-drop,
+  .auth-option svg {
+    transition: none;
+  }
+}
+@media (prefers-reduced-transparency: reduce) {
+  .auth-smoke .auth-liquid-options,
+  .auth-smoke .smoke-form-box button.auth-liquid-submit[type="submit"] {
+    background: #e8efeb;
+    -webkit-backdrop-filter: none;
+    backdrop-filter: none;
+  }
+  .auth-liquid-drop {
+    background: #f9fcfa;
+    box-shadow: inset 0 0 0 1px #bdcec3;
+  }
+}
+@supports not (backdrop-filter: blur(1px)) {
+  .auth-smoke .auth-liquid-options,
+  .auth-smoke .smoke-form-box button.auth-liquid-submit[type="submit"] {
+    background: #e8efeb;
+  }
+}
+@media (forced-colors: active) {
+  .auth-liquid-layer {
+    display: none;
+  }
+  .auth-smoke .auth-liquid-options,
+  .auth-smoke .smoke-form-box button.auth-liquid-submit[type="submit"] {
+    background: ButtonFace;
+    color: ButtonText;
+    border: 1px solid ButtonText;
+  }
+  .auth-option[aria-current="page"] {
+    outline: 2px solid Highlight;
+  }
+}
+
+/* Persistent shell only: resize the form well, never replay a page-wide fade. */
+.auth-route-viewport {
+  transition: height 0.32s cubic-bezier(0.22, 1, 0.36, 1);
+  overflow: clip;
+}
+.auth-route-content {
+  display: flow-root;
+}
+.auth-route-content h2 {
+  margin-top: 0;
+}
+.auth-smoke .smoke-form-box:has(.auth-route-viewport) {
+  animation: none;
+}
+.auth-smoke .smoke-form-box:has(.auth-route-viewport) > .auth-liquid-options {
+  margin-bottom: 30px;
+}
+@media (prefers-reduced-motion: reduce) {
+  .auth-route-viewport {
+    transition: none;
+  }
+}
diff --git a/desktop/app/identity-style/auth-smoke.css b/desktop/app/identity-style/auth-smoke.css
new file mode 100644
index 0000000..c2b1a22
--- /dev/null
+++ b/desktop/app/identity-style/auth-smoke.css
@@ -0,0 +1,294 @@
+/* Full-bleed Smoke Login. Decoration stays behind the light credential surface. */
+.auth-page.auth-smoke {
+  --smoke-bg: #efede7;
+  --smoke-paper: #f7f6f2;
+  --smoke-sheet: #e6e3db;
+  --smoke-ink: #141513;
+  --smoke-muted: #6f716b;
+  --smoke-line: #dcd9d0;
+  --smoke-field: #fbfaf7;
+  display: grid;
+  grid-template-columns: minmax(0, 1fr);
+  place-items: center;
+  position: relative;
+  isolation: isolate;
+  min-height: 100dvh;
+  padding: 100px 24px 64px;
+  gap: 0;
+  background: var(--smoke-bg);
+  color: var(--smoke-ink);
+  overflow-x: clip;
+  color-scheme: light;
+}
+.smoke-backdrop {
+  position: fixed;
+  inset: 0;
+  z-index: 0;
+  overflow: hidden;
+  background: radial-gradient(
+    ellipse at 25% 30%,
+    #f5f4ef 10%,
+    #bec4b8 40%,
+    #71846b 68%,
+    #eeeae1 100%
+  );
+}
+.auth-smoke-canvas {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  opacity: 0;
+  transition: opacity 0.6s;
+}
+.auth-smoke-canvas[data-smoke="ready"] {
+  opacity: 1;
+}
+.smoke-grain {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+  background: url("auth-grain.svg");
+  opacity: 0.12;
+  mix-blend-mode: multiply;
+}
+.auth-smoke .smoke-brand {
+  position: absolute;
+  z-index: 3;
+  top: 28px;
+  left: 32px;
+  padding: 0;
+}
+.auth-smoke .smoke-brand .mg-brand-lockup {
+  width: 148px;
+  height: 50px;
+}
+.auth-smoke .smoke-form-panel {
+  padding: 0;
+  width: 100%;
+  position: relative;
+  z-index: 2;
+  isolation: isolate;
+}
+.auth-smoke .smoke-form-panel::before {
+  display: none;
+}
+.auth-smoke .smoke-form-box {
+  max-width: 448px;
+  padding: 44px;
+  border: 1px solid #ffffffa8;
+  border-radius: 24px;
+  background: #f7f6f2eb;
+  -webkit-backdrop-filter: blur(16px);
+  backdrop-filter: blur(16px);
+  box-shadow:
+    0 20px 70px -30px #1d2d2630,
+    inset 0 1px 0 #ffffffb3;
+  animation: smoke-enter 0.85s cubic-bezier(0.22, 1, 0.36, 1) both;
+}
+.auth-smoke .smoke-form-box::before {
+  display: none;
+}
+.auth-smoke .smoke-form-box h2 {
+  margin: 0 0 38px;
+  font-size: 34px;
+  line-height: 1.2;
+  font-weight: 600;
+  letter-spacing: -1.3px;
+  color: var(--smoke-ink);
+}
+.auth-smoke .auth-workspace {
+  color: var(--smoke-muted);
+  margin-bottom: 18px;
+  gap: 7px;
+}
+.auth-smoke .auth-workspace h1 {
+  font-size: 13px;
+}
+.auth-smoke .smoke-form-box form {
+  gap: 20px;
+}
+.auth-smoke .smoke-form-box label {
+  font-size: 13px;
+  font-weight: 500;
+  color: var(--smoke-ink);
+  gap: 8px;
+}
+.auth-smoke .auth-field {
+  gap: 8px;
+}
+.auth-smoke .smoke-form-box input,
+.auth-smoke .smoke-form-box select {
+  min-height: 48px;
+  padding: 12px 14px;
+  border-radius: 14px;
+  background: var(--smoke-field);
+  border: 1px solid var(--smoke-line);
