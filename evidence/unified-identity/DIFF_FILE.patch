+    transform: rotate(360deg);
+  }
+}
+@media (min-width: 1700px) {
+  .auth-page {
+    padding: 24px;
+    gap: 32px;
+  }
+  .auth-story {
+    padding: 36px 44px;
+  }
+  .auth-form-box {
+    max-width: 486px;
+    padding: 46px 48px 38px;
+  }
+  .auth-form-box h2 {
+    font-size: 31px;
+  }
+}
+@media (max-width: 1150px) and (min-width: 801px) {
+  .auth-page {
+    grid-template-columns: minmax(0, 1fr) minmax(350px, 1fr);
+    gap: 8px;
+    padding: 16px;
+  }
+  .auth-story {
+    padding: 26px;
+    min-height: 610px;
+  }
+  .auth-form-panel {
+    padding: 32px 20px;
+  }
+  .auth-form-box {
+    padding: 32px 28px 28px;
+  }
+  .auth-art-logo img {
+    width: 118px;
+  }
+}
+@media (max-width: 800px) {
+  .auth-page {
+    display: flex;
+    flex-direction: column;
+    gap: 0;
+    padding: 0;
+    min-height: 100dvh;
+    background:
+      radial-gradient(ellipse at 100% 0%, #e7eef2, transparent 60%), #f9faf9;
+  }
+  .auth-story {
+    min-height: 0;
+    height: auto;
+    display: block;
+    background: none;
+    padding: 28px 30px;
+    border: 0;
+    border-radius: 0;
+    overflow: visible;
+    box-shadow: none;
+  }
+  .auth-story::before,
+  .auth-story::after,
+  .auth-artwork {
+    display: none;
+  }
+  .auth-form-panel {
+    padding: 24px 28px 64px;
+    flex: 1;
+    align-items: center;
+  }
+  .auth-form-box {
+    max-width: 420px;
+    padding: 34px 30px 28px;
+  }
+  .auth-form-box h2 {
+    font-size: 28px;
+    margin-bottom: 32px;
+  }
+  .auth-brand .mg-brand-lockup {
+    transform: scale(0.94);
+    transform-origin: left center;
+  }
+}
+@media (max-width: 420px) {
+  .auth-story {
+    padding: 22px 26px;
+  }
+  .auth-form-panel {
+    padding: 14px 18px 40px;
+    align-items: flex-start;
+  }
+  .auth-form-box {
+    padding: 29px 25px 25px;
+  }
+  .auth-form-box h2 {
+    font-size: 25px;
+  }
+  .auth-form-box form {
+    gap: 21px;
+  }
+}
+@media (max-height: 650px) and (min-width: 801px) {
+  .auth-story {
+    min-height: 550px;
+  }
+  .auth-form-panel {
+    padding-top: 24px;
+    padding-bottom: 24px;
+  }
+  .auth-artwork {
+    max-width: 440px;
+  }
+}
+@supports not (
+  (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))
+) {
+  .auth-form-box {
+    background: #fdfdfc;
+  }
+  .auth-art-pane-front {
+    background: linear-gradient(135deg, #f0f5f6, #dce5e9);
+  }
+}
+@media (prefers-reduced-transparency: reduce) {
+  .auth-form-box {
+    background: #f8fbff;
+    -webkit-backdrop-filter: none;
+    backdrop-filter: none;
+  }
+  .auth-art-pane-front {
+    background: #eef5ff;
+    -webkit-backdrop-filter: none;
+    backdrop-filter: none;
+  }
+  .auth-refractive-layer {
+    display: none;
+  }
+}
+@media (prefers-reduced-motion: reduce), (pointer: coarse) {
+  .auth-art-stack {
+    transform: rotate(-9deg);
+    transition: none;
+  }
+  .auth-refractive-layer {
+    -webkit-backdrop-filter: none;
+    backdrop-filter: none;
+  }
+}
+@media (prefers-reduced-motion: reduce) {
+  .auth-page * {
+    transition: none !important;
+  }
+  .auth-page .spin {
+    animation: none;
+  }
+}
