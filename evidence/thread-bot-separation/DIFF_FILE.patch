+test('deployment protects original session frames and only accepts empty end-seed lifecycle appends',()=>{const dir=fs.mkdtempSync(path.join(os.tmpdir(),'naumi-prefix-')),file=path.join(dir,'session.v4.jsonl.zstd'),base=zstdCompressSync(Buffer.from('{"type":"user/message","data":{"text":"original"}}\n')),hash=createHash('sha256').update(base).digest('hex');try{fs.writeFileSync(file,base);assert.equal(verifyThreadProtectedFile(file,hash).kind,'exact');const append=row=>fs.writeFileSync(file,Buffer.concat([base,zstdCompressSync(Buffer.from(JSON.stringify(row)+'\n'))]));append({type:'session/end-seed',data:{}});const result=verifyThreadProtectedFile(file,hash);assert.equal(result.kind,'lifecycle-append');assert.equal(result.originalBytes,base.length);for(const row of[{type:'user/message',data:{text:'new'}},{type:'session/end-seed',data:{text:'changed'}}]){append(row);assert.throws(()=>verifyThreadProtectedFile(file,hash),/NON_LIFECYCLE_APPEND/);}fs.writeFileSync(file,zstdCompressSync(Buffer.from('{}\n')));assert.throws(()=>verifyThreadProtectedFile(file,hash),/PREFIX_CHANGED/);const config=path.join(dir,'config.json');fs.writeFileSync(config,'{}');assert.throws(()=>verifyThreadProtectedFile(config,hash),/NON_SESSION_DRIFT/);}finally{fs.rmSync(dir,{recursive:true,force:true});}});

