+import {z} from 'zod';
+const uuid=z.string().uuid(),limit=z.object({costMicros:z.number().int().min(0).max(1e12),tokens:z.number().int().min(0).max(1e12),requests:z.number().int().min(0).max(1e9),concurrent:z.number().int().min(1).max(64)}).strict();
+export const modelPolicy=z.object({active:z.boolean(),routes:z.array(z.string().regex(/^[a-z0-9][a-z0-9._-]{0,79}$/)).min(1).max(30).refine(v=>new Set(v).size===v.length),organization:limit,employee:limit,task:limit,maxAttempts:z.number().int().min(1).max(3),credentialSeconds:z.number().int().min(300).max(86400),enforceManaged:z.boolean(),allowFallback:z.boolean()}).strict();
+export const modelManagerCommands=[
+ z.object({action:z.literal('model.policy.sync'),operationId:uuid}).strict(),
+ z.object({action:z.literal('model.policy.set'),expectedRevision:z.number().int().nonnegative(),policy:modelPolicy,operationId:uuid}).strict(),
+ z.object({action:z.literal('model.resolve-unknown'),requestId:uuid,confirmedStopped:z.literal(true),reason:z.string().trim().min(6).max(1000),operationId:uuid}).strict(),
+] as const;
+export const modelDeviceCommands=[z.object({action:z.literal('model.authorize'),employeeId:uuid,taskId:uuid.nullable().default(null)}).strict()] as const;
diff --git a/modified/control/src/lib/digital-models.ts b/modified/control/src/lib/digital-models.ts
new file mode 100644
index 0000000..9d3d03c
--- /dev/null
+++ b/modified/control/src/lib/digital-models.ts
@@ -0,0 +1,25 @@
+import {randomUUID} from 'node:crypto';import type {PoolClient} from 'pg';import type {Actor} from './types';import {ApiError} from './errors';import {audit,requireTask,requireRole} from './domain-core';import {modelPolicy} from './digital-model-contract';import {signedAuthorization,type SigningConfig} from './digital-employee-contract';
+type Row=Record<string,any>;
+export function gatewayUrl(){const raw=process.env.NAUMI_MODEL_GATEWAY_URL;if(!raw)throw new ApiError(503,'模型网关尚未配置','MODEL_GATEWAY_NOT_CONFIGURED');let u;try{u=new URL(raw);}catch{throw new ApiError(503,'模型网关配置格式错误','MODEL_GATEWAY_CONFIG_INVALID');}if(u.username||u.password||u.pathname!=='/'||u.search||u.hash||u.protocol!=='https:'&&!(u.protocol==='http:'&&['127.0.0.1','localhost','[::1]'].includes(u.hostname)))throw new ApiError(503,'模型网关配置格式错误','MODEL_GATEWAY_CONFIG_INVALID');return u.origin;}
+const token=(config:SigningConfig,claims:Row)=>{const p=signedAuthorization(config,claims);return p.kid+'.'+p.payload+'.'+p.signature;};
+export async function readModelPolicy(c:PoolClient,a:Actor){const r=(await c.query('SELECT revision,policy,updated_at FROM digital_model_policies WHERE tenant_id=$1',[a.tenantId])).rows[0];return r?{...r.policy,revision:r.revision,updatedAt:r.updated_at}:null;}
+function adminProof(a:Actor,config:SigningConfig,body:Row){const now=Date.now();return {gateway:gatewayUrl(),proof:token(config,{aud:'naumi-model-admin',gateway:gatewayUrl(),tenantId:a.tenantId,memberId:a.id,jti:randomUUID(),issuedAt:new Date(now).toISOString(),expiresAt:new Date(now+300000).toISOString(),...body})};}
+export async function modelManager(c:PoolClient,a:Actor,p:Row,config:SigningConfig){
+ requireRole(a,'owner');
+ if(p.action==='model.policy.sync'){const policy=await readModelPolicy(c,a);if(!policy)throw new ApiError(404,'模型策略尚未配置','MODEL_POLICY_NOT_FOUND');const {updatedAt,...signedPolicy}=policy;await audit(c,a,p.action,'model-policy',a.tenantId,{revision:policy.revision});return {policy:signedPolicy,...adminProof(a,config,{action:'apply-policy',policy:signedPolicy})};}
+ if(p.action==='model.policy.set'){
+  await c.query('SELECT pg_advisory_xact_lock(hashtextextended($1,0))',[a.tenantId+':model-policy']);
+  const next=modelPolicy.parse(p.policy),old=(await c.query('SELECT * FROM digital_model_policies WHERE tenant_id=$1 FOR UPDATE',[a.tenantId])).rows[0];if((old?.revision??0)!==p.expectedRevision)throw new ApiError(409,'模型策略已更新','REVISION_CONFLICT');
+  const revision=(old?.revision??0)+1;await c.query('INSERT INTO digital_model_policies(tenant_id,revision,policy,updated_by) VALUES($1,$2,$3,$4) ON CONFLICT(tenant_id) DO UPDATE SET revision=excluded.revision,policy=excluded.policy,updated_by=excluded.updated_by,updated_at=now()',[a.tenantId,revision,JSON.stringify(next),a.id]);await audit(c,a,p.action,'model-policy',a.tenantId,{revision,policy:next});
+  return {policy:{...next,revision},...adminProof(a,config,{action:'apply-policy',policy:{...next,revision}})};
+ }
+ await audit(c,a,p.action,'model-request',p.requestId,{confirmedStopped:true,reason:p.reason});return adminProof(a,config,{action:'charge-ceiling',requestId:p.requestId,confirmedStopped:true,reason:p.reason});
+}
+export async function modelDevice(c:PoolClient,a:Actor,d:Row,p:Row,bindings:Array<{employeeId:string,localBotId:string}>,config:SigningConfig){
+ const binding=bindings.find(b=>b.employeeId===p.employeeId);if(!binding)throw new ApiError(403,'设备未关联此员工','DEVICE_BINDING_REQUIRED');
+ const policy=await readModelPolicy(c,a);if(!policy||!policy.active)throw new ApiError(403,'模型预算策略未启用','MODEL_POLICY_DISABLED');
+ if(p.taskId){await requireTask(c,a,p.taskId,false);if(!(await c.query('SELECT 1 FROM digital_work_links WHERE tenant_id=$1 AND task_id=$2 AND employee_id=$3 AND active',[a.tenantId,p.taskId,p.employeeId])).rowCount)throw new ApiError(403,'任务未关联此员工','WORK_EMPLOYEE_LINK_REQUIRED');}
+ const {updatedAt,...signedPolicy}=policy,now=Date.now(),date=new Date(now),end=Date.UTC(date.getUTCFullYear(),date.getUTCMonth()+1,1),expiresAt=new Date(Math.min(now+policy.credentialSeconds*1000,end)).toISOString();
+ const claims={aud:'naumi-model-gateway',gateway:gatewayUrl(),jti:randomUUID(),tenantId:a.tenantId,memberId:a.id,deviceId:d.id,employeeId:p.employeeId,botId:binding.localBotId,taskId:p.taskId,authEpoch:d.auth_epoch,period:new Date(now).toISOString().slice(0,7),issuedAt:new Date(now).toISOString(),expiresAt,policy:signedPolicy};
+ return {model:{gateway:claims.gateway,token:token(config,claims),expiresAt,policy:signedPolicy}};
+}
diff --git a/modified/gateway/scripts/start-model-gateway.ps1 b/modified/gateway/scripts/start-model-gateway.ps1
new file mode 100644
index 0000000..dad631c
--- /dev/null
+++ b/modified/gateway/scripts/start-model-gateway.ps1
@@ -0,0 +1,16 @@
+param([string]$RuntimeRoot='E:\Workspace\deepseek-harness-local',[string]$ConfigPath='')
+$ErrorActionPreference='Stop'
+$root=(Resolve-Path -LiteralPath $RuntimeRoot).Path
+if(!$ConfigPath){$ConfigPath=Join-Path $root '.dsh/model-gateway/config.json'}
+$config=Get-Content -Raw -LiteralPath $ConfigPath|ConvertFrom-Json
+$existing=Get-NetTCPConnection -LocalPort $config.port -State Listen -ErrorAction SilentlyContinue
+if($existing){$h=Invoke-RestMethod -Uri ($config.gateway+'/health') -TimeoutSec 5;if($h.product -ne 'naumi-model-gateway'){throw 'MODEL_PORT_CONFLICT'};Write-Output "GATEWAY ready=$($h.ready) routes=$($h.routes) existing=1";exit 0}
+$node=(Get-Command node -ErrorAction Stop).Source
+$log=Join-Path $root 'logs';New-Item -ItemType Directory -Path $log -Force|Out-Null
+$previous=$env:NAUMI_MODEL_GATEWAY_CONFIG
+try{
+ $env:NAUMI_MODEL_GATEWAY_CONFIG=(Resolve-Path -LiteralPath $ConfigPath).Path
+ $p=Start-Process -FilePath $node -ArgumentList @('services/model-gateway/main.mjs') -WorkingDirectory $root -WindowStyle Hidden -RedirectStandardOutput (Join-Path $log 'model-gateway.out.log') -RedirectStandardError (Join-Path $log 'model-gateway.err.log') -PassThru
+ for($i=0;$i -lt 40;$i++){Start-Sleep -Milliseconds 250;if($p.HasExited){throw 'MODEL_GATEWAY_START_FAILED'};try{$h=Invoke-RestMethod -Uri ($config.gateway+'/health') -TimeoutSec 2;if($h.product -eq 'naumi-model-gateway' -and $h.ready){Write-Output "GATEWAY ready=True routes=$($h.routes) pid=$($p.Id)";exit 0}}catch{}}
+ throw 'MODEL_GATEWAY_HEALTH_TIMEOUT'
+}finally{if($null -eq $previous){Remove-Item Env:\NAUMI_MODEL_GATEWAY_CONFIG -ErrorAction SilentlyContinue}else{$env:NAUMI_MODEL_GATEWAY_CONFIG=$previous}}
diff --git a/modified/gateway/services/model-gateway/contract.mjs b/modified/gateway/services/model-gateway/contract.mjs
new file mode 100644
index 0000000..e9a256b
--- /dev/null
+++ b/modified/gateway/services/model-gateway/contract.mjs
@@ -0,0 +1,18 @@
+import {z} from 'zod';import {createHash,verify} from 'node:crypto';
+export const canonical=v=>JSON.stringify(v,(_k,x)=>x&&typeof x==='object'&&!Array.isArray(x)?Object.fromEntries(Object.entries(x).sort(([a],[b])=>a.localeCompare(b))):x);
+export const digest=v=>createHash('sha256').update(canonical(v)).digest('hex');
+export function fault(code,status=400){const e=Error(code);e.status=status;return e;}
+const uuid=z.string().uuid(),limit=z.object({costMicros:z.number().int().min(0).max(1e12),tokens:z.number().int().min(0).max(1e12),requests:z.number().int().min(0).max(1e9),concurrent:z.number().int().min(1).max(64)}).strict();
+export const policySchema=z.object({revision:z.number().int().positive(),active:z.boolean(),routes:z.array(z.string().regex(/^[a-z0-9][a-z0-9._-]{0,79}$/)).min(1).max(30),organization:limit,employee:limit,task:limit,maxAttempts:z.number().int().min(1).max(3),credentialSeconds:z.number().int().min(300).max(86400),enforceManaged:z.boolean(),allowFallback:z.boolean()}).strict();
+export const grantSchema=z.object({v:z.literal(1),aud:z.literal('naumi-model-gateway'),iss:z.string(),gateway:z.string().url(),jti:uuid,tenantId:uuid,memberId:uuid,deviceId:uuid,employeeId:uuid,botId:z.string().min(1).max(200),taskId:uuid.nullable(),authEpoch:z.number().int().positive(),period:z.string().regex(/^\d{4}-\d{2}$/),issuedAt:z.string().datetime(),expiresAt:z.string().datetime(),policy:policySchema}).strict();
+export function verifyGrant(token,{keys,issuer,gateway,now=Date.now()}){
+ if(typeof token!=='string'||token.length>15000)throw fault('MODEL_TOKEN_INVALID',401);const [kid,payload,signature,...rest]=token.split('.');
+ try{if(rest.length||!keys[kid]||!verify(null,Buffer.from(payload),keys[kid],Buffer.from(signature,'base64url')))throw Error();}catch{throw fault('MODEL_TOKEN_SIGNATURE_INVALID',401);}
+ let c;try{c=grantSchema.parse(JSON.parse(Buffer.from(payload,'base64url').toString()));}catch{throw fault('MODEL_TOKEN_INVALID',401);}
+ if(c.iss!==issuer||c.gateway!==gateway)throw fault('MODEL_TOKEN_AUDIENCE_INVALID',401);
+ const start=Date.parse(c.issuedAt),end=Date.parse(c.expiresAt);if(now<start-60000||now>=end||end<=start||end-start>86400000||new Date(start).toISOString().slice(0,7)!==c.period||new Date(end-1).toISOString().slice(0,7)!==c.period)throw fault('MODEL_TOKEN_EXPIRED',401);
+ if(!c.policy.active)throw fault('MODEL_POLICY_DISABLED',403);return c;
+}
+export const cost=(input,output,route)=>Number((BigInt(input)*BigInt(route.inputMicrosPerMillion)+999999n)/1000000n+(BigInt(output)*BigInt(route.outputMicrosPerMillion)+999999n)/1000000n);
+export function scopes(c){return [{kind:'organization',id:c.tenantId,limit:c.policy.organization},{kind:'employee',id:c.employeeId,limit:c.policy.employee},{kind:'bot',id:c.botId,limit:c.policy.employee},...(c.taskId?[{kind:'task',id:c.taskId,limit:c.policy.task}]:[])];}
+export const routeSchema=z.object({id:z.string().regex(/^[a-z0-9][a-z0-9._-]{0,79}$/),name:z.string().max(120),url:z.string().url(),model:z.string().min(1).max(200),keyEnv:z.string().regex(/^[A-Z][A-Z0-9_]+$/),contextTokens:z.number().int().min(128).max(2000000),maxOutputTokens:z.number().int().min(1).max(1000000),inputMicrosPerMillion:z.number().int().min(0).max(1e9),outputMicrosPerMillion:z.number().int().min(0).max(1e9),vision:z.boolean().default(false),fallbacks:z.array(z.string()).max(2).default([])}).strict();
diff --git a/modified/gateway/services/model-gateway/ledger.mjs b/modified/gateway/services/model-gateway/ledger.mjs
new file mode 100644
index 0000000..f5d63bf
--- /dev/null
+++ b/modified/gateway/services/model-gateway/ledger.mjs
@@ -0,0 +1,62 @@
+import fs from 'node:fs';import path from 'node:path';import {DatabaseSync} from 'node:sqlite';import {canonical,digest,cost,scopes,fault} from './contract.mjs';
+/** Gateway-authoritative, single-ledger reservations. No prompt, result text or credentials are stored. */
+export class ModelLedger{
+ constructor(file,{clock=()=>Date.now()}={}){this.clock=clock;if(file!==':memory:')fs.mkdirSync(path.dirname(file),{recursive:true});this.db=new DatabaseSync(file);
+ const application=this.db.prepare('PRAGMA application_id').get().application_id,version=this.db.prepare('PRAGMA user_version').get().user_version;
+ if((application!==0&&application!==0x4e4d4731)||version>1){this.db.close();throw fault('MODEL_LEDGER_VERSION_UNSUPPORTED',503);}
+ if(application===0&&this.db.prepare("SELECT name FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%'").all().length){this.db.close();throw fault('MODEL_LEDGER_IDENTITY_INVALID',503);}
+ this.db.exec(`PRAGMA application_id=1313687345;PRAGMA user_version=1;PRAGMA busy_timeout=5000;PRAGMA journal_mode=WAL;PRAGMA synchronous=FULL;
+ CREATE TABLE IF NOT EXISTS metadata(key TEXT PRIMARY KEY,value INTEGER NOT NULL);
+ CREATE TABLE IF NOT EXISTS policies(tenant TEXT PRIMARY KEY,revision INTEGER NOT NULL,hash TEXT NOT NULL);
+ CREATE TABLE IF NOT EXISTS epochs(tenant TEXT,device TEXT,epoch INTEGER NOT NULL,PRIMARY KEY(tenant,device));
+ CREATE TABLE IF NOT EXISTS accounts(tenant TEXT,period TEXT,kind TEXT,id TEXT,spent_cost INTEGER NOT NULL DEFAULT 0,reserved_cost INTEGER NOT NULL DEFAULT 0,spent_tokens INTEGER NOT NULL DEFAULT 0,reserved_tokens INTEGER NOT NULL DEFAULT 0,requests INTEGER NOT NULL DEFAULT 0,PRIMARY KEY(tenant,period,kind,id));
+ CREATE TABLE IF NOT EXISTS requests(id TEXT PRIMARY KEY,tenant TEXT NOT NULL,period TEXT NOT NULL,employee TEXT NOT NULL,bot TEXT NOT NULL,device TEXT NOT NULL,task TEXT,hash TEXT NOT NULL,state TEXT NOT NULL,route TEXT NOT NULL,price TEXT NOT NULL,scope TEXT NOT NULL,reserved_cost INTEGER NOT NULL,reserved_tokens INTEGER NOT NULL,attempts INTEGER NOT NULL DEFAULT 0,input_tokens INTEGER,output_tokens INTEGER,charged_cost INTEGER,created_at TEXT NOT NULL,updated_at TEXT NOT NULL,error TEXT);
+ CREATE INDEX IF NOT EXISTS active_requests ON requests(tenant,period,state);
+ CREATE TABLE IF NOT EXISTS audits(seq INTEGER PRIMARY KEY AUTOINCREMENT,request_id TEXT,action TEXT NOT NULL,detail TEXT NOT NULL,at TEXT NOT NULL);`);
+ this.db.exec('CREATE TABLE IF NOT EXISTS admin_operations(jti TEXT PRIMARY KEY,hash TEXT NOT NULL,result TEXT NOT NULL)');
+ if(this.db.prepare('PRAGMA quick_check').get().quick_check!=='ok')throw fault('MODEL_LEDGER_CORRUPT',503);
+ this.transaction(()=>{for(const r of this.db.prepare("SELECT id FROM requests WHERE state IN ('reserved','dispatched')").all()){this.db.prepare("UPDATE requests SET state='unknown',error='GATEWAY_PROCESS_INTERRUPTED',updated_at=? WHERE id=?").run(this.now(),r.id);this.audit(r.id,'restart_unknown',{});}});
+ }
