+  const active=value.active?.[id];if(!active||!value.access?.[active.apiKeyEnv]||value.initial?.refs?.[p.apiKeyEnv]!==value.access[active.apiKeyEnv])throw Error('TRIAL_INPUT_INTEGRITY');
