+  !else
+    !insertmacro NaumiLabel 248 112 524 44 "卸载完成" 22 600
+    !insertmacro NaumiLabel 248 196 524 28 "个人数据已保留" 10 400
+  !endif
+  !insertmacro NaumiButton 612 388 160 44 "完成" action-done ${PREFIX}NaumiNext
+  nsDialogs::Show
