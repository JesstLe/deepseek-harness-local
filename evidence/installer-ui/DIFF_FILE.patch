+  System::Call 'user32::LoadImageW(p 0, w "$PLUGINSDIR\naumi-rail.bmp", i 0, i $R6, i $R7, i 0x10) p .r0'
+  SendMessage $2 ${STM_SETIMAGE} 0 $0
