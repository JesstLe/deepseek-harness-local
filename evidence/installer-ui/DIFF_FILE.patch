+Function ${PREFIX}NaumiProgressShow
+  SetAutoClose true
+  SetDetailsPrint none
+  !insertmacro NaumiWindowSize
+  !insertmacro NaumiScale 0 0 820 520
+  System::Call 'user32::SetWindowPos(p $mui.InstFilesPage, p 0, i 0, i 0, i $R6, i $R7, i 4)'
