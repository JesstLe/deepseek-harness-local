diff --git a/modified/services/desktop-cloud/server.mjs b/modified/services/desktop-cloud/server.mjs
new file mode 100644
index 0000000..fcffe25
--- /dev/null
+++ b/modified/services/desktop-cloud/server.mjs
@@ -0,0 +1,19 @@
+import http from 'node:http';
+import path from 'node:path';
+import {pathToFileURL} from 'node:url';
+import {CloudStore,MAX_BODY} from './store.mjs';
+import {MarketStore} from '../../market/store.mjs';
+import {marketServer,canvasAuthentication} from '../../market/server.mjs';
+
+const PREFIX='/api/desktop-cloud/v1';
+export function cloudServer({store,authenticate,publicOrigin}){return http.createServer(async(req,res)=>{
+ const send=(status,value)=>{res.writeHead(status,{'Content-Type':'application/json; charset=utf-8','Cache-Control':'private, no-store','X-Content-Type-Options':'nosniff'});res.end(JSON.stringify(value));};
+ try{const u=new URL(req.url,'http://localhost');if(u.pathname==='/api/desktop-cloud/health')return send(200,{product:'Naumi Desktop Cloud',protocol:1});if(!u.pathname.startsWith(PREFIX+'/'))return send(404,{error:'NOT_FOUND'});if(!['GET','POST'].includes(req.method))return send(405,{error:'CLOUD_METHOD'});if(req.method==='POST'&&(req.headers['x-naumi-market']!=='1'||req.headers.origin&&req.headers.origin!==(publicOrigin??'http://'+req.headers.host)))return send(403,{error:'CLOUD_SAME_ORIGIN_REQUIRED'});
+  const actor=await authenticate(req),endpoint=u.pathname.slice(PREFIX.length);
+  if(req.method==='GET'){if(endpoint==='/me')return send(200,{user:{id:actor.id,name:actor.name},usage:store.usage(actor),protocol:1});if(endpoint==='/documents')return send(200,store.list(actor,{kind:u.searchParams.get('kind')??'',offset:Number(u.searchParams.get('offset')??0)}));const doc=endpoint.match(/^\/documents\/([-a-z]+)\/([-a-zA-Z0-9_.]{1,128})$/);if(doc)return send(200,store.get(actor,doc[1],doc[2],u.searchParams.has('revision')?Number(u.searchParams.get('revision')):undefined));const chunk=endpoint.match(/^\/chunks\/([a-f0-9]{64})$/);if(chunk)return send(200,store.chunk(actor,chunk[1]));return send(404,{error:'NOT_FOUND'});}
+  const chunks=[];let size=0;for await(const c of req){size+=c.length;if(size>MAX_BODY)return send(413,{error:'CLOUD_REQUEST_TOO_LARGE'});chunks.push(c);}let input;try{input=JSON.parse(Buffer.concat(chunks));}catch{return send(400,{error:'CLOUD_INVALID_JSON'});}if(endpoint==='/documents')return send(200,store.put(actor,input));if(endpoint==='/chunks')return send(200,store.putChunk(actor,input));return send(404,{error:'NOT_FOUND'});
+ }catch(e){if(!res.headersSent)send(e.status??500,{error:/^(?:CLOUD|MARKET)_[A-Z_]+$/.test(e.message)?e.message:'CLOUD_UNAVAILABLE'});}
+ });}
+if(process.argv[1]&&import.meta.url===pathToFileURL(path.resolve(process.argv[1])).href){
+ const origin=process.env.NAUMI_MARKET_AUTH_ORIGIN;if(!origin)throw Error('AUTH_ORIGIN_REQUIRED');const publicOrigin=process.env.NAUMI_MARKET_PUBLIC_ORIGIN,authenticate=canvasAuthentication({origin,tenant:process.env.NAUMI_MARKET_TENANT??'naumi',moderators:(process.env.NAUMI_MARKET_MODERATORS??'').split(',').filter(Boolean)}),home=path.resolve(process.env.NAUMI_CLOUD_DATA??'/data'),store=new CloudStore(path.join(home,'cloud.sqlite')),market=new MarketStore(path.join(home,'market.sqlite')),cloud=cloudServer({store,authenticate,publicOrigin}),marketHTTP=marketServer({store:market,authenticate,publicOrigin}),server=http.createServer((req,res)=>(req.url.startsWith('/api/plugin-market/')?marketHTTP:cloud).emit('request',req,res));server.requestTimeout=30000;server.headersTimeout=10000;server.listen(Number(process.env.PORT??3190),process.env.HOST??'127.0.0.1',()=>console.log('NAUMI_CLOUD_READY protocol=1'));const stop=()=>{server.closeAllConnections();server.close(()=>{store.close();market.close();process.exit(0);});};process.on('SIGTERM',stop);process.on('SIGINT',stop);
+}
diff --git a/modified/services/desktop-cloud/store.mjs b/modified/services/desktop-cloud/store.mjs
new file mode 100644
index 0000000..7d994e3
--- /dev/null
+++ b/modified/services/desktop-cloud/store.mjs
@@ -0,0 +1,35 @@
+import fs from 'node:fs';
+import path from 'node:path';
+import {DatabaseSync} from 'node:sqlite';
+import {createHash} from 'node:crypto';
+import {exact,uuid,fail} from '../../plugins/naumi-enterprise/market-contract.js';
+
+export const hash=value=>createHash('sha256').update(typeof value==='string'||Buffer.isBuffer(value)?value:JSON.stringify(value)).digest('hex');
+export const MAX_BODY=2*1024*1024;
+const kinds=new Set(['workspace','bot','profile','memory','conversation','settings','file-manifest']);
+export function identity(kind,id){if(!kinds.has(kind)||typeof id!=='string'||!/^[-a-zA-Z0-9_.]{1,128}$/.test(id)||id==='.'||id==='..')fail('CLOUD_INVALID_DOCUMENT');}
+export function publicPayload(value){
+ let count=0;
+ function walk(v,depth){if(++count>20000||depth>24)fail('CLOUD_PAYLOAD_TOO_COMPLEX');if(v&&typeof v==='object'){for(const [k,x]of Object.entries(v)){if(/^(?:__proto__|prototype|constructor|api.?key|access.?token|refresh.?token|password|cookie|authorization|private.?key|credentials)$/i.test(k))fail('CLOUD_PRIVATE_FIELD');walk(x,depth+1);}}else if(typeof v==='string'&&/-----BEGIN (?:[A-Z ]+ )?PRIVATE KEY-----|\bsk-[A-Za-z0-9_-]{24,}\b/.test(v))fail('CLOUD_PRIVATE_CONTENT');}
+ if(!value||typeof value!=='object'||Array.isArray(value))fail('CLOUD_INVALID_PAYLOAD');walk(value,0);const raw=JSON.stringify(value);if(Buffer.byteLength(raw)>1024*1024)fail('CLOUD_PAYLOAD_TOO_LARGE',413);return raw;
+}
+export class CloudStore{
+ constructor(file,{quota=128*1024*1024}={}){fs.mkdirSync(path.dirname(file),{recursive:true});this.quota=quota;this.db=new DatabaseSync(file);const v=this.db.prepare('PRAGMA user_version').get().user_version;if(![0,1].includes(v))throw Error('CLOUD_SCHEMA_UNSUPPORTED');this.db.exec(`PRAGMA journal_mode=WAL;PRAGMA busy_timeout=5000;
+ CREATE TABLE IF NOT EXISTS documents(owner TEXT,kind TEXT,id TEXT,revision INTEGER NOT NULL,digest TEXT NOT NULL,body TEXT NOT NULL,deleted INTEGER NOT NULL,updated_at TEXT NOT NULL,PRIMARY KEY(owner,kind,id));
+ CREATE TABLE IF NOT EXISTS versions(owner TEXT,kind TEXT,id TEXT,revision INTEGER,digest TEXT NOT NULL,body TEXT NOT NULL,deleted INTEGER NOT NULL,updated_at TEXT NOT NULL,PRIMARY KEY(owner,kind,id,revision));
+ CREATE TABLE IF NOT EXISTS operations(owner TEXT,operation TEXT,fingerprint TEXT NOT NULL,result TEXT NOT NULL,PRIMARY KEY(owner,operation));
+ CREATE TABLE IF NOT EXISTS chunks(owner TEXT,digest TEXT,bytes BLOB NOT NULL,created_at TEXT NOT NULL,PRIMARY KEY(owner,digest));
+ PRAGMA user_version=1;`);}
+ owner(actor){if(!actor?.id||typeof actor.id!=='string')fail('CLOUD_AUTH_REQUIRED',401);return actor.id;}
+ transaction(fn){this.db.exec('BEGIN IMMEDIATE');try{const result=fn();this.db.exec('COMMIT');return result;}catch(e){this.db.exec('ROLLBACK');throw e;}}
+ usage(actor){const owner=this.owner(actor);return{used:this.db.prepare('SELECT coalesce(sum(length(CAST(body AS BLOB))),0) n FROM versions WHERE owner=?').get(owner).n+this.db.prepare('SELECT coalesce(sum(length(bytes)),0) n FROM chunks WHERE owner=?').get(owner).n,limit:this.quota};}
+ mutate(actor,input,fn){const owner=this.owner(actor);uuid(input.operationId);return this.transaction(()=>{const fingerprint=hash(input),prior=this.db.prepare('SELECT * FROM operations WHERE owner=? AND operation=?').get(owner,input.operationId);if(prior){if(prior.fingerprint!==fingerprint)fail('CLOUD_OPERATION_CONFLICT',409);return JSON.parse(prior.result);}const result=fn(owner);if(this.usage(actor).used>this.quota)fail('CLOUD_QUOTA_EXCEEDED',413);this.db.prepare('INSERT INTO operations VALUES(?,?,?,?)').run(owner,input.operationId,fingerprint,JSON.stringify(result));return result;});}
+ list(actor,{kind='',offset=0}={}){if(kind&&!kinds.has(kind)||!Number.isInteger(offset)||offset<0)fail('CLOUD_INVALID_QUERY');const owner=this.owner(actor),rows=this.db.prepare('SELECT kind,id,revision,digest,deleted,updated_at FROM documents WHERE owner=? AND (?=\'\' OR kind=?) ORDER BY kind,id LIMIT 101 OFFSET ?').all(owner,kind,kind,offset);return{items:rows.slice(0,100),next:rows.length>100?offset+100:null,usage:this.usage(actor)};}
+ get(actor,kind,id,revision){identity(kind,id);const owner=this.owner(actor);if(revision!==undefined&&(!Number.isInteger(revision)||revision<1))fail('CLOUD_INVALID_REVISION');const r=revision===undefined?this.db.prepare('SELECT * FROM documents WHERE owner=? AND kind=? AND id=?').get(owner,kind,id):this.db.prepare('SELECT * FROM versions WHERE owner=? AND kind=? AND id=? AND revision=?').get(owner,kind,id,revision);if(!r)fail('CLOUD_NOT_FOUND',404);const {owner:_,body,...meta}=r;return{...meta,payload:JSON.parse(body)};}
+ put(actor,input){exact(input,['operationId','kind','id','expectedRevision','payload','deleted']);identity(input.kind,input.id);if(!Number.isInteger(input.expectedRevision)||input.expectedRevision<0||input.deleted!==undefined&&typeof input.deleted!=='boolean')fail('CLOUD_INVALID_REVISION');const body=publicPayload(input.payload);return this.mutate(actor,input,owner=>{const old=this.db.prepare('SELECT revision FROM documents WHERE owner=? AND kind=? AND id=?').get(owner,input.kind,input.id);if((old?.revision??0)!==input.expectedRevision)fail('CLOUD_REVISION_CONFLICT',409);
+  if(input.kind==='file-manifest'&&!input.deleted){if(!Array.isArray(input.payload.files)||input.payload.files.length>100)fail('CLOUD_INVALID_MANIFEST');const names=new Set();for(const f of input.payload.files){exact(f,['path','chunks']);if(typeof f.path!=='string'||!f.path||f.path.length>240||f.path.includes('\\')||f.path.startsWith('/')||f.path.split('/').some(p=>!p||p==='.'||p==='..'||/[<>:"|?*\x00-\x1f]/.test(p)||/[ .]$/.test(p))||/(?:^|\/)(?:\.env(?:\.|$)|\.git|\.dsh|node_modules|cookies|login data|local state)|\.(?:pem|pfx|key)$/i.test(f.path))fail('CLOUD_PRIVATE_PATH');if(names.has(f.path.toLowerCase()))fail('CLOUD_DUPLICATE_PATH');names.add(f.path.toLowerCase());if(!Array.isArray(f.chunks)||f.chunks.length>10000)fail('CLOUD_INVALID_MANIFEST');for(const digest of f.chunks)if(!/^[a-f0-9]{64}$/.test(digest)||!this.db.prepare('SELECT 1 FROM chunks WHERE owner=? AND digest=?').get(owner,digest))fail('CLOUD_CHUNK_NOT_FOUND',409);}}
+  const revision=(old?.revision??0)+1,digest=hash(body),updatedAt=new Date().toISOString(),deleted=Number(!!input.deleted);this.db.prepare('INSERT INTO documents VALUES(?,?,?,?,?,?,?,?) ON CONFLICT(owner,kind,id) DO UPDATE SET revision=excluded.revision,digest=excluded.digest,body=excluded.body,deleted=excluded.deleted,updated_at=excluded.updated_at').run(owner,input.kind,input.id,revision,digest,body,deleted,updatedAt);this.db.prepare('INSERT INTO versions VALUES(?,?,?,?,?,?,?,?)').run(owner,input.kind,input.id,revision,digest,body,deleted,updatedAt);this.db.prepare('DELETE FROM versions WHERE owner=? AND kind=? AND id=? AND revision<=?').run(owner,input.kind,input.id,revision-10);return{kind:input.kind,id:input.id,revision,digest,deleted,updatedAt};});}
+ putChunk(actor,input){exact(input,['operationId','digest','content']);if(typeof input.content!=='string'||input.content.length>1400000||!/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(input.content))fail('CLOUD_INVALID_CHUNK');const bytes=Buffer.from(input.content,'base64');if(!bytes.length||bytes.length>1024*1024||hash(bytes)!==input.digest)fail('CLOUD_CHUNK_INTEGRITY');if(/-----BEGIN (?:[A-Z ]+ )?PRIVATE KEY-----|\bsk-[A-Za-z0-9_-]{24,}\b/.test(bytes.toString('utf8')))fail('CLOUD_PRIVATE_CONTENT');return this.mutate(actor,input,owner=>{this.db.prepare('INSERT INTO chunks VALUES(?,?,?,?) ON CONFLICT(owner,digest) DO NOTHING').run(owner,input.digest,bytes,new Date().toISOString());return{digest:input.digest,bytes:bytes.length};});}
+ chunk(actor,digest){if(!/^[a-f0-9]{64}$/.test(digest))fail('CLOUD_INVALID_CHUNK');const r=this.db.prepare('SELECT bytes FROM chunks WHERE owner=? AND digest=?').get(this.owner(actor),digest);if(!r)fail('CLOUD_NOT_FOUND',404);return{digest,content:Buffer.from(r.bytes).toString('base64')};}
+ close(){this.db.close();}
+}
