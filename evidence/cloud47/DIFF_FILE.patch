+import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';import {randomUUID} from 'node:crypto';import {createRequire} from 'node:module';
+import {CloudStore,hash} from '../services/desktop-cloud/store.mjs';import {cloudServer} from '../services/desktop-cloud/server.mjs';
+const require=createRequire(import.meta.url),{CloudSession,CloudBackup,validateCloud}=require('../desktop/app/cloud.cjs');
+const alice={id:'alice',name:'Alice'},bob={id:'bob',name:'Bob'};
+function fixture(t,options){const root=fs.mkdtempSync(path.join(os.tmpdir(),'naumi-cloud-')),store=new CloudStore(path.join(root,'cloud.sqlite'),options);t.after(()=>{store.close();fs.rmSync(root,{recursive:true,force:true});});return{root,store};}
+const put=(payload={name:'Employee'})=>({operationId:randomUUID(),kind:'bot',id:'one',expectedRevision:0,payload});
+test('cloud documents persist by authenticated account, not caller owner fields',t=>{const {store}=fixture(t),first=put();const r=store.put(alice,first);assert.equal(r.revision,1);assert.deepEqual(store.get(alice,'bot','one').payload,first.payload);assert.equal(store.list(bob).items.length,0);assert.throws(()=>store.get(bob,'bot','one'),{status:404});assert.throws(()=>store.put(bob,{...put(),owner:'alice'}));});
+test('cloud CAS and durable idempotent receipt reject stale or different retry payload',t=>{const {store,root}=fixture(t),input=put(),one=store.put(alice,input);assert.deepEqual(store.put(alice,input),one);assert.throws(()=>store.put(alice,{...input,payload:{name:'Changed'}}),{status:409});assert.throws(()=>store.put(alice,{...put(),expectedRevision:0}),/REVISION_CONFLICT/);const second=new CloudStore(path.join(root,'cloud.sqlite'));try{assert.deepEqual(second.put(alice,input),one);}finally{second.close();}});
+test('cloud history preserves ten versions and deletion is an explicit revisioned tombstone',t=>{const {store}=fixture(t);for(let n=0;n<12;n++)store.put(alice,{...put({n}),expectedRevision:n});assert.throws(()=>store.get(alice,'bot','one',1),{status:404});assert.equal(store.get(alice,'bot','one',3).payload.n,2);store.put(alice,{...put({}),expectedRevision:12,deleted:true});assert.equal(store.get(alice,'bot','one').deleted,1);assert.equal(store.get(alice,'bot','one',12).payload.n,11);assert.throws(()=>store.put(alice,put()),/REVISION_CONFLICT/);});
+test('cloud chunk transfer is content verified and account isolated; manifest cannot reference another owner',t=>{const {store}=fixture(t),bytes=Buffer.from('employee workspace document'),digest=hash(bytes),input={operationId:randomUUID(),digest,content:bytes.toString('base64')};store.putChunk(alice,input);assert.equal(Buffer.from(store.chunk(alice,digest).content,'base64').toString(),bytes.toString());assert.throws(()=>store.chunk(bob,digest),{status:404});const doc={...put({files:[{path:'docs/report.md',chunks:[digest]}]}),kind:'file-manifest'};assert.throws(()=>store.put(bob,doc),/CHUNK_NOT_FOUND/);store.put(alice,doc);assert.throws(()=>store.putChunk(alice,{...input,operationId:randomUUID(),digest:'0'.repeat(64)}),/INTEGRITY/);});
