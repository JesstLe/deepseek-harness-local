+.nim-settings textarea{height:auto;min-height:91px;resize:vertical;line-height:1.65}
+.nim-form-divider{height:1px;background:#f0f3f7;margin:23px 0 2px}
+.nim-secret{position:relative;display:block}
+.nim-secret input{padding-right:45px;display:block}
+.nim-secret>.nim-icon-button{position:absolute;right:5px;top:5px}
+.nim-region{border:0;min-width:0;margin-top:19px!important}
+.nim-region legend{margin-bottom:8px}
+.nim-segments{display:inline-flex;padding:3px;background:#f0f3f8;border:1px solid #e9eef5;border-radius:9px;gap:3px}
+.nim-segments label{position:relative;display:inline-flex;align-items:center;justify-content:center;padding:5px 28px;min-height:29px;font-size:12px;color:#9aa4b4;cursor:pointer;border-radius:6px;font-weight:550}
+.nim-segments label[data-selected=true]{background:#fff;color:#4f6386;box-shadow:0 1px 4px #2c3e5c0d}
+.nim-settings .nim-segments input{position:absolute;opacity:0;width:1px;height:1px;margin:0;min-height:0;padding:0;border:0}
+.nim-segments label:has(input:focus-visible){outline:3px solid #adc7ff;outline-offset:2px}
+.nim-segments label:has(input:disabled){cursor:default}
+.nim-form-footer{display:flex;justify-content:flex-end;align-items:center;gap:8px;padding:14px 25px;border-top:1px solid var(--nim-line);background:#fcfdff}
+.nim-form-footer .nim-primary{min-width:76px}
+.nim-pair{margin-top:18px;padding:21px 23px 18px}
+.nim-steps{display:flex;align-items:center;list-style:none;gap:25px;margin:25px 0 4px;padding:0}
+.nim-steps li{display:flex;align-items:center;gap:7px;color:#7e8da4;font-size:11px;position:relative}
+.nim-steps li:first-child:after{content:'';height:1px;width:14px;background:#dfe6f1;position:absolute;right:-19px;top:10px}
+.nim-steps li>span{display:grid;place-items:center;width:19px;height:19px;border-radius:50%;background:#f0f3f9;color:#adb8ca;font-size:10px;font-weight:600}
+.nim-steps li[data-active=true],.nim-steps li[data-complete=true]{color:#627fab}
+.nim-steps li[data-active=true]>span,.nim-steps li[data-complete=true]>span{color:#5b83d6;background:#eaf1ff}
+.nim-pair-fields{display:grid;grid-template-columns:1fr 1.7fr;gap:15px}
+.nim-pair-footer{justify-content:flex-end;margin-top:19px}
+.nim-code{margin-top:22px;padding:15px 16px;border:1px solid #e1eafb;border-radius:10px;background:#f7faff}
+.nim-code-heading{display:flex;align-items:center;justify-content:space-between;gap:12px;font-size:11px}
+.nim-code-heading strong{font-weight:500;color:#7388ab}
+.nim-code-heading>span{display:flex;align-items:center;gap:4px;color:#9caac1;font-size:10px;white-space:nowrap}
+.nim-code-value{display:flex;align-items:center;gap:8px;margin-top:13px}
+.nim-code-value code{flex:1;min-width:0;color:#45679f;font:12px/1.7 ui-monospace,SFMono-Regular,Consolas,monospace;overflow-wrap:anywhere;user-select:all}
+.nim-code[data-expired=true]{background:#fafbfc;border-color:#edf0f5}
+.nim-code[data-expired=true] code{color:#a9b2c0}
+/* Bound conversations are rows, not another competing grid of primary actions. */
+.nim-section-title{display:flex;align-items:center;margin:29px 0 13px}
+.nim-section-title h3{font-size:12px;font-weight:600;color:#8c98ad;letter-spacing:0}
+.nim-binding{margin-bottom:11px}
+.nim-binding-main{display:flex;align-items:center;gap:12px;padding:17px 19px}
+.nim-binding-identity{flex:1;min-width:0}
+.nim-binding-identity>strong{display:block;font-size:13px;font-weight:550;overflow-wrap:anywhere;color:#52627b}
+.nim-binding-route{display:flex;align-items:center;gap:5px;margin-top:4px;font-size:11px;color:#78889f;flex-wrap:wrap}
+.nim-binding-footer{display:flex;align-items:center;justify-content:space-between;padding:5px 12px;border-top:1px solid #f0f3f7}
+.nim-binding-footer button{font-size:11px;min-height:31px}
+.nim-settings .nim-unbind{color:#a4adbd}
+.nim-settings .nim-danger{color:#c16b5c;background:#fff6f4;border-color:#fae5e1}
+.nim-members-form{padding:0 20px 18px;border-top:1px solid #f0f3f7}
+.nim-members-form>.nim-actions{justify-content:flex-end;margin-top:13px}
+.nim-receipt{display:flex;align-items:center;justify-content:space-between;gap:13px;margin-bottom:10px;padding:15px 17px;border-color:#f0e9dc;background:#fffdfa;flex-wrap:wrap}
+.nim-receipt-summary{display:flex;align-items:center;gap:11px;min-width:0}
+.nim-receipt-icon{display:grid;place-items:center;flex:none;width:31px;height:31px;color:#bc9c66;background:#fbf4e6;border-radius:9px}
+.nim-receipt-summary strong{font-size:12px;font-weight:550;color:#8a785a}
+.nim-receipt-target{display:block;font-size:11px;color:#b6ab98;margin-top:2px;overflow-wrap:anywhere}
+.nim-settings .nim-receipt-button{border-color:#eee5d6;color:#a18a66;background:#fff;font-size:11px}
+.nim-reconcile{width:100%;justify-content:flex-end;border-top:1px solid #f0e9dc;padding-top:12px;margin-top:2px;gap:5px}
+.nim-reconcile button{font-size:11px;padding:6px 9px}
+.nim-error,.nim-notice{display:flex;align-items:center;gap:9px;padding:12px 14px;border-radius:9px;margin-bottom:18px;background:#fff3f0;color:#b36b5b;font-size:12px}
