+import fs from 'node:fs';import path from 'node:path';import {fail} from './market-contract.js';
+export class DesktopMarketTransport{
+ constructor({home=process.env.DSH_HOME,fetcher=fetch}={}){this.home=home;this.fetcher=fetcher;}
+ descriptor(){try{if(!this.home)return null;const file=path.join(this.home,'naumi-desktop-bridge.json');if(fs.lstatSync(file).isSymbolicLink())fail('MARKET_BRIDGE_INVALID');const value=JSON.parse(fs.readFileSync(file));if(!value.market)return null;if(value.version!==1||!Number.isInteger(value.port)||value.port<1||value.port>65535||!/^[a-f0-9]{64}$/.test(value.token)||value.market.protocolVersion!==1)fail('MARKET_BRIDGE_INVALID');return value;}catch(e){if(e.code==='ENOENT')return null;throw e;}}
