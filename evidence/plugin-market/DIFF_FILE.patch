@@ -0,0 +1,33 @@
+import fs from 'node:fs';import path from 'node:path';import {DatabaseSync} from 'node:sqlite';import {randomUUID} from 'node:crypto';
+import {validatePackage,packageMetadata,digest,exact,text,slug,version,uuid,fail} from '../plugins/naumi-enterprise/market-contract.js';
+export class MarketStore{
+ constructor(file){fs.mkdirSync(path.dirname(file),{recursive:true});this.db=new DatabaseSync(file);this.db.exec(`PRAGMA foreign_keys=ON;PRAGMA journal_mode=WAL;PRAGMA busy_timeout=5000;
+ CREATE TABLE IF NOT EXISTS accounts(id TEXT PRIMARY KEY,tenant TEXT NOT NULL,name TEXT NOT NULL);
+ CREATE TABLE IF NOT EXISTS packages(id TEXT PRIMARY KEY,tenant TEXT NOT NULL,slug TEXT NOT NULL,author TEXT NOT NULL REFERENCES accounts(id),visibility TEXT NOT NULL,created_at TEXT NOT NULL,UNIQUE(tenant,slug));
+ CREATE TABLE IF NOT EXISTS versions(package_id TEXT NOT NULL REFERENCES packages(id),version TEXT NOT NULL,digest TEXT NOT NULL,metadata TEXT NOT NULL,body TEXT NOT NULL,published_at TEXT NOT NULL,PRIMARY KEY(package_id,version));
+ CREATE TABLE IF NOT EXISTS drafts(id TEXT PRIMARY KEY,tenant TEXT NOT NULL,author TEXT NOT NULL REFERENCES accounts(id),revision INTEGER NOT NULL,body TEXT NOT NULL,updated_at TEXT NOT NULL);
+ CREATE TABLE IF NOT EXISTS operations(actor TEXT NOT NULL,operation_id TEXT NOT NULL,fingerprint TEXT NOT NULL,result TEXT NOT NULL,PRIMARY KEY(actor,operation_id));
+ CREATE TABLE IF NOT EXISTS downloads(id TEXT PRIMARY KEY,tenant TEXT NOT NULL,actor TEXT NOT NULL,package_id TEXT NOT NULL REFERENCES packages(id),version TEXT NOT NULL,served INTEGER NOT NULL DEFAULT 0,created_at TEXT NOT NULL);
+ CREATE TABLE IF NOT EXISTS installs(tenant TEXT NOT NULL,actor TEXT NOT NULL,package_id TEXT NOT NULL REFERENCES packages(id),version TEXT NOT NULL,updated_at TEXT NOT NULL,PRIMARY KEY(tenant,actor,package_id));
+ CREATE TABLE IF NOT EXISTS feedback(tenant TEXT NOT NULL,actor TEXT NOT NULL,package_id TEXT NOT NULL REFERENCES packages(id),favorite INTEGER NOT NULL DEFAULT 0,rating INTEGER,comment TEXT NOT NULL DEFAULT '',updated_at TEXT NOT NULL,PRIMARY KEY(tenant,actor,package_id));
+ PRAGMA user_version=1;`);}
+ transaction(fn){this.db.exec('BEGIN IMMEDIATE');try{const value=fn();this.db.exec('COMMIT');return value;}catch(e){this.db.exec('ROLLBACK');throw e;}}
+ account(actor){if(!actor?.id||!actor.tenant)fail('MARKET_AUTH_REQUIRED',401);this.db.prepare('INSERT INTO accounts VALUES(?,?,?) ON CONFLICT(id) DO UPDATE SET name=excluded.name').run(actor.id,actor.tenant,text(actor.name,160));}
+ mutate(actor,operationId,input,fn){uuid(operationId);this.account(actor);return this.transaction(()=>{const fingerprint=digest(input),prior=this.db.prepare('SELECT * FROM operations WHERE actor=? AND operation_id=?').get(actor.id,operationId);if(prior){if(prior.fingerprint!==fingerprint)fail('MARKET_OPERATION_CONFLICT',409);return JSON.parse(prior.result);}const result=fn();this.db.prepare('INSERT INTO operations VALUES(?,?,?,?)').run(actor.id,operationId,fingerprint,JSON.stringify(result));return result;});}
+ package(actor,id,{owner=false,hidden=false}={}){const row=this.db.prepare('SELECT * FROM packages WHERE id=? AND tenant=?').get(id,actor.tenant);if(!row)fail('MARKET_NOT_FOUND',404);if(owner&&row.author!==actor.id&&!actor.moderator)fail('MARKET_AUTHOR_REQUIRED',403);if(row.visibility!=='published'&&row.author!==actor.id&&!actor.moderator&&!hidden)fail('MARKET_NOT_FOUND',404);return row;}
+ stats(id){const db=this.db;return{downloads:db.prepare('SELECT count(*) AS n FROM downloads WHERE package_id=? AND served=1').get(id).n,installUsers:db.prepare('SELECT count(*) AS n FROM installs WHERE package_id=?').get(id).n,favorites:db.prepare('SELECT count(*) AS n FROM feedback WHERE package_id=? AND favorite=1').get(id).n,rating:db.prepare('SELECT avg(rating) AS mean,count(rating) AS count FROM feedback WHERE package_id=?').get(id)};}
+ detail(actor,id){const row=this.package(actor,id),versions=this.db.prepare('SELECT version,digest,metadata,published_at FROM versions WHERE package_id=?').all(id).sort((a,b)=>{const aa=a.version.split('.').map(Number),bb=b.version.split('.').map(Number);return bb[0]-aa[0]||bb[1]-aa[1]||bb[2]-aa[2];});
+  const reviews=this.db.prepare("SELECT f.rating,f.comment,f.updated_at,a.id AS authorId,a.name AS authorName FROM feedback f JOIN accounts a ON f.actor=a.id WHERE f.package_id=? AND f.rating IS NOT NULL ORDER BY f.updated_at DESC LIMIT 30").all(id);
+  return{id:row.id,slug:row.slug,author:{id:row.author,name:this.db.prepare('SELECT name FROM accounts WHERE id=?').get(row.author).name},visibility:row.visibility,createdAt:row.created_at,...JSON.parse(versions[0].metadata),digest:versions[0].digest,versions:versions.map(v=>({version:v.version,digest:v.digest,publishedAt:v.published_at,changelog:JSON.parse(v.metadata).changelog,capabilities:JSON.parse(v.metadata).capabilities})),stats:this.stats(id),mine:row.author===actor.id,feedback:this.db.prepare('SELECT favorite,rating,comment FROM feedback WHERE actor=? AND package_id=?').get(actor.id,id)??null,reviews};
+ }
