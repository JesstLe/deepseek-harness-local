+import fs from 'node:fs';import os from 'node:os';import path from 'node:path';import test from 'node:test';import assert from 'node:assert/strict';
+import {planAlignment,applyAlignment,restoreAlignment,verifyAligned} from '../scripts/lib/service-alignment.mjs';
+function fixture(){const root=fs.mkdtempSync(path.join(os.tmpdir(),'naumi-service-align-')),source=path.join(root,'source'),target=path.join(root,'target'),backup=path.join(root,'backup');for(const d of[source,target])fs.mkdirSync(path.join(d,'assets'),{recursive:true});fs.writeFileSync(path.join(source,'product-version.js'),'export const PRODUCT_VERSION="0.3.9";\n');fs.writeFileSync(path.join(target,'product-version.js'),'export const PRODUCT_VERSION="0.3.7";\n');fs.writeFileSync(path.join(source,'host.js'),'new host');fs.writeFileSync(path.join(target,'host.js'),'old host');fs.writeFileSync(path.join(source,'new.js'),'new feature');fs.writeFileSync(path.join(target,'assets/bot-chat-model.js.queue-stop-before'),'retained inactive backup');return {root,source,target,backup};}
