+ const rb=spawnSync('D:/DEV/Git/bin/bash.exe',[path.join(out,'ROLLBACK.sh'),copy],{encoding:'utf8'});fs.writeFileSync(path.join(out,'ROLLBACK.log'),rb.stdout+rb.stderr);if(rb.status!==0)throw Error('ROLLBACK_FAILED '+rb.stdout+rb.stderr);console.log(rb.stdout.trim());
+ const args=['--test','desktop/tests/updates.test.cjs','desktop/tests/installer-maintenance.test.cjs','desktop/tests/installer-ui.test.cjs'],t=spawnSync(process.execPath,args,{cwd:copy,encoding:'utf8'});fs.writeFileSync(path.join(out,'ROLLBACK_TESTS.log'),t.stdout+t.stderr);if(t.status!==0)throw Error('ROLLBACK_TESTS_FAILED '+t.stdout);const tests=Number(t.stdout.match(/tests (\d+)/)?.[1]);console.log('ROLLBACK tests='+tests+' pass='+tests+' fail=0 exit=0');
