+NODE
+`);
+fs.writeFileSync(path.join(out,'DIFF_FILE.patch'),execFileSync('git',['diff',baseline,'--binary','--',...paths]));
+execFileSync('python',['-X','utf8','-c',"import json,zipfile,pathlib,hashlib; r=pathlib.Path('.');o=r/'evidence/daily-release-037';m=json.loads((o/'manifest.json').read_text());z=zipfile.ZipFile(o/'MODIFIED_FILE.zip','w',zipfile.ZIP_DEFLATED);[z.write(r/e['path'],e['path']) for e in m['entries']];z.close();z=zipfile.ZipFile(o/'MODIFIED_FILE.zip');assert z.testzip() is None;assert all(hashlib.sha256(z.read(e['path'])).hexdigest()==e['modified'] for e in m['entries']);print('ZIP entries='+str(len(z.namelist()))+' CRC=PASS hashes=PASS')"],{stdio:'inherit'});
+if(process.argv.includes('--rollback-test')){
+ const copy=path.join(root,'runtime/release-037-source-rollback-'+randomUUID());fs.mkdirSync(copy,{recursive:true});fs.writeFileSync(path.join(copy,'.naumi-release-037-rollback-copy'),'source-only');
+ for(const dir of ['plugins','tests','scripts','services','desktop/app','desktop/tests','desktop/scripts','desktop/installer'])fs.cpSync(path.join(root,dir),path.join(copy,dir),{recursive:true});
+ for(const file of ['package.json','desktop/package.json','Start-Naumi.ps1','Stop-Naumi.ps1','Start-NaumiDesktop.ps1',...paths]){fs.mkdirSync(path.dirname(path.join(copy,file)),{recursive:true});fs.copyFileSync(path.join(root,file),path.join(copy,file));}
