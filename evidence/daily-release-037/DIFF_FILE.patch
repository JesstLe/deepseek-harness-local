+const hash=b=>createHash('sha256').update(b).digest('hex'),manifest={baseline,branch:'codex/daily-release-037-20261118',changedFields:['desktop/package version0.3.7','lock root/package version0.3.7','PRODUCT_VERSION0.3.7','CHANGELOG0.3.7'],entries:[]};
