+import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';import vm from 'node:vm';import {createHash} from 'node:crypto';
+import {extendNativeSettings,installNativeSettings,nativeSettingsOriginal,SETTINGS_UPSTREAM_SHA} from '../scripts/native-settings-extension.mjs';
+import {installBlenderUI} from '../plugins/naumi-enterprise/assets/blender-settings.js';
+const file='node_modules/@deepseek-ai/dsh-client-ui-settings-general/lib/client.js',read=()=>{const p=fs.existsSync(file+'.naumi-original')?file+'.naumi-original':file;return nativeSettingsOriginal(fs.readFileSync(p,'utf8'));},sha=b=>createHash('sha256').update(b).digest('hex');
+test('settings patch is pinned, reversible, idempotent and rejects upstream drift',()=>{const s=read();assert.equal(sha(s),SETTINGS_UPSTREAM_SHA);const next=extendNativeSettings(s);assert.equal(extendNativeSettings(next),next);assert.notEqual(next,s);assert.throws(()=>extendNativeSettings(s+' '),/UPSTREAM_CHANGED/);assert.throws(()=>extendNativeSettings(next+' '),/UPSTREAM_CHANGED/);new vm.Script(next);assert.equal(next.replace(/\/\/ Naumi employee settings presentation v1[^\n]*\n            const rows = useSections\(\(s\) => s\)\.filter\(\(row\) => \["general", "models", "mcp"\]\.includes\(row.id\)\);/,'const rows = useSections((s) => s);').replace('children: null /* Employee settings has no configuration-file action. */','children: renderSlot("settings.action", {})'),s);});
