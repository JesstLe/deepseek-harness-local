+import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';import net from 'node:net';import {randomUUID,createHmac} from 'node:crypto';import {Readable} from 'node:stream';import {EventEmitter} from 'node:events';
+import {BlenderRuntime,loadBlenderConfig,discoverBlender,inspectBlender,blenderMcpConfig} from '../plugins/naumi-enterprise/blender-runtime.js';import {readBridge,requestBlender} from '../plugins/naumi-enterprise/blender-bridge/client.js';import {createBlenderHandler} from '../plugins/naumi-enterprise/blender.js';
+const temp=t=>{const dir=fs.mkdtempSync(path.join(os.tmpdir(),'naumi-blender-unit-'));t.after(()=>{assert(path.resolve(dir).startsWith(path.resolve(os.tmpdir())+path.sep));fs.rmSync(dir,{recursive:true,force:true});});return dir;};
+async function socketFixture(t,handler){const home=temp(t),token='a'.repeat(64),instanceId=randomUUID(),server=net.createServer(s=>{s.on('data',b=>{const e=JSON.parse(b.toString()),r=JSON.parse(e.payload);handler(s,r,{token,instanceId});});});await new Promise(r=>server.listen(0,'127.0.0.1',r));t.after(()=>new Promise(r=>server.close(r)));fs.writeFileSync(path.join(home,'active.json'),JSON.stringify({version:1,pid:process.pid,port:server.address().port,token,instanceId}));return home;}
+function answer(s,r,d,result,{badMac=false,wrongId=false}={}){const payload=JSON.stringify({id:wrongId?'wrong':r.id,instanceId:d.instanceId,status:'success',result});s.end(JSON.stringify({payload,mac:badMac?'0'.repeat(64):createHmac('sha256',d.token).update(payload).digest('hex')})+'\n');}
+
+test('MCP uses bundled Node/official SDK stdio, profile home and a stable namespace, never global uv/python or network bootstrap',()=>{const c=blenderMcpConfig('E:/fixture-home');assert.equal(c.command,process.execPath);assert.equal(c.serverName,'naumi_blender');assert.equal(c.transport,'stdio');assert(c.args[0].endsWith('server.mjs'));assert.equal(c.env.NAUMI_BLENDER_HOME,'E:/fixture-home');assert.equal(c.toolCallTimeoutMs,150000);assert.equal(c.failOnStartupError,false);assert.doesNotMatch(JSON.stringify(c),/uvx|npx|python\.exe/);});
+
+test('missing engine remains honest and does not spawn or create a second tool engine',async t=>{const home=temp(t),calls=[];const r=new BlenderRuntime({home,discover:async()=>[],spawnProcess:(...x)=>calls.push(x)});const s=await r.status();assert.equal(s.installed,false);assert.equal(s.bundledMcp,true);assert.equal(s.engineBundled,false);assert.equal(s.connected,false);await assert.rejects(r.start(),/BLENDER_NOT_INSTALLED/);assert.equal(calls.length,0);});
+
+test('path selection validates before CAS publication, serializes concurrent writes and preserves corrupt configs',async t=>{const home=temp(t),inspect=async p=>{if(p==='bad')throw Error('BLENDER_EXECUTABLE_INVALID');return {executable:p,version:'Blender 5.2.3 LTS'};},r=new BlenderRuntime({home,discover:async()=>[],inspect});assert.equal(loadBlenderConfig(home).revision,0);await assert.rejects(r.save('bad',0),/BLENDER_EXECUTABLE_INVALID/);assert.equal(loadBlenderConfig(home).revision,0);const results=await Promise.allSettled([r.save('a',0),r.save('b',0)]);assert.equal(results.filter(x=>x.status==='fulfilled').length,1);assert.equal(loadBlenderConfig(home).revision,1);fs.writeFileSync(path.join(home,'config.json'),'broken');await assert.rejects(r.status(),/BLENDER_CONFIG_INVALID/);assert.equal(fs.readFileSync(path.join(home,'config.json'),'utf8'),'broken');});
+
+test('discovery checks known installation roots and supplied paths, not shell interpolation',async t=>{const home=temp(t),root=path.join(home,'Blender Foundation','Blender 5.2');fs.mkdirSync(root,{recursive:true});const exe=path.join(root,'blender.exe');fs.writeFileSync(exe,'');const candidates=await discoverBlender({platform:'win32',env:{ProgramFiles:home,LOCALAPPDATA:home},inspect:async p=>({executable:p,version:'Blender 5.2.3 LTS'})});assert.equal(candidates.length,1);assert.equal(candidates[0].executable,exe);await assert.rejects(inspectBlender(path.join(home,'other.exe')),/BLENDER_EXECUTABLE_INVALID/);});
+
+test('authenticated loopback reply is scoped to exact request/instance, wrong MAC and identity fail closed',async t=>{for(const scenario of ['valid','mac','id']){const home=await socketFixture(t,(s,r,d)=>answer(s,r,d,{objects:3},{badMac:scenario==='mac',wrongId:scenario==='id'}));if(scenario==='valid')assert.deepEqual(await requestBlender(home,'get_scene_info'),{objects:3});else await assert.rejects(requestBlender(home,'get_scene_info'),scenario==='mac'?/BLENDER_REPLY_AUTH_FAILED/:/BLENDER_REPLY_IDENTITY/);}});
+
+test('lost/timeout reply is UNKNOWN and is never automatically re-executed',async t=>{let calls=0;const home=await socketFixture(t,(s)=>{calls++;setTimeout(()=>s.end(),70);});await assert.rejects(requestBlender(home,'execute_code',{code:'print(1)'},{timeoutMs:15}),/BLENDER_RESULT_UNKNOWN/);assert.equal(calls,1);});
+
+test('malformed descriptors never redirect the bridge to a remote host',async t=>{const home=temp(t);assert.equal(readBridge(home),null);fs.writeFileSync(path.join(home,'active.json'),JSON.stringify({version:1,host:'remote',port:9876,pid:1,token:'bad',instanceId:'x'}));assert.throws(()=>readBridge(home),/BLENDER_DESCRIPTOR_INVALID/);});
+
+test('an already-starting process is not launched twice and stale launch locks recover without killing a process',async t=>{const home=temp(t),engine={executable:'fixture',version:'Blender 5.2.3 LTS'};let calls=0;const r=new BlenderRuntime({home,discover:async()=>[engine],spawnProcess:()=>{calls++;return Object.assign(new EventEmitter(),{exitCode:1,unref(){}});}});fs.writeFileSync(path.join(home,'pending.json'),JSON.stringify({pid:process.pid}));await assert.rejects(r.start(),/BLENDER_START_PENDING/);assert.equal(calls,0);fs.unlinkSync(path.join(home,'pending.json'));fs.writeFileSync(path.join(home,'launch.lock'),JSON.stringify({pid:2147483647}));await assert.rejects(r.start(),/BLENDER_LAUNCH_FAILED/);assert.equal(calls,1);assert.equal(fs.existsSync(path.join(home,'launch.lock')),false);});
+
+test('status excludes authentication secrets; an active session prevents engine path replacement',async t=>{const home=await socketFixture(t,(s,r,d)=>answer(s,r,d,{name:'naumi-blender',protocol:1,pid:process.pid,blenderVersion:'5.2.3',token:'SHOULD_NOT_ESCAPE'}));const r=new BlenderRuntime({home,discover:async()=>[]});const status=await r.status();assert.equal(status.connected,true);assert.doesNotMatch(JSON.stringify(status),/SHOULD_NOT_ESCAPE|aaaaaaaaaaaaaaaa/);await assert.rejects(r.save(null,0),/BLENDER_DISCONNECT_REQUIRED/);});
+
+test('owner API is strict, bounded and same-origin; it does not accept headless flags or Python payloads',async()=>{
+ let principal='owner';const calls=[],scope={connection:{admit:()=>principal?{peer:{principal:{kind:principal}}}:{rejection:401}},tools:{definitions:()=>Array.from({length:6},(_,i)=>({name:'mcp__naumi_blender__tool'+i}))}},runtime={status:async()=>({installed:false,connected:false}),start:async()=>calls.push('start'),disconnect:async()=>calls.push('disconnect'),save:async(...a)=>calls.push(a)};const handler=createBlenderHandler(scope,runtime);
+ async function call(method='GET',body,headers={}){const req=Readable.from(body===undefined?[]:[Buffer.from(typeof body==='string'?body:JSON.stringify(body))]);Object.assign(req,{method,headers:{host:'localhost',...headers}});let status,value;const res={setHeader(){},writeHead(s){status=s;return this;},end(v){value=v;}};await handler(req,res);return {status,value:value&&JSON.parse(value)};}
+ assert.equal((await call()).value.toolCount,6);principal='guest';assert.equal((await call()).status,403);principal=null;assert.equal((await call()).status,401);principal='owner';assert.equal((await call('DELETE')).status,405);const headers={'x-naumi-blender':'1','content-type':'application/json',origin:'http://localhost'};
+ assert.equal((await call('POST',{action:'start'})).status,403);assert.equal((await call('POST',{action:'start'},{...headers,origin:'https://evil.invalid'})).status,403);assert.equal((await call('POST',{action:'start'},{'x-naumi-blender':'1'})).status,415);assert.equal((await call('POST','x'.repeat(8193),headers)).status,413);assert.equal((await call('POST',{action:'start',headless:true},headers)).status,400);assert.equal((await call('POST',{action:'start',code:'oops'},headers)).status,400);assert.equal(calls.length,0);assert.equal((await call('POST',{action:'start'},headers)).status,200);assert.deepEqual(calls,['start']);
+});
+
+test('bundle declares official SDK and all addon/skill assets without an engine, Python environment, telemetry or paid service',()=>{const p=JSON.parse(fs.readFileSync('plugins/naumi-enterprise/package.json'));assert.equal(p.peerDependencies['@modelcontextprotocol/server'],'2.2.0');for(const n of ['blender.js','blender-runtime.js','blender-bridge','blender-skills'])assert(p.files.includes(n));const source=fs.readFileSync('plugins/naumi-enterprise/blender-bridge/addon.py','utf8');assert.doesNotMatch(source,/import requests|import httpx|telemetry_consent|https?:\/\//);assert.match(source,/127\.0\.0\.1/);assert.match(source,/self\.persist\(\)\s*# durable/);assert.match(fs.readFileSync('plugins/naumi-enterprise/blender-bridge/server.mjs','utf8'),/destructiveHint:true/);assert.match(fs.readFileSync('plugins/naumi-enterprise/blender-skills/naumi-blender/SKILL.md','utf8'),/operation_status/);});
+
+test('a busy live Blender is never mistaken for an absent engine or launched a second time',async t=>{const home=await socketFixture(t,()=>{});let spawns=0;const r=new BlenderRuntime({home,discover:async()=>[],spawnProcess:()=>{spawns++;}});const state=await r.status();assert.equal(state.running,true);assert.equal(state.connected,false);assert.equal(state.unresponsive,true);await assert.rejects(r.start(),/BLENDER_BUSY/);assert.equal(spawns,0);});
