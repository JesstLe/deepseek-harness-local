+import assert from 'node:assert/strict';import fs from 'node:fs';import path from 'node:path';import os from 'node:os';import {randomUUID,createHash} from 'node:crypto';import {Context} from '@deepseek-ai/cordis';import * as mcpClient from '@deepseek-ai/dsh-mcp-client';
+import {BlenderRuntime,inspectBlender,blenderMcpConfig} from '../plugins/naumi-enterprise/blender-runtime.js';import {requestBlender} from '../plugins/naumi-enterprise/blender-bridge/client.js';
+const out=process.env.BLENDER_EVIDENCE??'E:/tmp/naumi-blender-evidence',home=fs.mkdtempSync(path.join(os.tmpdir(),'naumi-blender-test-')),executable=process.env.NAUMI_BLENDER_TEST_EXECUTABLE??'C:/Program Files/Blender Foundation/Blender 5.2/blender.exe';fs.mkdirSync(out,{recursive:true});
+const engine=await inspectBlender(executable),runtime=new BlenderRuntime({home,discover:async()=>[engine]}),ctx=new Context(),definitions=new Map(),checks=[];ctx.provide('tools');ctx.set('tools',{register(t){definitions.set(t.name,t);return()=>definitions.delete(t.name);}});const check=(name,value)=>{assert(value,name);checks.push(name);console.log('BLENDER_REAL_PASS '+name);};
+const invoke=async(name,args={})=>definitions.get('mcp__naumi_blender__'+name).execute(args,{signal:new AbortController().signal});const value=r=>JSON.parse(r.content.find(v=>v.type==='text').text);
+try{
+ check('installed_version_verified',/^Blender ([4-9]|[1-9][0-9]+)\./.test(engine.version));
+ check('initially_disconnected',!(await runtime.status()).connected);await runtime.start({headless:true});check('isolated_real_Blender_connected',(await runtime.status()).connected);
+ await ctx.plugin(mcpClient,{...blenderMcpConfig(home),failOnStartupError:true});check('native_Harness_MCP_six_tools',definitions.size===6);
+ check('status_separates_engine_and_MCP',value(await invoke('blender_status')).connected===true);
+ const before=value(await invoke('get_scene_info'));check('scene_read_via_native_MCP',before.objectCount>=3);
+ const requestId=randomUUID(),blend=path.join(home,'acceptance.blend'),code=`import bpy\nbpy.ops.mesh.primitive_uv_sphere_add(segments=16, ring_count=8, location=(0,0,1))\nbpy.context.object.name='NaumiMcpSmoke'\nbpy.ops.wm.save_as_mainfile(filepath=${JSON.stringify(blend.replaceAll('\\','/'))})\nprint('BLENDER_SMOKE_OBJECT=NaumiMcpSmoke')`;
+ const executed=value(await invoke('execute_blender_code',{requestId,code}));check('real_bpy_create_and_save',executed.state==='completed'&&fs.statSync(blend).size>0);
+ const repeated=value(await invoke('execute_blender_code',{requestId,code}));const after=value(await invoke('get_scene_info'));check('duplicate_UUID_no_second_execution',repeated.state==='completed'&&after.objectCount===before.objectCount+1);
+ check('exact_object_lookup',value(await invoke('get_object_info',{name:'NaumiMcpSmoke'})).name==='NaumiMcpSmoke');
+ await assert.rejects(invoke('execute_blender_code',{requestId,code:'print("changed")'}),/BLENDER_REQUEST_CONFLICT/);check('UUID_payload_conflict_rejected',true);
+ check('durable_receipt_completed',value(await invoke('operation_status',{requestId})).state==='completed');
+ const renderId=randomUUID(),preview=await invoke('render_preview',{requestId:renderId,width:320,height:240});const img=preview.content.find(v=>v.type==='image');check('real_PNG_returned_through_MCP',img?.mimeType==='image/png');fs.writeFileSync(path.join(out,'blender-real-preview.png'),Buffer.from(img.data,'base64'));
+ const cancelledId=randomUUID(),ac=new AbortController();const pending=requestBlender(home,'execute_code',{code:'import time\ntime.sleep(0.4)\nprint("ONCE_AFTER_TIMEOUT")'},{requestId:cancelledId,signal:ac.signal});setTimeout(()=>ac.abort(),150);await assert.rejects(pending,/BLENDER_RESULT_UNKNOWN/);await new Promise(r=>setTimeout(r,700));check('cancelled_wait_reconciles_without_replay',(await requestBlender(home,'operation_status',{requestId:cancelledId})).state==='completed');
+ const report={tier:'REAL '+engine.version+' isolated background process + real official MCP SDK and Harness MCP client, no model/provider calls',checks,engine:engine.version,objectsBefore:before.objectCount,objectsAfter:after.objectCount,blend:{path:blend,bytes:fs.statSync(blend).size,sha256:createHash('sha256').update(fs.readFileSync(blend)).digest('hex')}};fs.writeFileSync(path.join(out,'REAL_MCP.json'),JSON.stringify(report,null,2)+'\n');
+}finally{await ctx.fiber.dispose();check('native_tools_removed_on_dispose',definitions.size===0);try{await runtime.disconnect();}catch{}await runtime.close();const child=runtime.lastChild;if(child&&child.exitCode===null)await Promise.race([new Promise(r=>child.once('exit',r)),new Promise(r=>setTimeout(r,5000))]);if(child?.exitCode===null){child.kill();console.log('TEST_OWN_PROCESS_TERMINATED');}}
+console.log('BLENDER_REAL_COMPLETE checks='+checks.length+' model_calls=0 user_scenes=UNTOUCHED');
