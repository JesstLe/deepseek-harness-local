+  const source=fs.readFileSync('node_modules/@deepseek-ai/'+pkg+'/lib/client.js','utf8');
+  for(const match of source.matchAll(/const css(?:\$\d+)?\s*=\s*("(?:[^"\\]|\\.)*");/g)){
+    css+=JSON.parse(match[1])+'\n';blocks++;
+  }
+}
