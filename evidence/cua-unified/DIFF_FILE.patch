+test('modified old code, unrelated files and a different source plugin are not deleted',()=>{for(const scenario of['drift','unknown','plugin']){const f=fixture();try{if(scenario==='drift')f.write(f.target,retired[0],'user edit');if(scenario==='unknown')f.write(f.target,'custom.js','user code');if(scenario==='plugin')f.write(f.source,'package.json',JSON.stringify({name:'custom-plugin'}));const before=code.inventory(f.target);assert.throws(()=>code.planAlignment(f),/SERVICE_UNKNOWN_EXTRA/);assert.deepEqual(code.inventory(f.target),before);}finally{f.close();}}});
