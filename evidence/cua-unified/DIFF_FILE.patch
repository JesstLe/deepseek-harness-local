+function fixture(){const dir=fs.mkdtempSync(path.join(os.tmpdir(),'cua-retire-')),source=path.join(dir,'source'),target=path.join(dir,'target'),backup=path.join(dir,'backup');fs.mkdirSync(source);fs.mkdirSync(target);const write=(r,f,b)=>{fs.mkdirSync(path.dirname(path.join(r,f)),{recursive:true});fs.writeFileSync(path.join(r,f),b);};for(const r of[source,target]){write(r,'package.json',JSON.stringify({name:'@naumi/dsh-enterprise'}));write(r,'product-version.js','export const PRODUCT_VERSION="'+(r===source?'0.4.4':'0.4.3')+'";\n');write(r,'host.js',r===source?'new CUA host':'old desktop host');}for(const f of['cua.js','cua-runtime.js'])write(source,f,'CUA fixture');for(const f of retired)write(target,f,fs.readFileSync(path.join(old,f)));return{dir,source,target,backup,write,close:()=>fs.rmSync(dir,{recursive:true,force:true})};}
+test('fixed legacy files retire transactionally before version publication; original backup restores exact bytes',()=>{const f=fixture();try{const before=code.inventory(f.target),plan=code.planAlignment(f);assert.equal(plan.changes.filter(r=>r.modified===null).length,3);const order=[];code.applyAlignment(plan,f.backup,{beforeWrite:r=>order.push(r.file)});assert.equal(order.at(-1),'product-version.js');for(const file of retired)assert(!fs.existsSync(path.join(f.target,file)));assert.equal(code.planAlignment(f).changes.length,0);code.restoreAlignment(plan,f.backup);assert.deepEqual(code.inventory(f.target),before);}finally{f.close();}});
