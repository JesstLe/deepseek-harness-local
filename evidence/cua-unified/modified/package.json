{
  "name": "naumi-desktop",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./Start-Naumi.ps1",
    "stop": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./Stop-Naumi.ps1",
    "verify": "node scripts/verify-http.mjs",
    "naumi:build": "node scripts/build-naumi-layout.mjs && node scripts/build-naumi-browser.mjs",
    "naumi:sync": "node scripts/sync-naumi.mjs",
    "naumi:test": "node --test tests/naumi-enterprise.test.mjs",
    "naumi:install": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/setup-naumi.ps1",
    "desktop:status": "node scripts/cua.mjs status",
    "desktop:verify": "node scripts/verify-cua.mjs",
    "browser:status": "node scripts/ego-browser.mjs status",
    "browser:verify": "node scripts/verify-ego-browser.mjs",
    "browser:install": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/setup-ego-browser.ps1",
    "app:start": "pwsh -NoProfile -ExecutionPolicy Bypass -File Start-NaumiDesktop.ps1",
    "app:stage": "node scripts/build-naumi-browser.mjs && node desktop/scripts/prepare-runtime.mjs",
    "app:build": "npm --prefix desktop run build",
    "app:test": "node --test tests/*.test.mjs desktop/tests/*.test.cjs",
    "desktop:prepare": "node desktop/scripts/stage-cua.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "@modelcontextprotocol/server": "2.2.0",
    "@modelcontextprotocol/client": "2.2.0"
  },
  "allowScripts": {
    "@deepseek-ai/dsh-subprocess-local@0.2.2-rc.1": true,
    "koffi@3.1.1": true,
    "node-pty@1.2.0-beta.15": true,
    "@google/genai@2.21.0": true,
    "protobufjs@7.6.6": true
  },
  "devDependencies": {
    "acorn": "8.19.0"
  }
}
