+/** Short extractive titles: no model call, no external request, never rewrite user-pinned titles. */
+export function taskTitle(text,max=36){const clean=String(text??'').replace(/```[\s\S]*?```/g,' ').replace(/https?:\/\/\S+/g,' ').replace(/^\s*(?:请你|请帮我|帮我|请|麻烦你|麻烦)\s*/u,'').replace(/[#*_`>]/g,'').replace(/\s+/g,' ').trim();const first=clean.split(/[。！？!?\n]/u)[0].trim();const chars=[...(first||clean||'未命名任务')];return chars.length>max?chars.slice(0,max-1).join('')+'…':chars.join('');}
+export const genericTitle=value=>!value||/^(?:新任务|新会话|New (?:task|session)|Untitled)$/i.test(value.trim());
+export function displaySessionTitle(stored,fallback){const title=stored?.events?.findLast(e=>e.type==='session/title')?.data;if(title?.source?.kind==='user')return title.title;if(title&&!genericTitle(title.title)&&title.source?.kind!=='fallback')return title.title;return taskTitle(fallback??stored?.events?.find(e=>e.type==='user/message'&&e.data.source?.kind==='user')?.data.content?.filter(p=>p.type==='text').map(p=>p.text).join(' '));}
+export function installBotTitles(ctx,directory,service){return ctx.on('session/event',(session,event)=>{if(event.type!=='user/message'||!directory.forSession(session.id))return;const current=session.snapshotEvents().findLast(e=>e.type==='session/title')?.data;if(current?.source?.kind==='user'||current&&!genericTitle(current.title))return;const task=service.store.read().tasks.find(t=>t.targetSessionId===session.id);if(!task&&event.data.source?.kind!=='user')return;const text=task?.task??event.data.content?.filter(p=>p.type==='text').map(p=>p.text).join(' ');if(text?.trim())session.append('session/title',{title:taskTitle(text),messageSeqs:[event.seq],source:{kind:'fallback'}});});}
