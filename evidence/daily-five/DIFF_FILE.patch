+import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import path from 'node:path';import {randomUUID} from 'node:crypto';import {botTaskHost} from './helpers/bot-task-host.mjs';import {BotTaskStore} from '../plugins/naumi-enterprise/bot-task-store.js';import {previewAddress} from '../plugins/naumi-enterprise/bot-deliverables.js';
+async function completeFile(f,task,file,text){fs.writeFileSync(file,text);await f.complete(task,'成果：`'+file+'`',async(a,t)=>{const callId=randomUUID();a.session.append('tool/call',{turn:t,step:1,callId,name:'write',arguments:{path:file}});a.session.append('tool/result',{turn:t,message:{role:'tool',toolCallId:callId,toolName:'write',content:[{type:'text',text:'OK'}],isError:false}},{surfaceOp:'append'});});return f.service.current(task.id);}
+test('real native task publication captures binary bytes, old version survives edits and history persists',async()=>{const f=await botTaskHost();try{const task=await f.service.dispatch(f.sender,{targetBotId:f.targetBot.id,task:'交付并修改文件',output:'files',idempotencyKey:randomUUID()});await f.service.settled();const file=path.join(f.dir,'成果.bin'),v1=await completeFile(f,task,file,Buffer.from([0,1,2,255]));assert.equal(v1.delivery.status,'ready');const ref=v1.delivery.files[0];assert(ref.snapshot);assert.deepEqual(fs.readFileSync(ref.snapshot.path),Buffer.from([0,1,2,255]));fs.writeFileSync(file,'changed');assert(previewAddress(ref).includes('.naumi-deliveries'));await f.service.runtime.verifyVersion(ref);const next=await f.service.continue(f.sender,{taskId:task.id,expectedRevision:v1.revision,message:'修改第二版',idempotencyKey:randomUUID()});await f.service.settled();const v2=await completeFile(f,next,file,'第二版');assert.equal(v2.id,task.id);assert.equal(v2.deliveryHistory.length,1);assert.equal(v2.deliveryHistory[0].files[0].snapshot.sha256,ref.snapshot.sha256);assert.deepEqual(fs.readFileSync(ref.snapshot.path),Buffer.from([0,1,2,255]));assert.notEqual(v2.delivery.files[0].snapshot.sha256,ref.snapshot.sha256);const reopened=new BotTaskStore(f.store.file);assert.equal(reopened.read().tasks.find(t=>t.id===task.id).deliveryHistory[0].files[0].snapshot.sha256,ref.snapshot.sha256);await reopened.close();}finally{await f.cleanup();}});
+
+test('version.json filenames do not collide with metadata; owner verification rejects tampering and forged coordinates',async()=>{const f=await botTaskHost();try{const task=await f.service.dispatch(f.sender,{targetBotId:f.targetBot.id,task:'交付JSON',output:'files',idempotencyKey:randomUUID()});await f.service.settled();const done=await completeFile(f,task,path.join(f.dir,'version.json'),'original'),ref=done.delivery.files[0];assert.equal(fs.readFileSync(ref.snapshot.path,'utf8'),'original');const url='/naumi/bot-file-version?'+new URLSearchParams({taskId:task.id,sessionId:ref.sessionId,seq:String(ref.seq),index:String(ref.index)});assert.equal((await f.request(null,{url})).status,200);assert.equal((await f.request(null,{url,cookie:'fixture-guest'})).status,403);assert.equal((await f.request(null,{url:url.replace('seq='+ref.seq,'seq=99999')})).status,409);await assert.rejects(f.service.runtime.verifyVersion({...ref,snapshot:{...ref.snapshot,path:ref.path}}),/REFERENCE/);fs.chmodSync(ref.snapshot.path,0o600);fs.writeFileSync(ref.snapshot.path,'tampered');assert.equal((await f.request(null,{url})).status,409);}finally{await f.cleanup();}});
+
+test('repeated publication and cross-workspace handoff use saved bytes after original deletion',async()=>{const f=await botTaskHost();try{const task=await f.service.dispatch(f.sender,{targetBotId:f.targetBot.id,task:'交付二进制',output:'files',idempotencyKey:randomUUID()});await f.service.settled();const file=path.join(f.dir,'source.bin'),done=await completeFile(f,task,file,Buffer.from([5,0,255])),ref=done.delivery.files[0];fs.unlinkSync(file);const again=await f.service.runtime.publishTurn(task.targetSessionId,ref.turn);assert.equal(again[0].snapshot.sha256,ref.snapshot.sha256);const receiver=path.join(f.dir,'receiver');fs.mkdirSync(receiver);const receiverId='snapshot-receiver';await f.service.runtime.ensure(receiverId,{create:true,cwd:receiver,profile:await f.service.runtime.profile(f.sourceBot)});const copies=await f.service.runtime.verifyHandoff(receiverId,[ref]);assert.equal(copies.length,1);assert.deepEqual(fs.readFileSync(copies[0].path),Buffer.from([5,0,255]));assert(copies[0].path.startsWith(receiver+path.sep));assert.equal((await f.service.runtime.verifyHandoff(receiverId,[ref]))[0].path,copies[0].path);}finally{await f.cleanup();}});
