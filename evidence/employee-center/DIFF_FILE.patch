+  bot(botId,write=false){const bot=this.directory.list().bots.find(b=>b.id===botId);if(!bot)throw Error('WORK_BOT_NOT_FOUND');if(write&&bot.status!=='active')throw Error('WORK_BOT_ARCHIVED');return bot;}
