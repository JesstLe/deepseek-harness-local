+const read=p=>fs.readFileSync(p,'utf8');
+function fixture(){return {host:"import {PRODUCT_VERSION} from './product-version.js';\nfunction apply(){\n  const assets=new Map();\n  assets.set('product-copy-keys.js','text/javascript');\n  const config={productVersion:PRODUCT_VERSION};\n  const css='<link rel=\"stylesheet\" href=\"/naumi/assets/style.css\">';\n  installBots(ctx);\n}",client:'function installNaumiContextUI(ctx,React,createPortal,Icon){\n  installOriginalFeatures(ctx);\n}',productVersion:'export const PRODUCT_VERSION="0.3.2";\n',sourceClient:read('plugins/naumi-enterprise/client.js'),sourceUI:read('plugins/naumi-enterprise/assets/desktop-updates.js'),sourceCSS:read('plugins/naumi-enterprise/assets/desktop-updates.css'),version:'0.3.7'};}
+test('baseline reproduces the linked legacy backend version and missing update hook',()=>{const f=fixture();assert(!f.client.includes('desktop-updates.js'));assert(f.productVersion.includes('0.3.2'));});
+test('repair changes only five presentation/version files and reuses native component byte-for-byte',()=>{const f=fixture(),p=planUpdateEntry(f);assert.equal(p.size,5);assert.equal(p.get('assets/desktop-updates.js'),f.sourceUI);assert.equal(p.get('assets/desktop-updates.css'),f.sourceCSS);assert(p.get('host.js').includes('installBots(ctx)'));assert(p.get('client.js').includes('installOriginalFeatures(ctx)'));assert(p.get('client.js').includes('installDesktopUpdatesUI(ctx,React,createPortal)'));assert.equal(p.get('product-version.js'),'export const PRODUCT_VERSION="0.3.7";\n');});
+test('reapplying the plan is idempotent, without duplicate slot hooks/routes/css',()=>{const f=fixture(),p=planUpdateEntry(f),again=planUpdateEntry({...f,host:p.get('host.js'),client:p.get('client.js'),productVersion:p.get('product-version.js')});assert.deepEqual([...again],[...p]);assert.equal(p.get('host.js').split("assets.set('desktop-updates.js'").length,2);assert.equal(p.get('client.js').split("import('/naumi/assets/desktop-updates.js')").length,2);});
+test('unrecognized host, duplicate insertion anchors or missing native slot fail before apply',()=>{const f=fixture();assert.throws(()=>planUpdateEntry({...f,host:f.host.replace('productVersion:PRODUCT_VERSION','x:1')}),/CONTRACT_MISSING/);assert.throws(()=>planUpdateEntry({...f,client:f.client+f.client}),/ANCHOR_CHANGED/);assert.throws(()=>planUpdateEntry({...f,sourceUI:'custom fake UI'}),/NATIVE_SLOT_REQUIRED/);assert.throws(()=>planUpdateEntry({...f,version:'0.3.7; arbitrary'}));});
+test('existing other slots, routes and business text remain unchanged',()=>{const f=fixture();f.client+='\n// User business text and existing dialogs stay.';f.host+='\ninstallSessionImport(ctx);';const p=planUpdateEntry(f);assert(p.get('client.js').endsWith('// User business text and existing dialogs stay.'));assert(p.get('host.js').endsWith('installSessionImport(ctx);'));});
+test('inventory hashes regular files and rejects directory indirection',()=>{const dir=fs.mkdtempSync(path.join(os.tmpdir(),'naumi-update-repair-'));try{fs.mkdirSync(path.join(dir,'assets'));fs.writeFileSync(path.join(dir,'assets/file'),'original');assert.equal(Object.keys(inventory(dir)).length,1);fs.symlinkSync(path.join(dir,'assets'),path.join(dir,'linked'),'junction');assert.throws(()=>inventory(dir),/LINKED_PLUGIN/);fs.unlinkSync(path.join(dir,'linked'));}finally{fs.rmSync(dir,{recursive:true,force:true});}});

