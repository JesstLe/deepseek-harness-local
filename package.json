{
  "name": "deepseek-harness-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./Start-DeepSeek.ps1",
    "stop": "pwsh -NoProfile -ExecutionPolicy Bypass -File ./Stop-DeepSeek.ps1",
    "verify": "node scripts/verify-http.mjs",
    "naumi:build": "node scripts/build-naumi-layout.mjs",
    "naumi:sync": "node scripts/sync-naumi.mjs",
    "naumi:test": "node --test tests/naumi-enterprise.test.mjs",
    "naumi:install": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/setup-naumi.ps1",
    "desktop:status": "node scripts/agent-desktop.mjs status",
    "desktop:verify": "node scripts/verify-agent-desktop.mjs",
    "browser:status": "node scripts/ego-browser.mjs status",
    "browser:verify": "node scripts/verify-ego-browser.mjs",
    "browser:install": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/setup-ego-browser.ps1"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.2.2-rc.1",
    "agent-desktop": "1.3.1"
  },
  "allowScripts": {
    "@deepseek-ai/dsh-subprocess-local@0.2.2-rc.1": true,
    "koffi@3.1.1": true,
    "node-pty@1.2.0-beta.15": true,
    "@google/genai@2.21.0": true,
    "protobufjs@7.6.6": true
  }
}
