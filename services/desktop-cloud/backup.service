[Unit]
Description=Naumi Desktop Cloud consistent SQLite backup

[Service]
Type=oneshot
UMask=0077
ExecStart=/usr/bin/python3 /opt/naumi-desktop-cloud/current/scripts/backup-cloud47.py
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/naumi-desktop-cloud/data /opt/naumi-desktop-cloud/backups /opt/naumi-desktop-cloud
