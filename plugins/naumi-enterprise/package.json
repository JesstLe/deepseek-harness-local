{
  "name": "@naumi/dsh-enterprise",
  "version": "0.1.0",
  "description": "Naumi 企业协作工作空间",
  "type": "module",
  "main": "host.js",
  "exports": {
    ".": "./host.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "host.js",
    "domain.js",
    "client.js",
    "assets",
    "cordis.patch.yml",
    "agent-desktop.js",
    "desktop-runtime.js",
    "skills",
    "third-party",
    "browser.js",
    "browser-runtime.js",
    "browser-bridge.mjs",
    "browser-skills"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "node": ">=24.9",
    "dsh": "0.2.2-rc.1"
  },
  "dependencies": {
    "agent-desktop": "1.3.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  }
}
