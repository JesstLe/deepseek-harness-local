[Unit]
Description=Naumi Employee Plugin Market
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=naumi-market
Group=naumi-market
WorkingDirectory=/opt/naumi-market/current
EnvironmentFile=/etc/naumi-market.env
ExecStart=/usr/bin/node market/server.mjs
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/naumi-market

[Install]
WantedBy=multi-user.target
