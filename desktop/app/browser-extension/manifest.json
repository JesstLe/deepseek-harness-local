{
  "manifest_version": 3,
  "name": "Naumi 浏览器连接",
  "version": "1.0.0",
  "description": "将你选择的现有标签页连接到 Naumi，保留原浏览器登录态。",
  "permissions": ["debugger", "activeTab", "storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "action": {"default_title": "连接到 Naumi", "default_popup": "popup.html"}
}
